# Preserve exact generated bytes and avoid giant embedded WebGL diffs.
index.html -text -diff
*.json -text
*.mp4 -text
*.zip -text
# Preserve the upstream notice verbatim: its Markdown underline is not a
# conflict marker, and it contains insignificant trailing whitespace.
LICENSE_MAKEHUMAN.md whitespace=-trailing-space,-space-before-tab conflict-marker-size=32
