:: StoryInterface
<div id="bow-app" class="bow-app bow-fullscreen-app">

  <!-- ============================================================
       ВЕРХНЯЯ ТОНКАЯ ПОЛОСА ХРОНИКИ МИРА (0.0.9.2 — полный экран)
       ============================================================ -->
  <header class="bow-topbar">
    <button class="bow-logo-btn" id="bow-logo-btn" aria-label="Меню игры" aria-expanded="false" title="Меню игры — продолжить, настройки, сохранения">
      <span class="bow-logo-bars" aria-hidden="true">☰</span>
      <span class="bow-logo-img" aria-hidden="true"></span>
      <span class="bow-logo-text">
        <b>Blades Of War</b>
      </span>
    </button>

    <div class="bow-topbar-info">
      <div class="bow-topbar-line1">
        <span id="bow-where-visible" class="bow-tb-loc-pill"><b id="bow-loc-name">—</b> <i id="bow-loc-sub" class="bow-dim">—</i></span>
        <span id="bow-time" class="bow-tb-time">—</span>
        <span id="bow-where" class="bow-tb-place bow-sr-only">—</span>
      </div>
      <div class="bow-topbar-line2">
        <span class="bow-tb-money" title="Монеты"><b id="bow-money">0</b> м.</span>
        <span class="bow-tb-sep">·</span>
        <span id="bow-weather" class="bow-weather"></span>
      </div>
    </div>

    <nav class="bow-rail bow-top-nav" id="bow-rail" aria-label="Окна героя и мира">
      <button class="bow-rail-btn" data-act="panel" data-panel="state" title="Состояние, конечности и органы">
        <span class="bow-rail-i">♥</span><span class="bow-rail-l">Тело</span>
      </button>
      <button class="bow-rail-btn" data-act="panel" data-panel="skills" title="Характеристики и навыки">
        <span class="bow-rail-i">✦</span><span class="bow-rail-l">Навыки</span>
      </button>
      <button class="bow-rail-btn" data-act="panel" data-panel="inv" title="При себе">
        <span class="bow-rail-i">▤</span><span class="bow-rail-l">Сумка</span>
      </button>
      <button class="bow-rail-btn" data-act="panel" data-panel="people" title="Жители">
        <span class="bow-rail-i">◉</span><span class="bow-rail-l">Люди</span>
      </button>
      <button class="bow-rail-btn" data-act="panel" data-panel="orgs" title="Общины">
        <span class="bow-rail-i">◇</span><span class="bow-rail-l">Общины</span>
      </button>
      <button class="bow-rail-btn" data-act="panel" data-panel="journal" title="Хроника">
        <span class="bow-rail-i">≡</span><span class="bow-rail-l">Хроника</span>
      </button>
    </nav>

    <div class="bow-topbar-right">
      <button type="button" class="bow-audio-btn" id="bow-audio-btn" data-act="audio-toggle" aria-pressed="false" title="Северный саундтрек с хором и ритмом (вкл/выкл)">♪</button>
      <div class="bow-clock-controls" role="group" aria-label="Ход времени">
        <button class="bow-clock-btn" data-act="clock" data-scale="paused" title="Пауза">❙❙</button>
        <button class="bow-clock-btn" data-act="clock" data-scale="1x" title="Обычный ход (1 мин. = 2 сек.)">▶</button>
        <button class="bow-clock-btn" data-act="clock" data-scale="4x" title="Быстрый ход (2 мин./сек.)">▶▶</button>
      </div>
    </div>
  </header>

  <!-- Скрытый технический блок переходов (визуально убран с экрана: переходы идут ногами через двери и карту!) -->
  <section class="bow-places-bar bow-sr-only" aria-hidden="true" aria-label="Переход">
    <div class="bow-places-head">
      <span class="bow-places-meta">Переход <span class="bow-tb-sep">·</span> <span id="bow-season" class="bow-season-tag">Зима · Студёный Брод</span></span>
      <button type="button" class="bow-map-open-btn" data-act="open-map" title="Открыть карту поселения и Хладных Ветров">◈ Карта</button>
    </div>
    <div class="bow-actions bow-places-row">
      <button class="bow-btn" data-act="move" data-loc="square" data-label="Площадь">Площадь</button>
      <button class="bow-btn" data-act="move" data-loc="tavern" data-label="Трактир">Трактир</button>
      <button class="bow-btn" data-act="move" data-loc="smithy" data-label="Кузница">Кузница</button>
      <button class="bow-btn" data-act="move" data-loc="outskirts" data-label="Околица">Околица</button>
      <button class="bow-btn" data-act="move" data-loc="forest" data-label="Опушка тайги">Опушка тайги</button>
    </div>
  </section>

  <!-- ============================================================
       ПОЛНОЭКРАННОЕ ОКНО МИРА (100vw × 100dvh, без веб-скролла)
       ============================================================ -->
  <div class="bow-body" id="bow-body">

    <main class="bow-main">

      <section class="bow-stage" id="bow-stage" aria-label="Окно локации">
        <!-- Заметный индикатор ГЛОБАЛЬНОЙ ПАУЗЫ и отложенного приказа (0.0.9.2) -->
        <div id="bow-pause-banner" class="bow-pause-banner" aria-live="polite"></div>

        <!-- Всплывающий гербовый клилич при начале живой схватки в локации -->
        <div id="bow-clash-banner" class="bow-clash-banner" aria-live="assertive"></div>

        <!-- Компактные кнопки управления свободной камерой (приближение / отдаление / на героя) -->
        <div id="bow-cam-controls" class="bow-cam-controls" role="group" aria-label="Камера">
          <button type="button" class="bow-cam-btn" data-act="cam-zoom" data-dir="in" title="Приблизить камеру">+</button>
          <button type="button" class="bow-cam-btn" data-act="cam-zoom" data-dir="out" title="Отдалить камеру">−</button>
          <button type="button" class="bow-cam-btn" data-act="cam-center" title="Навести камеру на героя">⌖</button>
        </div>

        <!-- Живой изометрический мир от края до края -->
        <div id="bow-stage-canvas" class="bow-stage-canvas"></div>

        <!-- Карточка взаимодействия с выбранным человеком / объектом -->
        <div id="bow-stage-pop" class="bow-stage-pop" aria-live="polite"></div>

        <!-- Живая панель управления боем Kenshi прямо в локации (пауза, прицел, стойка, тревога стражи, исход) -->
        <div id="bow-skirmish-hud" class="bow-skirmish-hud" aria-live="polite"></div>

        <!-- Тонкая строка живого отклика мира внизу слева над консолью -->
        <div class="bow-stage-bottom">
          <div id="bow-ambience" class="bow-ambience bow-sr-only"></div>
          <div class="bow-result" id="bow-last" aria-live="polite"></div>
        </div>
      </section>

      <!-- НИЖНЯЯ ПРИБОРНАЯ КОНСОЛЬ CRPG (переключатель Мирный/Боевой, показатели, кнопки шторок) -->
      <section class="bow-hud-strip" aria-label="Нижняя консоль управления">
        <div class="bow-hud-mode-wrap">
          <button type="button" id="bow-aggro-btn" class="bow-mode-btn" data-act="toggle-aggro" aria-pressed="false" title="Переключить мирный и агрессивный режим действий [Tab]. В боевом режиме клик по цели сразу начинает схватку.">
            <span class="bow-mode-i" aria-hidden="true">◈</span>
            <span class="bow-mode-txt"><b>Мирный</b><i>Tab — к бою</i></span>
          </button>
        </div>

        <div class="bow-topbar-status" id="bow-topbar-status"></div>
        <div class="bow-heat" id="bow-heat"></div>

        <div class="bow-hud-acts">
          <button class="bow-btn bow-btn-sm" data-act="rest" title="Отдохнуть и перевести дух"><span class="bow-btn-i">☾</span>Отдых</button>
          <button class="bow-btn bow-btn-sm" id="bow-autoeat-btn" data-act="toggle-autoeat" title="Автоматически съедать припасы при голоде">Авто-еда</button>
          <span id="bow-hud-quick" class="bow-hud-quick"></span>
        </div>

        <div class="bow-dock-drawers" role="group" aria-label="Дела и карта места">
          <button type="button" class="bow-dock-btn" data-act="open-world-panel" data-tab="jobs" title="Подряды и работа в этой локации">
            <span>⚒ Подряды</span>
          </button>
          <button type="button" class="bow-dock-btn" data-act="open-world-panel" data-tab="trade" title="Торговля и снедь">
            <span>⚖ Торг</span>
          </button>
          <button type="button" class="bow-dock-btn" data-act="open-world-panel" data-tab="map" title="Карта Студёного Брода и земель">
            <span>◈ Карта</span>
          </button>
          <button type="button" class="bow-dock-btn" data-act="open-world-panel" data-tab="desc" title="Сведения об этом месте">
            <span>❖ Место</span>
          </button>
        </div>
      </section>

      <!-- Всплывающие сюжетные оверлеи поверх сцены (кома, стража, встреча, диалог) -->
      <section id="bow-coma" class="bow-fight bow-floating-overlay" aria-live="polite"></section>
      <section id="bow-guard" class="bow-fight bow-floating-overlay" aria-live="polite"></section>
      <section id="bow-encounter" class="bow-fight bow-floating-overlay" aria-live="polite"></section>
      <section id="bow-jail" class="bow-fight bow-floating-overlay" aria-live="polite"></section>
      <section id="bow-dialog" class="bow-dialog bow-floating-dialog" aria-live="polite"></section>

      <!-- ВСПЛЫВАЮЩАЯ ШТОРКА ДЕЛ МЕСТА (скрыта по умолчанию — открывается по кнопкам Подряды / Торг / Карта / Место) -->
      <section class="bow-panel bow-world-drawer" id="bow-world-panel" aria-hidden="true">
        <div class="bow-world-drawer-head">
          <div class="bow-tabs" role="tablist" aria-label="Разделы места">
            <button class="bow-tab bow-tab-on" data-act="tab" data-tab="jobs" role="tab" aria-selected="true">
              <span>Подряды</span><b class="bow-fold-count" data-count-for="jobs">0</b>
            </button>
            <button class="bow-tab" data-act="tab" data-tab="trade" role="tab" aria-selected="false">
              <span>Торг и снедь</span><b class="bow-fold-count" data-count-for="trade">0</b>
            </button>
            <button class="bow-tab" data-act="tab" data-tab="map" role="tab" aria-selected="false">
              <span>Карта</span><b class="bow-fold-count" data-count-for="map">5</b>
            </button>
            <button class="bow-tab" data-act="tab" data-tab="desc" role="tab" aria-selected="false">
              <span>О месте</span>
            </button>
          </div>
          <button type="button" class="bow-dialog-close" data-act="close-world-panel" aria-label="Закрыть шторку" title="Закрыть [Esc]">✕</button>
        </div>

        <div class="bow-world-drawer-body">
          <div class="bow-tab-pane bow-tab-pane-on" data-tab-pane="jobs">
            <div id="bow-jobs" class="bow-jobs"></div>
          </div>

          <div class="bow-tab-pane" data-tab-pane="map">
            <div id="bow-map" class="bow-map"></div>
          </div>

          <div class="bow-tab-pane" data-tab-pane="trade">
            <!-- #passages обязателен для SugarCube -->
            <div id="passages"></div>
          </div>

          <div class="bow-tab-pane" data-tab-pane="desc">
            <section class="bow-scene" id="bow-scene">
              <div id="bow-loc-text" class="bow-scene-text"></div>
            </section>
          </div>
        </div>

        <!-- Скрытый технический контейнер карточек локации для совместимости прямых вызовов -->
        <div id="bow-people" class="bow-people bow-sr-only" aria-hidden="true"></div>
      </section>

    </main>

    <!-- ОТДЕЛЬНОЕ ВСПЛЫВАЮЩЕЕ ОКНО ГЕРОЯ И МЕНЮ ПОВЕРХ ИГРЫ -->
    <aside class="bow-drawer bow-modal" id="bow-drawer" aria-hidden="true">
      <div class="bow-modal-backdrop" data-act="close-panel"></div>
      <div class="bow-modal-box" role="dialog" aria-modal="true" aria-labelledby="bow-modal-title">
        <div class="bow-modal-head">
          <h2 class="bow-h2" id="bow-modal-title">Состояние</h2>
          <button class="bow-dialog-close" data-act="close-panel" aria-label="Закрыть окно" title="Закрыть">✕</button>
        </div>
        <div class="bow-drawer-scroll bow-modal-body">
          <div class="bow-drawer-inner">

            <section class="bow-dpanel" data-section="state">
              <h3 class="bow-subh">Состояние</h3>
              <div id="bow-needs" class="bow-needs"></div>
            </section>

            <section class="bow-dpanel" data-section="body">
              <h3 class="bow-subh">Части тела, органы и перевязка</h3>
              <div id="bow-injuries" class="bow-injuries"></div>
              <div id="bow-treat" class="bow-treat"></div>
            </section>

            <section class="bow-dpanel" data-section="skills">
              <h3 class="bow-subh bow-subh-modal-dup">Характеристики и навыки</h3>
              <div id="bow-skills" class="bow-skills"></div>
            </section>

            <section class="bow-dpanel" data-section="inv">
              <h3 class="bow-subh bow-subh-modal-dup">При себе</h3>
              <div id="bow-inventory" class="bow-inventory"></div>
            </section>

            <section class="bow-dpanel" data-section="people">
              <h3 class="bow-subh bow-subh-modal-dup">Жители поселения</h3>
              <div id="bow-all-people" class="bow-all-people"></div>
            </section>

            <section class="bow-dpanel" data-section="orgs">
              <h3 class="bow-subh bow-subh-modal-dup">Общины</h3>
              <div id="bow-orgs" class="bow-orgs"></div>
            </section>

            <section class="bow-dpanel" data-section="journal">
              <h3 class="bow-subh bow-subh-modal-dup">Хроника</h3>
              <div id="bow-journal" class="bow-journal"></div>
            </section>

            <section class="bow-dpanel" data-section="save">
              <div class="bow-menu-top">
                <button class="bow-btn bow-menu-resume" data-act="close-panel">▶ Продолжить игру</button>
              </div>

              <h3 class="bow-subh">Настройки</h3>
              <div id="bow-settings" class="bow-settings"></div>

              <h3 class="bow-subh">Память игры</h3>
              <div class="bow-saves">
                <button class="bow-btn bow-btn-sm" id="bow-btn-continue" disabled>Продолжить с автосейва</button>
                <button class="bow-btn bow-btn-sm" id="bow-btn-save">Выгрузить сохранение</button>
                <button class="bow-btn bow-btn-sm" id="bow-btn-load">Загрузить файл</button>
                <button class="bow-btn bow-btn-sm bow-btn-danger" id="bow-btn-restart">Начать заново</button>
              </div>
              <p class="bow-note">
                Игра сама сохраняется в браузере после каждого действия.
                Чтобы перенести прогресс — выгрузите файл.
              </p>
            </section>

          </div>
        </div>
      </div>
    </aside>

  </div>

  <!-- ============================================================
       ПОЛКОВОДЧЕСКОЕ «ПОЛЕ БРАНИ» — ДЛЯ БОЛЬШИХ ОТРЯДОВ (ДЕСЯТКИ И СОТНИ БОЙЦОВ)
       ============================================================ -->
  <div id="bow-battle-intro" class="bow-battle-intro" aria-hidden="true">
    <div class="bow-battle-intro-flash"></div>
    <svg class="bow-battle-intro-blades" viewBox="0 0 180 120" aria-hidden="true">
      <g class="bow-intro-sword bow-intro-sword-l">
        <line x1="26" y1="100" x2="146" y2="18" stroke="#e4edf6" stroke-width="4.5" stroke-linecap="round"/>
        <line x1="26" y1="100" x2="146" y2="18" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round"/>
        <line x1="42" y1="74" x2="58" y2="96" stroke="#c9a961" stroke-width="4" stroke-linecap="round"/>
      </g>
      <g class="bow-intro-sword bow-intro-sword-r">
        <line x1="154" y1="100" x2="34" y2="18" stroke="#e4edf6" stroke-width="4.5" stroke-linecap="round"/>
        <line x1="154" y1="100" x2="34" y2="18" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round"/>
        <line x1="138" y1="74" x2="122" y2="96" stroke="#c9a961" stroke-width="4" stroke-linecap="round"/>
      </g>
      <circle class="bow-intro-spark" cx="90" cy="56" r="14" fill="none" stroke="#fff3d1" stroke-width="2.2"/>
    </svg>
    <span id="bow-battle-intro-title" class="bow-battle-intro-title">Поле брани!</span>
  </div>

  <section id="bow-fight-page" class="bow-fight-page" aria-hidden="true">
    <div id="bow-fight"></div>
  </section>

  <div id="bow-lockpick-modal" class="bow-lockpick-modal" aria-hidden="true"></div>

  <div id="bow-sheet" class="bow-sheet" aria-hidden="true"></div>

  <!-- Всплывающее окно выбора режима управления при запуске (ПК / Телефон, 0.0.9.2f) -->
  <div id="bow-device-modal" class="bow-device-modal" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="bow-device-title">
    <div class="bow-device-card">
      <p class="bow-device-kicker">СТУДЁНЫЙ БРОД · ХЛАДНЫЕ ВЕТРА</p>
      <h2 id="bow-device-title" class="bow-device-title">Выберите тип устройства</h2>
      <p class="bow-device-sub">Интерфейс и камера подстроятся под ваш экран. Позже режим можно в любой момент переключить в меню настроек (☰).</p>
      <div class="bow-device-choices">
        <button type="button" class="bow-device-choice" data-act="device-pick" data-device="pc">
          <span class="bow-device-icon" aria-hidden="true">
            <svg viewBox="0 0 36 28" width="36" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="miter">
              <rect x="3" y="3" width="30" height="18" rx="1"/>
              <line x1="18" y1="21" x2="18" y2="25"/>
              <line x1="11" y1="25" x2="25" y2="25"/>
            </svg>
          </span>
          <b>Компьютер (ПК)</b>
          <i>Полноразмерный интерфейс CRPG, наведение мышью, клавиши Пробел / Tab / Esc и зум колесом.</i>
        </button>
        <button type="button" class="bow-device-choice" data-act="device-pick" data-device="mobile">
          <span class="bow-device-icon" aria-hidden="true">
            <svg viewBox="0 0 28 36" width="28" height="36" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="miter">
              <rect x="6" y="2.5" width="16" height="31" rx="1.5"/>
              <line x1="11.5" y1="6" x2="16.5" y2="6"/>
              <circle cx="14" cy="29.5" r="1.2" fill="currentColor" stroke="none"/>
            </svg>
          </span>
          <b>Телефон / Сенсор</b>
          <i>Компактный мобильный интерфейс, свободная камера пальцем, зум щипком и точные касания по силуэту.</i>
        </button>
      </div>
    </div>
  </div>

  <footer class="bow-footer bow-sr-only" aria-hidden="true">
    <span>Blades Of War · прототип 0.0.9.2f · Хладные Ветра · Студёный Брод</span>
  </footer>

</div>
