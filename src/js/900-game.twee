:: bow-game [script]
/* ============================================================
   BOW GAME — связка интерфейса с SugarCube.
   Здесь: хранение состояния в State.variables.game, обработчики
   кнопок, автосохранение, экспорт и импорт файла.
   ============================================================ */
(function (global) {
  "use strict";

  var Bow = global.Bow;
  var SC = global.SugarCube;
  var AUTOSAVE_KEY = "bow-autosave-v1";

  function vars() { return SC.State.variables; }

  function getState() {
    var v = vars();
    if (!v.game) {
      v.game = Bow.adapter.freshState();
      v.game.createdAt = Date.now();
    }
    return v.game;
  }

  var autosaveTimer = null;
  var autosaveDirty = false;
  var lastExplicitTargetKey = "";
  var lastExplicitTargetRound = -1;

  function flushAutosave(quiet) {
    if (autosaveTimer) {
      clearTimeout(autosaveTimer);
      autosaveTimer = null;
    }
    autosaveDirty = false;
    var state = getState();
    if (!state) { return; }
    try {
      global.localStorage.setItem(AUTOSAVE_KEY, Bow.save.serialize(state, Date.now()));
    } catch (err) {
      if (!quiet && global.console) { global.console.warn("[Bow] автосохранение недоступно:", err); }
    }
  }

  function scheduleAutosave(immediate, quiet) {
    if (immediate) {
      flushAutosave(quiet);
      return;
    }
    autosaveDirty = true;
    if (autosaveTimer) { return; }
    autosaveTimer = setTimeout(function () {
      autosaveTimer = null;
      if (autosaveDirty) { flushAutosave(true); }
    }, 2400);
  }

  /* Перерисовка + отложенный автосейв без микрофризов звука (0.0.9.0). */
  function refresh(quiet, immediateSave) {
    var state = getState();
    Bow.ui.render(state);
    if (Bow.audio && Bow.audio.syncMood) { Bow.audio.syncMood(state); }
    scheduleAutosave(!!immediateSave, quiet);
  }

  function say(result) {
    if (result && result.message) { Bow.ui.setMessage(result.message); }
    refresh();
  }

  function isWorldPaused(state) {
    return !!(state && state.time && state.time.scale === "paused");
  }

  /* Запись тактического/мирного приказа во время ГЛОБАЛЬНОЙ ПАУЗЫ (0.0.9.2):
     приказ сохраняется и подсвечивается на сцене (#9cd6ff или #ee4246),
     но сама пауза НЕ снимается автоматически до нажатия ▶ / Пробел! */
  function queueOrderOnPause(state, order) {
    if (!state) { return { ok: false, message: "" }; }
    state.pendingOrder = order;
    if (Bow.iso && Bow.iso.previewOrderPath && typeof order.wx === "number" && typeof order.wy === "number") {
      Bow.iso.previewOrderPath(state, order.wx, order.wy);
    }
    return {
      ok: true,
      message: "⏸ Приказ отдан на паузе: «" + (order.label || "Действие") + "». Нажмите ▶ или Пробел для исполнения."
    };
  }

  function performDoorExitMove(state, targetLoc) {
    if (Bow.iso && Bow.iso.walkToExitAndMove && targetLoc && targetLoc !== state.player.location) {
      var modeRes = "instant";
      var syncRes = null;
      modeRes = Bow.iso.walkToExitAndMove(state, targetLoc, function () {
        syncRes = Bow.adapter.act.move(state, targetLoc);
        scheduleAutosave(true, true);
        if (modeRes === "walking") { say(syncRes); }
      }, function () {
        if (Bow.ui.repaintIsoStage) { Bow.ui.repaintIsoStage(state); }
      });
      if (modeRes === "walking") {
        return { ok: true, message: "Идёте к выходу…" };
      }
      return syncRes || { ok: true, message: "" };
    }
    var res = Bow.adapter.act.move(state, targetLoc);
    scheduleAutosave(true, true);
    return res;
  }

  function executePendingOrder(state) {
    if (!state || !state.pendingOrder || isWorldPaused(state)) { return null; }
    var ord = state.pendingOrder;
    state.pendingOrder = null;

    if (ord.kind === "attack") {
      return launchLocationSkirmish(state, ord.personId || null, { mode: ord.attackMode || "crime" });
    }
    if (ord.kind === "exit" && ord.exitTo) {
      return performDoorExitMove(state, ord.exitTo);
    }
    if (ord.kind === "spot" && ord.spot && Bow.iso && Bow.iso.walkAdjacentAndAct) {
      Bow.iso.walkAdjacentAndAct(state, ord.spot.col, ord.spot.row, function () {
        var ptScr = Bow.iso.tileToScreen(ord.spot.col, ord.spot.row);
        Bow.ui.setStageSelection({
          kind: "prop",
          spot: ord.spot,
          x: Math.round((ptScr.x / Bow.iso.VIEW_W) * 100)
        });
        refresh(true);
      }, function () {
        if (Bow.ui.repaintIsoStage) { Bow.ui.repaintIsoStage(state); }
      });
      return { ok: true, message: "Идёте к объекту: " + (ord.spot.title || "") + "…" };
    }
    if (ord.kind === "approach" && typeof ord.wx === "number" && typeof ord.wy === "number" && Bow.iso && Bow.iso.walkAdjacentAndAct) {
      Bow.iso.walkAdjacentAndAct(state, ord.wx, ord.wy, function () {
        if (ord.selection) { Bow.ui.setStageSelection(ord.selection); }
        refresh(true);
      }, function () {
        if (Bow.ui.repaintIsoStage) { Bow.ui.repaintIsoStage(state); }
      });
      return { ok: true, message: "Подходите к цели…" };
    }
    if (ord.kind === "walk" && typeof ord.wx === "number" && typeof ord.wy === "number" && Bow.iso && Bow.iso.walkTo) {
      Bow.iso.walkTo(state, ord.wx, ord.wy, function () {
        refresh(true);
      }, function () {
        if (Bow.ui.repaintIsoStage) { Bow.ui.repaintIsoStage(state); }
      });
      return { ok: true, message: "Продолжаете путь…" };
    }
    return null;
  }

  function applyGlobalScale(state, scale) {
    Bow.time.setScale(state, scale);
    if (scale === "paused") {
      if (state.skirmish && state.skirmish.active) {
        state.skirmish.paused = true;
      }
      stopClock();
      stopJailClock();
      refresh(true);
      return { ok: true, message: "⏸ Пауза: все процессы в мире остановлены. Камера и раздача приказов доступны." };
    }

    if (state.skirmish && state.skirmish.active) {
      state.skirmish.paused = false;
      startSkirmishLoop();
    }
    startClock();
    if (state.jail) { startJailClock(); }

    var ordRes = executePendingOrder(state);
    refresh(true);
    if (ordRes && ordRes.message) {
      return ordRes;
    }
    return {
      ok: true,
      message: scale === "1x" ? "▶ Время идёт (1 мин. = 2 сек.)." : "⏩ Время идёт вчетверо быстрее."
    };
  }

  /* ---------- Обработчики ---------- */

  var handlers = {
    move: function (el) {
      var state = getState();
      var targetLoc = el.getAttribute("data-loc");
      var fromStageDoor = el.getAttribute("data-from-stage") === "1";
      if (state.fight || (state.skirmish && state.skirmish.active)) {
        return { ok: false, message: "Сначала закончите схватку." };
      }

      /* Если игрок нажал на дверь сцены во время глобальной паузы — ставим приказ в очередь БЕЗ автоснятия паузы! */
      if (fromStageDoor && isWorldPaused(state) && targetLoc && targetLoc !== state.player.location) {
        var exCol = parseFloat(el.getAttribute("data-iso-col"));
        var exRow = parseFloat(el.getAttribute("data-iso-row"));
        var locDef = Bow.data && Bow.data.locations ? Bow.data.locations[targetLoc] : null;
        return queueOrderOnPause(state, {
          kind: "exit",
          exitTo: targetLoc,
          wx: isNaN(exCol) ? 6 : exCol,
          wy: isNaN(exRow) ? 4 : exRow,
          label: "Войти — " + (locDef ? locDef.name : targetLoc)
        });
      }

      if (Bow.ui.setWorldPanel) { Bow.ui.setWorldPanel(false); }
      if (Bow.iso && Bow.iso.stopWalkLoop) { Bow.iso.stopWalkLoop(); }
      state.pendingOrder = null;
      if (state.dialog) { Bow.dialog.close(state); }
      state.flags.lastDialogSummary = null;
      openSheet(null);

      return performDoorExitMove(state, targetLoc);
    },
    talk: function (el) {
      Bow.ui.setDrawer(false);
      Bow.ui.setStageSelection(null);
      return Bow.adapter.act.talk(getState(), el.getAttribute("data-person"));
    },
    eat: function (el) { return Bow.adapter.act.eat(getState(), el.getAttribute("data-item")); },
    drink: function (el) { return Bow.adapter.act.drink(getState(), el.getAttribute("data-item")); },
    rest: function () { return Bow.adapter.act.rest(getState()); },
    clock: function (el) {
      var state = getState();
      var scale = el.getAttribute("data-scale");
      return applyGlobalScale(state, scale);
    },
    "clear-order": function () {
      var state = getState();
      state.pendingOrder = null;
      if (Bow.iso && Bow.iso.cancelPlannedWalk) { Bow.iso.cancelPlannedWalk(); }
      return { ok: true, message: "Отложенный приказ отменён." };
    },
    "equip-slot": function (el) {
      var state = getState();
      var slot = el.getAttribute("data-slot");
      var itemId = el.getAttribute("data-item");
      if (!Bow.equip || !Bow.equip.setSlot) { return { ok: false, message: "Слоты снаряжения недоступны." }; }
      var eqRes = Bow.equip.setSlot(state.player, slot, itemId);
      if (!eqRes || eqRes.ok === false) {
        return { ok: false, message: (eqRes && eqRes.message) || "Этот предмет нельзя надеть в выбранный слот." };
      }
      var def = Bow.economy.findItemDef(itemId);
      return { ok: true, message: "Снаряжено: " + (def ? def.name : itemId) + "." };
    },
    "unequip-slot": function (el) {
      var state = getState();
      var slot = el.getAttribute("data-slot");
      if (!Bow.equip || !Bow.equip.unequipSlot) { return { ok: false, message: "" }; }
      Bow.equip.unequipSlot(state.player, slot);
      return { ok: true, message: "Предмет снят и убран в сумку." };
    },
    "swap-wep-set": function () {
      var state = getState();
      if (!Bow.equip || !Bow.equip.swapWeaponSet) { return { ok: false, message: "" }; }
      var nextSet = Bow.equip.swapWeaponSet(state.player);
      var w = Bow.fight.weaponOf(state.player);
      return {
        ok: true,
        message: "В руках комплект " + (nextSet === 2 ? "II" : "I") + ": " + (w ? w.name : "безоружный") + "."
      };
    },
    "device-pick": function (el) {
      var state = getState();
      var dev = el.getAttribute("data-device") === "mobile" ? "mobile" : "pc";
      if (Bow.audio && Bow.audio.unlockGesture) { Bow.audio.unlockGesture(true); }
      var setRes = Bow.ui.setDeviceMode ? Bow.ui.setDeviceMode(dev) : { ok: true };
      if (state && state.time && state.time.scale === "paused" && !state.pendingOrder) {
        applyGlobalScale(state, "1x");
      }
      if (Bow.iso && Bow.iso.centerCameraOnPlayer) {
        Bow.iso.centerCameraOnPlayer(state, null, true);
      }
      return {
        ok: true,
        message: dev === "mobile"
          ? "📱 Мобильный режим активен: водите пальцем для обзора, сводите два пальца для зума."
          : (setRes.message || "🖥 Режим ПК активен.")
      };
    },
    "cam-zoom": function (el) {
      var state = getState();
      var dir = el.getAttribute("data-dir");
      if (Bow.iso && Bow.iso.getCamera && Bow.iso.setCameraZoom) {
        var curZ = Bow.iso.getCamera().zoom || 1;
        Bow.iso.setCameraZoom(curZ + (dir === "in" ? 0.24 : -0.24), null, state);
      }
      return { ok: true, message: "" };
    },
    "cam-center": function () {
      var state = getState();
      if (Bow.iso && Bow.iso.centerCameraOnPlayer) {
        Bow.iso.centerCameraOnPlayer(state, null, false);
      }
      return { ok: true, message: "" };
    },
    "loot-corpse": function (el) {
      var res = Bow.adapter.act.lootCorpse(getState(), el.getAttribute("data-corpse"));
      return res;
    },
    "open-map": function () {
      if (Bow.ui.setWorldPanel) { Bow.ui.setWorldPanel(true, "map"); }
      else { Bow.ui.setTab("map"); }
      return { ok: true, message: "" };
    },
    "open-world-panel": function (el) {
      var tabKey = el.getAttribute("data-tab") || "jobs";
      if (Bow.ui.toggleWorldPanel) { Bow.ui.toggleWorldPanel(tabKey); }
      return { ok: true, message: "" };
    },
    "close-world-panel": function () {
      if (Bow.ui.setWorldPanel) { Bow.ui.setWorldPanel(false); }
      return { ok: true, message: "" };
    },
    "toggle-aggro": function () {
      if (!Bow.skirmish) { return { ok: false, message: "" }; }
      var on = Bow.skirmish.toggleAggressive();
      return {
        ok: true,
        message: on
          ? "⚔ Боевой режим: клик по цели сразу начинает живую схватку!"
          : "✋ Мирный режим действий."
      };
    },
    "skirmish-confirm-open": function (el) {
      var pid = el.getAttribute("data-person");
      Bow.ui.setStageSelection({ kind: "person", personId: pid, confirmAttack: true });
      return { ok: true, message: "" };
    },
    "skirmish-confirm-cancel": function (el) {
      var pid = el.getAttribute("data-person");
      Bow.ui.setStageSelection({ kind: "person", personId: pid, confirmAttack: false });
      return { ok: true, message: "" };
    },
    "skirmish-engage": function (el) {
      var state = getState();
      var pid = el.getAttribute("data-person");
      var mode = el.getAttribute("data-mode") || "crime";
      return launchLocationSkirmish(state, pid, { mode: mode, unarmed: mode === "brawl" });
    },
    "skirmish-pause": function () {
      var state = getState();
      if (!Bow.skirmish || !state.skirmish) { return { ok: true, message: "" }; }
      var currentlyPaused = isWorldPaused(state) || !!state.skirmish.paused;
      var nextScale = currentlyPaused ? "1x" : "paused";
      applyGlobalScale(state, nextScale);
      return { ok: true, message: !currentlyPaused ? "⏸ Тактическая пауза." : "▶ Бой продолжается!" };
    },
    "skirmish-order": function (el) {
      var state = getState();
      if (!Bow.skirmish || !state.skirmish) { return { ok: true, message: "" }; }
      Bow.skirmish.setOrder(state, el.getAttribute("data-kind"), el.getAttribute("data-val"));
      return { ok: true, message: "" };
    },
    "skirmish-target": function (el) {
      var state = getState();
      if (!Bow.skirmish || !state.skirmish) { return { ok: true, message: "" }; }
      Bow.skirmish.setTarget(state, el.getAttribute("data-unit"));
      return { ok: true, message: "" };
    },
    "skirmish-ally": function () {
      return { ok: true, message: "" };
    },
    "skirmish-decide": function (el) {
      var state = getState();
      if (!Bow.skirmish || !state.skirmish) { return { ok: false, message: "" }; }
      stopSkirmishLoop();
      var res = Bow.skirmish.decideAftermath(state, el.getAttribute("data-choice") || "spare");
      scheduleAutosave(true, true);
      return res;
    },
    "map-mode": function (el) {
      Bow.ui.setMapMode(el.getAttribute("data-mode"));
      Bow.ui.renderMapPane(getState());
      return { ok: true, message: "" };
    },
    steal: function (el) {
      return Bow.adapter.act.steal(getState(), el.getAttribute("data-person"));
    },
    "steal-look": function (el) {
      return Bow.adapter.act.stealLook(getState(), el.getAttribute("data-person"));
    },
    "steal-distract": function (el) {
      return Bow.adapter.act.stealDistract(getState(), el.getAttribute("data-person"));
    },
    "steal-pocket": function (el) {
      return Bow.adapter.act.stealPocket(getState(), el.getAttribute("data-person"));
    },
    treat: function () {
      return Bow.adapter.act.treat(getState());
    },

    /* ---------- Бой ----------
       Окно боя — не панель и не карточка: оно поверх сцены и
       переживает перерисовку, потому что живёт в состоянии. */
    "fight-open": function (el) {
      var state = getState();
      if (state.dialog) { Bow.dialog.close(state); }
      Bow.ui.setStageSelection(null);
      return Bow.adapter.act.fightOpen(state, el.getAttribute("data-person"));
    },
    "fight-close": function () {
      var state = getState();
      stopFightClock();
      var res = Bow.adapter.act.fightClose(state);
      state.flags.lastFight = null;
      return res;
    },
    "fight-start": function (el) {
      var state = getState();
      if (Bow.iso && Bow.iso.stopWalkLoop) { Bow.iso.stopWalkLoop(); }
      lastExplicitTargetKey = "";
      lastExplicitTargetRound = -1;
      var res = Bow.adapter.act.fightStart(state, el.getAttribute("data-mode"));
      if (res && res.ok && state.fight && state.fight.phase === "exchange") {
        /* По решению владельца (0.0.9.0): бой по умолчанию начинается в пошаговом режиме без автобоя! */
        Bow.fight.setOrder(state, "speed", "paused");
        stopFightClock();
      }
      return res;
    },
    "fight-order": function (el) {
      var state = getState();
      var kind = el.getAttribute("data-kind");
      var val = el.getAttribute("data-val");
      var res = Bow.adapter.act.fightOrder(state, kind, val);
      startFightClock();
      return res;
    },
    "fight-step": function () {
      var state = getState();
      if (Bow.fight.isActive(state) && state.fight.phase === "aftermath") {
        return { ok: false, message: "Он больше не бьётся. Решайте, что с ним делать." };
      }
      return Bow.adapter.act.fightStep(state);
    },
    "fight-move": function (el) {
      var state = getState();
      if (Bow.fight.isActive(state) && state.fight.phase === "aftermath") {
        return { ok: false, message: "Он больше не бьётся. Решайте, что с ним делать." };
      }
      var stance = el.getAttribute("data-stance");
      var target = el.getAttribute("data-target");
      var aim = el.getAttribute("data-aim");
      if (state.fight && state.fight.phase === "exchange") {
        var o = Bow.fight.ensureOrders(state.fight);
        if (stance && stance !== "flee" && stance !== "back") { o.stance = stance; }
        if (aim) { o.aim = aim; }
      }
      return Bow.adapter.act.fightMove(state, stance, target, aim);
    },
    "fight-target": function (el) {
      var state = getState();
      var tgtKey = el.getAttribute("data-target");
      if (state.fight && state.fight.phase === "exchange") {
        var ord = Bow.fight.ensureOrders(state.fight);
        /* В пошаговом режиме повторный клик по уже выделенному врагу сразу делает шаг/удар в него! */
        if (ord.speed === "paused" && state.fight.target === tgtKey && lastExplicitTargetKey === tgtKey && lastExplicitTargetRound === state.fight.round) {
          lastExplicitTargetRound = -1;
          return Bow.adapter.act.fightMove(state, "press", tgtKey, ord.aim || "body");
        }
        lastExplicitTargetKey = tgtKey;
        lastExplicitTargetRound = state.fight.round;
      }
      return Bow.adapter.act.fightTarget(state, tgtKey);
    },
    "fight-hex": function (el) {
      var state = getState();
      if (Bow.fight.isActive(state) && state.fight.phase === "aftermath") {
        return { ok: false, message: "Бой уже окончен — выберите решение." };
      }
      var c = parseInt(el.getAttribute("data-col"), 10);
      var r = parseInt(el.getAttribute("data-row"), 10);
      return Bow.adapter.act.fightHex(state, c, r);
    },
    "fight-decide": function (el) {
      stopFightClock();
      return Bow.adapter.act.fightDecide(getState(), el.getAttribute("data-choice"));
    },
    "fight-ally": function (el) {
      return Bow.adapter.act.fightAlly(getState(), el.getAttribute("data-person"));
    },

    /* ---------- Стража ---------- */
    "guard-surrender": function () { return Bow.adapter.act.guardSurrender(getState()); },
    "guard-bribe": function () { return Bow.adapter.act.guardBribe(getState()); },
    "guard-flee": function () { return Bow.adapter.act.guardFlee(getState()); },
    "guard-insult": function () { return Bow.adapter.act.guardInsult(getState()); },
    "guard-fight": function () {
      var state = getState();
      return launchLocationSkirmish(state, null, { mode: "guard" });
    },

    /* ---------- Клетка и гибридный взлом замка (0.0.8.2) ---------- */
    "jail-serve": function () { return Bow.adapter.act.jailServe(getState()); },
    "jail-escape": function () {
      var res = Bow.adapter.act.jailEscape(getState());
      if (res && !res.escaped && Bow.ui.triggerVeil) { Bow.ui.triggerVeil(); }
      return res;
    },
    "jail-bribe": function () { return Bow.adapter.act.jailBribe(getState()); },
    "jail-pick-toggle": function (el) {
      var st = getState();
      jailUserWakeUntil = Date.now() + 60000;
      /* Если ещё не стоим у двери клетки (4,3) — сначала подходим к решётке в изометрии */
      if (el && Bow.iso && Bow.iso.walkAdjacentAndAct && !st.jail.picking) {
        var pos = Bow.iso.getPlayerPos(st);
        if (Math.hypot(5 - pos.col, 3 - pos.row) > 1.55) {
          Bow.iso.walkAdjacentAndAct(st, 5, 3, function () {
            var r2 = Bow.adapter.act.jailPickToggle(st);
            startJailClock();
            if (r2 && r2.fadeVeil && Bow.ui.triggerVeil) { Bow.ui.triggerVeil(); }
            say(r2);
          }, function () {
            if (Bow.ui.repaintIsoStage) { Bow.ui.repaintIsoStage(st); }
          });
          return { ok: true, message: "Подходите к засову…" };
        }
      }
      var res = Bow.adapter.act.jailPickToggle(st);
      startJailClock();
      if (res && res.fadeVeil && Bow.ui.triggerVeil) { Bow.ui.triggerVeil(); }
      return res;
    },
    "jail-pick-manual": function () {
      var st = getState();
      if (!st.jail) { return { ok: false, message: "Вы не в клетке." }; }
      jailUserWakeUntil = Date.now() + 60000;
      Bow.ui.openLockpickModal(st);
      startJailClock();
      return { ok: true, message: "" };
    },
    "jail-lp-close": function () {
      Bow.ui.closeLockpickModal();
      return { ok: true, message: "" };
    },
    "jail-lp-nudge": function (el) {
      var step = parseInt(el.getAttribute("data-step"), 10) || 0;
      var lp = Bow.ui.getLockpickModalState ? Bow.ui.getLockpickModalState() : null;
      if (lp) { Bow.ui.setLockpickAngle((lp.pickAngle || 0) + step, getState()); }
      return { ok: true, message: "" };
    },
    "jail-lp-release": function () {
      var lp = Bow.ui.getLockpickModalState ? Bow.ui.getLockpickModalState() : null;
      if (lp) {
        lp.cylinderAngle = 0;
        lp.jammed = false;
        lp.hint = "Натяг ослаблен — выберите другой угол отмычки.";
        Bow.ui.renderLockpickModal(getState());
      }
      return { ok: true, message: "" };
    },
    "jail-lp-turn": function () {
      var st = getState();
      var lp = Bow.ui.getLockpickModalState ? Bow.ui.getLockpickModalState() : null;
      if (!lp || !st.jail) { return { ok: false, message: "Вы не в клетке." }; }
      var res = Bow.adapter.act.jailLpTurn(st, lp.pickAngle || 0, lp.cylinderAngle || 0);
      if (res && res.caught) {
        Bow.ui.closeLockpickModal();
        if (Bow.ui.triggerVeil) { Bow.ui.triggerVeil(); }
        return res;
      }
      if (res && res.unlocked) {
        Bow.ui.closeLockpickModal();
        if (Bow.ui.triggerVeil) { Bow.ui.triggerVeil(); }
        return res;
      }
      if (res) {
        lp.cylinderAngle = res.snapped ? 0 : (res.cylinderAngle || 0);
        lp.jammed = !!res.jammed;
        if (res.message) { lp.hint = res.message; }
      }
      return res;
    },

    /* ---------- Улица ---------- */
    "street-pay": function () { return Bow.adapter.act.streetPay(getState()); },
    "street-scare": function () { return Bow.adapter.act.streetScare(getState()); },
    "street-fight": function () {
      var state = getState();
      return launchLocationSkirmish(state, null, { mode: "robber" });
    },
    "street-flee": function () { return Bow.adapter.act.streetFlee(getState()); },

    "death-restart": function () {
      restart();
      return { ok: true, message: "" };
    },
    work: function (el) {
      var st = getState();
      if (st.task) { st.task = null; }
      return Bow.adapter.act.work(st, el.getAttribute("data-job"));
    },
    "task-start": function (el) {
      var state = getState();
      var res = Bow.adapter.act.taskStart(state, el.getAttribute("data-task"));
      if (res && res.ok) { startClock(); }
      return res;
    },
    "task-stop": function () {
      return Bow.adapter.act.taskStop(getState());
    },
    "rescue-coma": function (el) {
      return Bow.adapter.act.rescueComa(getState(), el.getAttribute("data-how") || "wait");
    },
    "toggle-autoeat": function () {
      return Bow.adapter.act.toggleAutoEat(getState());
    },
    "audio-toggle": function () {
      if (!Bow.audio) { return { ok: true, message: "" }; }
      var st = getState();
      if (Bow.audio.syncMood) { Bow.audio.syncMood(st); }
      var on = Bow.audio.toggle();
      var trk = Bow.audio.currentTrack ? Bow.audio.currentTrack() : null;
      if (Bow.ui.renderSettings) { Bow.ui.renderSettings(); }
      return {
        ok: true,
        message: on
          ? ("♪ Звучит: «" + (trk ? trk.title : "Северный саундтрек") + "».")
          : "Музыка выключена."
      };
    },
    "audio-track": function (el) {
      if (!Bow.audio || !Bow.audio.selectTrack) { return { ok: true, message: "" }; }
      var chosen = Bow.audio.selectTrack(el.getAttribute("data-track"));
      if (!Bow.audio.isEnabled()) { Bow.audio.start(); }
      if (Bow.ui.renderSettings) { Bow.ui.renderSettings(); }
      return { ok: true, message: chosen ? ("♪ Включена композиция: «" + chosen.title + "».") : "" };
    },
    "audio-next": function () {
      if (!Bow.audio || !Bow.audio.nextTrack) { return { ok: true, message: "" }; }
      var nxt = Bow.audio.nextTrack();
      if (!Bow.audio.isEnabled()) { Bow.audio.start(); }
      if (Bow.ui.renderSettings) { Bow.ui.renderSettings(); }
      return { ok: true, message: nxt ? ("♪ Следующая композиция: «" + nxt.title + "».") : "" };
    },
    "audio-auto": function () {
      if (!Bow.audio || !Bow.audio.setAutoMode) { return { ok: true, message: "" }; }
      var cur = Bow.audio.setAutoMode(getState());
      if (Bow.ui.renderSettings) { Bow.ui.renderSettings(); }
      return { ok: true, message: "Автовыбор музыки по месту: «" + (cur ? cur.title : "") + "»." };
    },
    "audio-beat": function () {
      if (!Bow.audio || !Bow.audio.toggleStreetBeat) { return { ok: true, message: "" }; }
      var bOn = Bow.audio.toggleStreetBeat();
      if (Bow.ui.renderSettings) { Bow.ui.renderSettings(); }
      return { ok: true, message: bOn ? "Включён мягкий уличный бит в стиле Enigma." : "Уличный бит выключен (чистый эмбиент)." };
    },
    buy: function (el) { return Bow.adapter.act.buy(getState(), el.getAttribute("data-key"), 1); },
    sell: function (el) { return Bow.adapter.act.sell(getState(), el.getAttribute("data-key"), 1); },
    inspect: function (el) {
      var state = getState();
      var person = state.people[el.getAttribute("data-person")];
      if (!person) { return { ok: false, message: "Здесь никого нет." }; }
      openSheet(person.id);
      return { ok: true, message: "" };
    },
    "close-sheet": function () {
      openSheet(null);
      return { ok: true, message: "" };
    },
    choose: function (el) {
      var idx = parseInt(el.getAttribute("data-choice"), 10);
      return Bow.adapter.act.choose(getState(), idx);
    },
    /* Кнопка раздела в шапке: открывает отдельное окно поверх игры. */
    panel: function (el) {
      var key = el.getAttribute("data-panel");
      Bow.ui.openModal(key);
      return { ok: true, message: "" };
    },
    "close-panel": function () {
      Bow.ui.setDrawer(false);
      startFightClock();
      return { ok: true, message: "" };
    },
    setting: function (el) {
      return Bow.ui.setSetting(el.getAttribute("data-key"), el.getAttribute("data-val"));
    },
    tab: function (el) {
      Bow.ui.setTab(el.getAttribute("data-tab"));
      return { ok: true, message: "" };
    },
    "stage-select": function (el) {
      var state = getState();
      var kind = el.getAttribute("data-kind");
      var personId = el.getAttribute("data-person");
      var corpseId = el.getAttribute("data-corpse");
      var xVal = parseFloat(el.getAttribute("data-x"));
      var isoCol = parseFloat(el.getAttribute("data-iso-col"));
      var isoRow = parseFloat(el.getAttribute("data-iso-row"));

      var isAggro = !!(Bow.skirmish && Bow.skirmish.isAggressive && Bow.skirmish.isAggressive());
      if (isAggro && !state.jail && (kind === "person" || kind === "guard" || kind === "robber")) {
        var atkMode = kind === "guard" ? "guard" : (kind === "robber" ? "robber" : "crime");
        /* Если мир на ГЛОБАЛЬНОЙ ПАУЗЕ — ставим враждебный приказ с багровой подсветкой БЕЗ автоснятия паузы! */
        if (isWorldPaused(state)) {
          var targetName = kind === "guard" ? "Стражник" : (kind === "robber" ? "Грабитель" : ((state.people[personId] && state.people[personId].name) || "Цель"));
          return queueOrderOnPause(state, {
            kind: "attack",
            targetId: kind === "person" ? personId : (el.getAttribute("data-entity-id") || kind),
            personId: kind === "person" ? personId : null,
            attackMode: atkMode,
            wx: isNaN(isoCol) ? 6 : isoCol,
            wy: isNaN(isoRow) ? 4 : isoRow,
            label: "Атаковать — " + targetName
          });
        }
        if (kind === "guard") { return launchLocationSkirmish(state, null, { mode: "guard" }); }
        if (kind === "robber") { return launchLocationSkirmish(state, null, { mode: "robber" }); }
        return launchLocationSkirmish(state, personId, { mode: "crime" });
      }

      var selObj = {
        kind: kind,
        personId: personId,
        corpseId: corpseId,
        x: isNaN(xVal) ? null : xVal
      };

      var applySelect = function () {
        Bow.ui.setStageSelection(selObj);
        if (kind === "jobs" || kind === "trade") { Bow.ui.setTab(kind); }
      };

      /* На паузе карточка осмотра открывается сразу (интерфейс активен!), а если цель далеко —
         прокладывается мирный маршрут подхода, который исполнится при снятии паузы! */
      if (isWorldPaused(state)) {
        applySelect();
        if (kind !== "self" && !isNaN(isoCol) && !isNaN(isoRow) && Bow.iso && Bow.iso.getPlayerPos) {
          var pOnPause = Bow.iso.getPlayerPos(state);
          if (Math.hypot(isoCol - pOnPause.col, isoRow - pOnPause.row) > 1.55) {
            var pTitle = (personId && state.people[personId]) ? state.people[personId].name : "Осмотр";
            queueOrderOnPause(state, {
              kind: "approach",
              targetId: personId || corpseId || kind,
              wx: isoCol,
              wy: isoRow,
              selection: selObj,
              label: "Подойти — " + pTitle
            });
          }
        }
        return { ok: true, message: "" };
      }

      var isComa = !!(Bow.state && Bow.state.isComatose && Bow.state.isComatose(state.player));
      if (!isComa && kind !== "self" && !isNaN(isoCol) && !isNaN(isoRow) && Bow.iso && Bow.iso.walkAdjacentAndAct) {
        var curP = Bow.iso.getPlayerPos(state);
        if (Math.hypot(isoCol - curP.col, isoRow - curP.row) > 1.55) {
          Bow.ui.setStageSelection(null);
          Bow.iso.walkAdjacentAndAct(state, isoCol, isoRow, function () {
            applySelect();
            refresh(true);
          }, function () {
            if (Bow.ui.repaintIsoStage) { Bow.ui.repaintIsoStage(state); }
          });
          return { ok: true, message: "" };
        }
      }

      applySelect();
      return { ok: true, message: "" };
    },
    "stage-close": function () {
      Bow.ui.setStageSelection(null);
      return { ok: true, message: "" };
    },
    "close-dialog": function () {
      var state = getState();
      Bow.dialog.close(state);
      state.flags.lastDialogSummary = null;
      return { ok: true, message: "" };
    }
  };

  /* Окно персонажа: открытие/закрытие без изменения игрового состояния. */
  var openPersonId = null;

  function openSheet(personId) {
    openPersonId = personId;
    var person = personId ? getState().people[personId] : null;
    Bow.ui.renderPersonSheet(person || null);
  }

  /* Во время боя сцена занята: работать, торговать или уходить
     посреди драки нельзя. Запрет стоит в одном месте, а не в
     каждом обработчике. */
  var DURING_FIGHT_ALLOWED = {
    "fight-start": true,
    "fight-order": true,
    "fight-step": true,
    "fight-move": true,
    "fight-hex": true,
    "fight-target": true,
    "fight-decide": true,
    "fight-close": true,
    "fight-ally": true,
    "panel": true,
    "close-panel": true,
    "tab": true,
    "stage-close": true,
    "inspect": true,
    "close-sheet": true,
    "close-dialog": true,
    "clock": true
  };

  /* Пока стража стоит рядом, из города не уйдёшь. */
  var DURING_GUARD_ALLOWED = {
    "guard-surrender": true,
    "guard-bribe": true,
    "guard-flee": true,
    "guard-insult": true,
    "guard-fight": true,
    "fight-start": true,
    "fight-order": true,
    "fight-step": true,
    "fight-move": true,
    "fight-hex": true,
    "fight-target": true,
    "fight-decide": true,
    "fight-close": true,
    "panel": true,
    "close-panel": true,
    "tab": true,
    "stage-close": true,
    "clock": true
  };

  /* Сервисные и закрывающие кнопки интерфейса никогда не должны блокироваться:
     иначе после поражения страже невозможно закрыть отчёт боя перед клеткой. */
  var ALWAYS_ALLOWED = {
    "fight-close": true,
    "loot-corpse": true,
    "open-map": true,
    "open-world-panel": true,
    "close-world-panel": true,
    "toggle-aggro": true,
    "skirmish-confirm-open": true,
    "skirmish-confirm-cancel": true,
    "skirmish-engage": true,
    "skirmish-pause": true,
    "skirmish-order": true,
    "skirmish-target": true,
    "skirmish-ally": true,
    "skirmish-decide": true,
    "equip-slot": true,
    "unequip-slot": true,
    "swap-wep-set": true,
    "device-pick": true,
    "cam-zoom": true,
    "cam-center": true,
    "clear-order": true,
    "map-mode": true,
    "stage-select": true,
    "close-panel": true,
    "close-sheet": true,
    "close-dialog": true,
    "stage-close": true,
    "panel": true,
    "setting": true,
    "audio-toggle": true,
    "toggle-autoeat": true,
    "task-stop": true,
    "tab": true
  };

  var DURING_SKIRMISH_ALLOWED = {
    "clock": true,
    "skirmish-pause": true,
    "skirmish-order": true,
    "skirmish-target": true,
    "skirmish-ally": true,
    "skirmish-decide": true,
    "toggle-aggro": true,
    "equip-slot": true,
    "unequip-slot": true,
    "swap-wep-set": true,
    "cam-zoom": true,
    "cam-center": true,
    "device-pick": true,
    "clear-order": true,
    "panel": true,
    "close-panel": true,
    "close-world-panel": true,
    "audio-toggle": true
  };

  /* В клетке доступно только то, что доступно в клетке. */
  var IN_JAIL_ALLOWED = {
    "jail-serve": true,
    "jail-escape": true,
    "jail-bribe": true,
    "jail-pick-toggle": true,
    "jail-pick-manual": true,
    "jail-lp-close": true,
    "jail-lp-nudge": true,
    "jail-lp-release": true,
    "jail-lp-turn": true,
    "stage-select": true,
    "eat": true,
    "drink": true,
    "treat": true,
    "auto-eat": true,
    "fight-close": true,
    "panel": true,
    "close-panel": true,
    "setting": true,
    "tab": true,
    "stage-close": true,
    "clock": true
  };

  /* На улице, когда к вам подошли, тоже не до торговли. */
  var IN_ENCOUNTER_ALLOWED = {
    "street-pay": true,
    "street-scare": true,
    "street-fight": true,
    "street-flee": true,
    "fight-start": true,
    "fight-order": true,
    "fight-step": true,
    "fight-move": true,
    "fight-hex": true,
    "fight-target": true,
    "fight-decide": true,
    "fight-close": true,
    "panel": true,
    "close-panel": true,
    "setting": true,
    "tab": true,
    "stage-close": true,
    "clock": true
  };

  /* ---------- Живая бесклеточная схватка Kenshi прямо в локации (0.0.9.1) ---------- */
  var skirmishRaf = null;
  var skirmishLastTs = 0;
  var skirmishDomAcc = 0;

  function stopSkirmishLoop() {
    if (skirmishRaf && global.cancelAnimationFrame) {
      global.cancelAnimationFrame(skirmishRaf);
    }
    skirmishRaf = null;
    skirmishLastTs = 0;
  }

  function startSkirmishLoop() {
    var st = getState();
    if (!Bow.skirmish || !st || !st.skirmish || (!st.skirmish.active && st.skirmish.phase !== "aftermath")) {
      stopSkirmishLoop();
      return;
    }
    var stCv = typeof document !== "undefined" ? document.querySelector("#bow-stage-canvas canvas.bow-iso-canvas") : null;
    if (!global.requestAnimationFrame || !stCv || !stCv.getBoundingClientRect || stCv.getBoundingClientRect().width <= 0) {
      return;
    }
    if (skirmishRaf) { return; }

    function stepFrame(ts) {
      var cur = getState();
      if (!cur || !cur.skirmish || (!cur.skirmish.active && (!cur.skirmish.fx || !cur.skirmish.fx.length))) {
        stopSkirmishLoop();
        refresh(true);
        return;
      }
      if (!skirmishLastTs) { skirmishLastTs = ts; }
      if (isWorldPaused(cur) || cur.skirmish.paused) {
        skirmishLastTs = ts;
        skirmishRaf = global.requestAnimationFrame(stepFrame);
        return;
      }
      var dt = Math.min(0.08, Math.max(0.012, (ts - skirmishLastTs) / 1000));
      skirmishLastTs = ts;

      var ev = Bow.skirmish.tick(cur, dt);
      if (ev && (ev.hit || ev.clash)) {
        if (Bow.audio && Bow.audio.playClashSteel && ev.clash) { Bow.audio.playClashSteel(); }
      }
      if (ev && ev.guardsArrived) {
        if (Bow.ui.flashClashBanner) { Bow.ui.flashClashBanner("⛨ Караул Студёного Брода вбегает в бой!"); }
        Bow.ui.setMessage("⛨ Караул Брода сбежался на шум схватки!");
      }
      if (ev && ev.ended) {
        stopSkirmishLoop();
        if (ev.message) { Bow.ui.setMessage(ev.message); }
        refresh(false, true);
        return;
      }

      if (Bow.ui.repaintIsoStage) { Bow.ui.repaintIsoStage(cur); }
      skirmishDomAcc += dt;
      if (skirmishDomAcc >= 0.16) {
        skirmishDomAcc = 0;
        if (Bow.ui.renderSkirmishHud) { Bow.ui.renderSkirmishHud(cur); }
        var layer = document.querySelector("#bow-stage-canvas .bow-stage-layer");
        if (layer && Bow.stage && Bow.stage.renderHotspotsAndActors) {
          var hHtml = Bow.stage.renderHotspotsAndActors(cur, null);
          if (layer._lastHtml !== hHtml) {
            layer._lastHtml = hHtml;
            layer.innerHTML = hHtml;
          }
        }
      }
      skirmishRaf = global.requestAnimationFrame(stepFrame);
    }
    skirmishRaf = global.requestAnimationFrame(stepFrame);
  }

  function launchLocationSkirmish(state, personId, opts) {
    if (!Bow.skirmish) { return { ok: false, message: "Боевой модуль не готов." }; }
    if (Bow.iso && Bow.iso.stopWalkLoop) { Bow.iso.stopWalkLoop(); }
    if (state.dialog) { Bow.dialog.close(state); }
    if (Bow.ui.setWorldPanel) { Bow.ui.setWorldPanel(false); }
    Bow.ui.setStageSelection(null);
    openSheet(null);

    var res = Bow.skirmish.engage(state, personId, opts || {});
    if (res && res.ok) {
      if (Bow.audio && Bow.audio.playClashSteel) { Bow.audio.playClashSteel(); }
      if (Bow.audio && Bow.audio.syncMood) { Bow.audio.syncMood(state); }
      if (Bow.ui.flashClashBanner) {
        Bow.ui.flashClashBanner(res.clashTitle ? ("⚔ " + res.clashTitle) : "⚔ Звенит сталь — к бою!");
      }
      startSkirmishLoop();
    }
    return res;
  }

  function blockedBy(state, act) {
    if (ALWAYS_ALLOWED[act]) { return null; }
    if (state.dead) { return act === "death-restart" ? null : "Всё кончено. Начните заново."; }
    if (state.skirmish && (state.skirmish.active || state.skirmish.phase === "aftermath") && !DURING_SKIRMISH_ALLOWED[act]) {
      return "Сначала закончите схватку!";
    }
    if (state.jail && !IN_JAIL_ALLOWED[act]) { return "Вы в клетке. Отсюда не выйти по своей воле."; }
    if (state.guard && !DURING_GUARD_ALLOWED[act]) { return "Сначала решите со стражей."; }
    if (state.encounter && !IN_ENCOUNTER_ALLOWED[act]) { return "Сначала решите с грабителем."; }
    if (state.fight && !DURING_FIGHT_ALLOWED[act]) { return "Сначала закончите бой."; }
    return null;
  }

  var suppressStageClickUntil = 0;

  function stageClickWorld(st, wx, wy) {
    if (!st || st.fight || !Bow.iso) { return false; }
    var isComaNow = !!(Bow.state && Bow.state.isComatose && Bow.state.isComatose(st.player));
    if (isComaNow) { return false; }

    var tile = { col: Math.round(wx), row: Math.round(wy) };
    var map = Bow.iso.mapOf(st);

    /* В живом бою Kenshi клик по земле задаёт манёвр / отход (работает и на паузе!) */
    if (st.skirmish && st.skirmish.active && Bow.skirmish) {
      Bow.skirmish.orderMove(st, wx, wy);
      if (isWorldPaused(st)) {
        Bow.ui.setMessage("⏸ Приказ манёвра принят. Нажмите ▶ или Пробел для продолжения боя.");
      }
      refresh(true);
      return true;
    }

    if (tile.col < 0 || tile.col >= Bow.iso.COLS || tile.row < 0 || tile.row >= Bow.iso.ROWS) {
      return false;
    }

    /* 1. Клик по двери / дорожным воротам */
    var hitExit = null;
    if (!st.jail && !st.guard && !st.encounter && map.exits) {
      for (var ei = 0; ei < map.exits.length; ei++) {
        if (Math.hypot(wx - map.exits[ei].col, wy - map.exits[ei].row) < 1.05) {
          hitExit = map.exits[ei];
          break;
        }
      }
    }
    if (hitExit) {
      if (isWorldPaused(st)) {
        var qDoor = queueOrderOnPause(st, {
          kind: "exit",
          exitTo: hitExit.to,
          wx: hitExit.col,
          wy: hitExit.row,
          label: "Войти — " + (hitExit.label || hitExit.to)
        });
        Bow.ui.setMessage(qDoor.message);
        refresh(true);
        return true;
      }
      performDoorExitMove(st, hitExit.to);
      refresh(true);
      return true;
    }

    /* 2. Клик по интерактивному объекту мира (колодец, очаг, горн, костёр) */
    var hitSpot = null;
    if (!st.jail && map.spots) {
      for (var si = 0; si < map.spots.length; si++) {
        if (map.spots[si].col === tile.col && map.spots[si].row === tile.row) {
          hitSpot = map.spots[si];
          break;
        }
      }
    }
    if (hitSpot) {
      if (isWorldPaused(st)) {
        var ptS = Bow.iso.tileToScreen(hitSpot.col, hitSpot.row);
        Bow.ui.setStageSelection({
          kind: "prop",
          propKey: hitSpot.key,
          spot: hitSpot,
          x: Math.round((ptS.x / Bow.iso.VIEW_W) * 100)
        });
        var qSpot = queueOrderOnPause(st, {
          kind: "spot",
          spot: hitSpot,
          wx: hitSpot.col,
          wy: hitSpot.row,
          label: "Подойти — " + (hitSpot.title || "Объект")
        });
        Bow.ui.setMessage(qSpot.message);
        refresh(true);
        return true;
      }
      Bow.iso.walkAdjacentAndAct(st, hitSpot.col, hitSpot.row, function () {
        var ptScr = Bow.iso.tileToScreen(hitSpot.col, hitSpot.row);
        Bow.ui.setStageSelection({
          kind: "prop",
          propKey: hitSpot.key,
          spot: hitSpot,
          x: Math.round((ptScr.x / Bow.iso.VIEW_W) * 100)
        });
        refresh(true);
      }, function () {
        if (Bow.ui.repaintIsoStage) { Bow.ui.repaintIsoStage(st); }
      });
      refresh(true);
      return true;
    }

    /* 3. Плавный бесклеточный шаг Point-and-Click в точку (wx, wy) */
    if (isWorldPaused(st)) {
      var qWalk = queueOrderOnPause(st, {
        kind: "walk",
        wx: wx,
        wy: wy,
        label: "Идти в выбранную точку"
      });
      Bow.ui.setMessage(qWalk.message);
      refresh(true);
      return true;
    }

    st.pendingOrder = null;
    Bow.iso.walkTo(st, wx, wy, function () {
      refresh(true);
    }, function () {
      if (Bow.ui.repaintIsoStage) { Bow.ui.repaintIsoStage(st); }
    });
    if (Bow.ui.repaintIsoStage) { Bow.ui.repaintIsoStage(st); }
    return true;
  }

  function onClick(event) {
    if (Date.now() < suppressStageClickUntil && event.target && event.target.closest && event.target.closest("#bow-stage")) {
      event.preventDefault();
      return;
    }
    if (Bow.audio && Bow.audio.wakeOnGesture) { Bow.audio.wakeOnGesture(); }
    var el = event.target.closest("[data-act]");
    if (!el) {
      var stageWrap = event.target.closest && event.target.closest("#bow-stage-canvas");
      if (stageWrap && !event.target.closest("#bow-stage-pop") && !event.target.closest("#bow-skirmish-hud")) {
        Bow.ui.setStageSelection(null);
        var st = getState();
        var isoCv = stageWrap.querySelector("canvas.bow-iso-canvas");
        var rect = isoCv && isoCv.getBoundingClientRect ? isoCv.getBoundingClientRect() : null;
        if (rect && rect.width > 40 && rect.height > 40 && Bow.iso) {
          var stgPt = Bow.iso.clientToStage
            ? Bow.iso.clientToStage(event.clientX, event.clientY, stageWrap)
            : { sx: ((event.clientX - rect.left) / rect.width) * Bow.iso.VIEW_W, sy: ((event.clientY - rect.top) / rect.height) * Bow.iso.VIEW_H };
          var wPt = Bow.iso.screenToWorld ? Bow.iso.screenToWorld(stgPt.sx, stgPt.sy) : null;
          if (wPt && stageClickWorld(st, wPt.wx, wPt.wy)) {
            return;
          }
        }
        refresh(true);
      }
      return;
    }

    var act = el.getAttribute("data-act");
    var fn = handlers[act];
    if (!fn) { return; }

    var why = blockedBy(getState(), act);
    if (why) {
      event.preventDefault();
      Bow.ui.setMessage(why);
      refresh(true);
      return;
    }

    event.preventDefault();

    /* Кнопка блокируется на время обработки: защита от двойного клика,
       из-за которого в прототипе время шло вдвое быстрее. */
    if (el.disabled) { return; }
    el.disabled = true;

    var result;
    try {
      result = fn(el);
    } catch (err) {
      if (global.console) { global.console.error("[Bow] ошибка действия", err); }
      Bow.ui.setMessage("Действие не выполнено: внутренняя ошибка.");
      el.disabled = false;
      refresh(true);
      return;
    }

    if (result && result.ok === false) {
      Bow.ui.setMessage(result.message);
      el.disabled = false;
      refresh(true);
      return;
    }

    say(result);
    el.disabled = false;
  }

  /* ---------- Живое время ----------
     Один таймер на всю игру. Он не двигает часы сам: только просит
     Bow.time.tick() пройти один час через того же владельца времени,
     что и действия. Поэтому ускорение не «дублирует» ход.
     Пока панель или диалог открыты, время не идёт: игрок читает. */
  var clockTimer = null;
  var clockAccum = 0;

  /* Правило одной строкой: время идёт, только если игрок не читает.
     Вынесено отдельно, чтобы его можно было проверить тестом. */
  function clockShouldRun(state) {
    if (!state || !state.time) { return false; }
    if (state.time.scale === "paused") { return false; }
    if (state.dialog) { return false; }
    /* Живая схватка и пошаговое поле брани: мировые часы стоят на время боя. */
    if (state.skirmish && (state.skirmish.active || state.skirmish.phase === "aftermath")) { return false; }
    if (state.fight) { return false; }
    if (state.flags && state.flags.lastFight) { return false; }
    /* Стража на улице и грабитель ждут решения игрока; в клетке живое время ТЕПЕРЬ идёт само и мотает срок (0.0.8.1)! */
    if (state.guard || state.encounter) { return false; }
    if (state.dead) { return false; }
    if (Bow.ui.isDrawerOpen()) { return false; }
    if (openPersonId) { return false; }
    return true;
  }

  /* ---------- Спокойный автобой (0.0.7.4): ~2.6 сек. на круг, мировое время стоит ---------- */
  var fightTimer = null;

  function fightShouldRun(state) {
    var st = state || getState();
    if (!st || st.dead) { return false; }
    if (!st.fight || st.fight.phase !== "exchange") { return false; }
    if (Bow.ui.isDrawerOpen() || openPersonId) { return false; }
    var ord = Bow.fight.ensureOrders ? Bow.fight.ensureOrders(st.fight) : st.fight.orders;
    return !!(ord && ord.speed === "auto");
  }

  function stopFightClock() {
    if (fightTimer) {
      global.clearInterval(fightTimer);
      fightTimer = null;
    }
  }

  function startFightClock() {
    stopFightClock();
    var state = getState();
    if (!fightShouldRun(state)) { return; }
    var intervalMs = (Bow.data && Bow.data.fightRules && Bow.data.fightRules.autoTickMs) || 2600;
    fightTimer = global.setInterval(function () {
      var st = getState();
      if (!fightShouldRun(st)) {
        if (!st || !st.fight || st.fight.phase !== "exchange") { stopFightClock(); }
        return;
      }
      var res = Bow.adapter.act.fightStep(st);
      if (res && res.message) { Bow.ui.setMessage(res.message); }
      refresh(true);
      if (!st.fight || st.fight.phase !== "exchange") { stopFightClock(); }
    }, intervalMs);
  }

  /* ---------- Живой цикл сторожа и полоски взлома Kenshi в клетке (0.0.8.2) ---------- */
  var jailTimer = null;
  var jailUserWakeUntil = 0;

  function stopJailClock() {
    if (jailTimer) {
      global.clearInterval(jailTimer);
      jailTimer = null;
    }
  }

  function startJailClock() {
    if (jailTimer) { return; }
    var st0 = getState();
    if (!st0 || !st0.jail || st0.dead) { return; }
    jailTimer = global.setInterval(function () {
      var st = getState();
      if (!st || !st.jail || st.dead) {
        stopJailClock();
        return;
      }
      if (isWorldPaused(st)) {
        return;
      }
      var lpOpen = !!(Bow.ui.getLockpickModalState && Bow.ui.getLockpickModalState().open);
      var activeClock = st.time && st.time.scale !== "paused";
      if (!st.jail.picking && !lpOpen && !activeClock && Date.now() > jailUserWakeUntil) {
        stopJailClock();
        return;
      }
      if (Bow.ui.isDrawerOpen() || openPersonId) { return; }
      var tickRes = (Bow.guard && Bow.guard.tickJailScene) ? Bow.guard.tickJailScene(st, Bow.adapter.rng) : null;
      if (tickRes && tickRes.changed) {
        if (tickRes.caught) {
          if (Bow.ui.closeLockpickModal) { Bow.ui.closeLockpickModal(); }
          if (Bow.ui.triggerVeil) { Bow.ui.triggerVeil(); }
        } else if (tickRes.unlocked) {
          if (Bow.ui.closeLockpickModal) { Bow.ui.closeLockpickModal(); }
          if (Bow.ui.triggerVeil) { Bow.ui.triggerVeil(); }
        }
        if (tickRes.message) { Bow.ui.setMessage(tickRes.message); }
        refresh(true);
      }
    }, 950);
  }

  function stopClock() {
    if (clockTimer) {
      global.clearInterval(clockTimer);
      clockTimer = null;
    }
    clockAccum = 0;
  }

  function startClock() {
    stopClock();
    var state = getState();
    var scale = state.time.scale || "paused";
    if (scale === "paused") { return; }

    var perSec = Bow.time.minutesPerSecond ? Bow.time.minutesPerSecond(scale) : 0;
    if (!perSec) { return; }

    /* Шаг проверки — раз в 500 мс:
       на 1x (0.5 мин./с) 1 игровая минута проходит ровно за 2000 мс (2 секунды),
       на 4x (2.0 мин./с) 1 игровая минута проходит за 500 мс (0.5 секунды). */
    clockTimer = global.setInterval(function () {
      var st = getState();
      if (st.time.scale === "paused") { stopClock(); return; }

      if (!clockShouldRun(st)) { return; }

      var rate = Bow.time.minutesPerSecond ? Bow.time.minutesPerSecond(st.time.scale) : 0;
      clockAccum += rate * 0.5;
      var steps = 0;
      while (clockAccum >= 1 && steps < 12) {
        clockAccum -= 1;
        Bow.time.tickMinute(st);
        steps += 1;
      }
      if (steps > 0) { refresh(true); }
    }, 500);
  }

  /* ---------- Сохранения ---------- */

  function exportSave() {
    var state = getState();
    var data = Bow.save.serialize(state, Date.now());
    var blob = new Blob([data], { type: "application/json" });
    var url = URL.createObjectURL(blob);
    var a = document.createElement("a");
    a.href = url;
    a.download = "blades-of-war-" + state.version + "-" + state.time.totalHours + "h.json";
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    Bow.ui.setMessage("Сохранение выгружено в файл.");
    refresh(true);
  }

  function importSave() {
    var input = document.createElement("input");
    input.type = "file";
    input.accept = ".json,application/json";

    input.addEventListener("change", function () {
      var file = input.files && input.files[0];
      if (!file) { return; }

      var reader = new FileReader();
      reader.onload = function () {
        var result = Bow.save.deserialize(String(reader.result));

        if (!result.ok) {
          Bow.ui.setMessage("Загрузка отклонена: " + result.reason);
          refresh(true);
          return;
        }

        stopFightClock();
        Bow.ui.setDrawer(false);
        Bow.ui.setStageSelection(null);
        openSheet(null);
        vars().game = result.state;
        Bow.ui.setMessage(
          result.mode === "migrated"
            ? "Сохранение перенесено с версии " + result.migratedFrom + " и загружено."
            : "Сохранение загружено."
        );
        refresh();
        startClock();
        startFightClock();
      };
      reader.readAsText(file);
    });

    input.click();
  }

  function restart() {
    stopFightClock();
    Bow.ui.setDrawer(false);
    Bow.ui.setStageSelection(null);
    openSheet(null);
    vars().game = Bow.adapter.freshState();
    vars().game.createdAt = Date.now();
    Bow.ui.setMessage("Новая игра начата. Прежний прогресс в памяти браузера перезаписан.");
    refresh();
    startClock();
  }

  function loadAutosave() {
    var raw;
    try {
      raw = global.localStorage.getItem(AUTOSAVE_KEY);
    } catch (err) {
      Bow.ui.setMessage("Автосохранение недоступно в этом режиме браузера.");
      refresh(true);
      return;
    }
    if (!raw) {
      Bow.ui.setMessage("Автосохранения нет — вы в начале пути.");
      refresh(true);
      return;
    }

    var result = Bow.save.deserialize(raw);
    if (!result.ok) {
      Bow.ui.setMessage("Автосохранение не подходит: " + result.reason);
      refresh(true);
      return;
    }

    stopFightClock();
    Bow.ui.setDrawer(false);
    Bow.ui.setStageSelection(null);
    openSheet(null);
    vars().game = result.state;
    Bow.ui.setMessage("Продолжаем с автосохранения.");
    refresh();
    startClock();
    startFightClock();
  }

  /* Тихая проверка автосейва при старте: без сообщений игроку.
     Вызывается из StoryInit. */
  function loadAutosaveSilent() {
    var raw = null;
    try { raw = global.localStorage.getItem(AUTOSAVE_KEY); }
    catch (err) { return false; }

    if (!raw) { return false; }

    var result = Bow.save.deserialize(raw);
    if (!result.ok) { return false; }

    vars().game = result.state;
    return true;
  }

  /* ---------- Публичный мост ---------- */

  var api = {
    getState: getState,
    refresh: refresh,
    isWorldPaused: isWorldPaused,
    applyGlobalScale: applyGlobalScale,
    queueOrderOnPause: queueOrderOnPause,
    stageClickWorld: stageClickWorld,
    clockShouldRun: clockShouldRun,
    fightShouldRun: fightShouldRun,
    startClock: startClock,
    stopClock: stopClock,
    startFightClock: startFightClock,
    stopFightClock: stopFightClock,
    startJailClock: startJailClock,
    stopJailClock: stopJailClock,
    flushAutosave: flushAutosave,
    exportSave: exportSave,
    importSave: importSave,
    restart: restart,
    loadAutosave: loadAutosave,
    loadAutosaveSilent: loadAutosaveSilent,
    hasAutosave: function () {
      try { return !!global.localStorage.getItem(AUTOSAVE_KEY); }
      catch (err) { return false; }
    }
  };

  global.BowGame = api;

  /* Инициализация после загрузки DOM. */
  function boot() {
    if (!document.getElementById("bow-app")) { return; }

    var appEl = document.getElementById("bow-app");

    /* Разблокировка Web Audio синхронно на первом жесте игрока (критично для iOS/Android) */
    var unlockAudioOnce = function () {
      if (Bow.audio && Bow.audio.unlockGesture) { Bow.audio.unlockGesture(false); }
    };
    appEl.addEventListener("pointerdown", unlockAudioOnce, { passive: true });
    appEl.addEventListener("touchstart", unlockAudioOnce, { passive: true });

    appEl.addEventListener("click", onClick);
    appEl.addEventListener("pointermove", function (event) {
      var st = getState();
      if (st && st.jail) {
        jailUserWakeUntil = Date.now() + 45000;
        if (!jailTimer) { startJailClock(); }
      }
      var entBtn = event.target && event.target.closest && event.target.closest("[data-entity-id]");
      var nextEntId = entBtn ? entBtn.getAttribute("data-entity-id") : null;
      var prevEntId = Bow.iso && Bow.iso.getHoverEntity ? Bow.iso.getHoverEntity() : null;
      var entChanged = false;
      if (Bow.iso && Bow.iso.setHoverEntity && nextEntId !== prevEntId) {
        Bow.iso.setHoverEntity(nextEntId);
        entChanged = true;
      }

      var stageWrapMove = event.target && event.target.closest && event.target.closest("#bow-stage-canvas");
      if (stageWrapMove && Bow.iso && Bow.iso.setHoverScreen && (!st || !st.fight)) {
        var cRect = stageWrapMove.getBoundingClientRect();
        if (cRect && cRect.width > 40) {
          var stPt = Bow.iso.clientToStage
            ? Bow.iso.clientToStage(event.clientX, event.clientY, stageWrapMove)
            : { sx: ((event.clientX - cRect.left) / cRect.width) * Bow.iso.VIEW_W, sy: ((event.clientY - cRect.top) / cRect.height) * Bow.iso.VIEW_H };
          var prevH = Bow.iso._lastHoverKey || "";
          var curH = Bow.iso.setHoverScreen(stPt.sx, stPt.sy);
          var nextH = curH ? (curH.col + "," + curH.row) : "";
          if (nextH !== prevH || entChanged) {
            Bow.iso._lastHoverKey = nextH;
            if (Bow.ui.repaintIsoStage) { Bow.ui.repaintIsoStage(st); }
          }
        }
      } else if (entChanged && Bow.ui.repaintIsoStage) {
        Bow.ui.repaintIsoStage(st);
      }

      var lpStage = event.target && event.target.closest && event.target.closest("#bow-lp-stage");
      if (lpStage && Bow.ui.getLockpickModalState && Bow.ui.getLockpickModalState().open) {
        var rect = lpStage.getBoundingClientRect();
        if (rect && rect.width > 20) {
          var ratio = (event.clientX - rect.left) / rect.width;
          var deg = Math.round((ratio - 0.5) * 170);
          Bow.ui.setLockpickAngle(deg, st);
        }
      }
    });

    /* Свободная камера на сцене (0.0.9.2): колёсико мыши, перетаскивание 1 пальцем и pinch-zoom 2 пальцами */
    var stageRoot = document.getElementById("bow-stage");
    if (stageRoot) {
      stageRoot.addEventListener("wheel", function (ev) {
        var vp = document.getElementById("bow-stage-canvas");
        if (!vp || !Bow.iso || !Bow.iso.setCameraZoom || !ev.target.closest("#bow-stage-canvas")) { return; }
        if (ev.target.closest("#bow-stage-pop")) { return; }
        ev.preventDefault();
        var cam = Bow.iso.getCamera();
        var delta = ev.deltaY < 0 ? 0.14 : -0.14;
        Bow.iso.setCameraZoom(cam.zoom + delta, vp, getState());
      }, { passive: false });

      var camDrag = { active: false, moved: false, startX: 0, startY: 0, lastX: 0, lastY: 0, pinchDist: 0, pinchStartZoom: 1 };

      stageRoot.addEventListener("mousedown", function (ev) {
        if ((ev.button === 1 || (ev.button === 0 && ev.shiftKey)) && ev.target.closest("#bow-stage-canvas")) {
          ev.preventDefault();
          camDrag.active = true;
          camDrag.moved = false;
          camDrag.startX = ev.clientX;
          camDrag.startY = ev.clientY;
          camDrag.lastX = ev.clientX;
          camDrag.lastY = ev.clientY;
        }
      });
      global.addEventListener("mousemove", function (ev) {
        if (!camDrag.active) { return; }
        var dx = ev.clientX - camDrag.lastX;
        var dy = ev.clientY - camDrag.lastY;
        camDrag.lastX = ev.clientX;
        camDrag.lastY = ev.clientY;
        if (Math.hypot(ev.clientX - camDrag.startX, ev.clientY - camDrag.startY) > 6) {
          camDrag.moved = true;
        }
        var vp = document.getElementById("bow-stage-canvas");
        if (vp && Bow.iso && Bow.iso.panCameraBy) {
          Bow.iso.panCameraBy(dx, dy, vp, getState());
        }
      });
      global.addEventListener("mouseup", function () {
        if (camDrag.active && camDrag.moved) { suppressStageClickUntil = Date.now() + 220; }
        camDrag.active = false;
      });

      stageRoot.addEventListener("touchstart", function (ev) {
        if (!ev.target.closest("#bow-stage-canvas") || ev.target.closest("#bow-stage-pop") || ev.target.closest("#bow-skirmish-hud")) { return; }
        if (ev.touches.length === 2 && Bow.iso && Bow.iso.getCamera) {
          var d0 = Math.hypot(ev.touches[0].clientX - ev.touches[1].clientX, ev.touches[0].clientY - ev.touches[1].clientY);
          camDrag.pinchDist = Math.max(12, d0);
          camDrag.pinchStartZoom = Bow.iso.getCamera().zoom;
          camDrag.moved = true;
          suppressStageClickUntil = Date.now() + 350;
        } else if (ev.touches.length === 1) {
          camDrag.startX = ev.touches[0].clientX;
          camDrag.startY = ev.touches[0].clientY;
          camDrag.lastX = ev.touches[0].clientX;
          camDrag.lastY = ev.touches[0].clientY;
          camDrag.moved = false;
          camDrag.pinchDist = 0;
        }
      }, { passive: true });

      stageRoot.addEventListener("touchmove", function (ev) {
        var vp = document.getElementById("bow-stage-canvas");
        if (!vp || !Bow.iso || !ev.target.closest("#bow-stage-canvas") || ev.target.closest("#bow-stage-pop")) { return; }
        if (ev.touches.length === 2 && camDrag.pinchDist > 0) {
          ev.preventDefault();
          var d1 = Math.hypot(ev.touches[0].clientX - ev.touches[1].clientX, ev.touches[0].clientY - ev.touches[1].clientY);
          var ratioZ = d1 / camDrag.pinchDist;
          Bow.iso.setCameraZoom(camDrag.pinchStartZoom * ratioZ, vp, getState());
          suppressStageClickUntil = Date.now() + 350;
        } else if (ev.touches.length === 1) {
          var tx = ev.touches[0].clientX;
          var ty = ev.touches[0].clientY;
          var totalMove = Math.hypot(tx - camDrag.startX, ty - camDrag.startY);
          if (totalMove > 9) {
            ev.preventDefault();
            camDrag.moved = true;
            Bow.iso.panCameraBy(tx - camDrag.lastX, ty - camDrag.lastY, vp, getState());
            suppressStageClickUntil = Date.now() + 280;
          }
          camDrag.lastX = tx;
          camDrag.lastY = ty;
        }
      }, { passive: false });
    }

    appEl.addEventListener("input", function (event) {
      var target = event.target;
      if (target && target.getAttribute && target.getAttribute("data-act") === "audio-vol" && Bow.audio) {
        Bow.audio.setVolume(parseFloat(target.value) / 100);
      }
      if (target && target.id === "bow-lp-range" && Bow.ui.setLockpickAngle) {
        Bow.ui.setLockpickAngle(parseFloat(target.value), getState());
      }
    });

    /* Клик по тёмному фону закрывает окно персонажа. */
    var sheet = document.getElementById("bow-sheet");
    if (sheet) {
      sheet.addEventListener("click", function (event) {
        if (event.target === sheet) { openSheet(null); }
      });
    }

    /* Escape закрывает модальное окно или карточку сцены; Пробел — ЕДИНАЯ глобальная пауза (вне боя и в бою!). */
    document.addEventListener("keydown", function (event) {
      var tag = event.target && event.target.tagName ? event.target.tagName.toLowerCase() : "";
      if (tag === "input" || tag === "textarea" || tag === "select") { return; }

      var lp = Bow.ui.getLockpickModalState ? Bow.ui.getLockpickModalState() : null;
      if (lp && lp.open) {
        if (event.key === "Escape") {
          event.preventDefault();
          Bow.ui.closeLockpickModal();
          refresh(true);
          return;
        }
        if (event.key === "ArrowLeft" || event.key === "a" || event.key === "A" || event.key === "ф" || event.key === "Ф") {
          event.preventDefault();
          Bow.ui.setLockpickAngle((lp.pickAngle || 0) - 6, getState());
          return;
        }
        if (event.key === "ArrowRight" || event.key === "d" || event.key === "D" || event.key === "в" || event.key === "В") {
          event.preventDefault();
          Bow.ui.setLockpickAngle((lp.pickAngle || 0) + 6, getState());
          return;
        }
        if (event.key === " " || event.code === "Space" || event.key === "e" || event.key === "E" || event.key === "у" || event.key === "У") {
          event.preventDefault();
          var turnRes = handlers["jail-lp-turn"]();
          say(turnRes);
          return;
        }
      }
      if (event.key === "Tab") {
        var stTab = getState();
        if (stTab && !stTab.fight && !Bow.ui.isDrawerOpen() && !(Bow.ui.isWorldPanelOpen && Bow.ui.isWorldPanelOpen())) {
          event.preventDefault();
          var agRes = handlers["toggle-aggro"]();
          say(agRes);
          return;
        }
      }
      if (event.key === " " || event.code === "Space") {
        var st = getState();
        if (!st || Bow.ui.isDrawerOpen()) { return; }
        if (st.fight && st.fight.phase === "exchange") {
          event.preventDefault();
          var ord = Bow.fight.ensureOrders(st.fight);
          Bow.fight.setOrder(st, "speed", ord.speed === "auto" ? "paused" : "auto");
          startFightClock();
          refresh(true);
          return;
        }
        event.preventDefault();
        var nextGlobalScale = isWorldPaused(st) ? "1x" : "paused";
        var spMsg = applyGlobalScale(st, nextGlobalScale);
        Bow.ui.setMessage(spMsg || (nextGlobalScale === "paused" ? "⏸ Тактическая пауза." : "▶ Время идёт."));
        return;
      }
      if (event.key !== "Escape") { return; }
      if (Bow.ui.isWorldPanelOpen && Bow.ui.isWorldPanelOpen()) { Bow.ui.setWorldPanel(false); return; }
      if (Bow.ui.isDrawerOpen()) { Bow.ui.setDrawer(false); startFightClock(); return; }
      if (openPersonId) { openSheet(null); startFightClock(); return; }
      Bow.ui.setStageSelection(null);
      refresh(true);
    });

    /* Тап мимо панели закрывает её — но только там, где панель
       наезжает поверх сцены (планшет и телефон). На компьютере панель
       встроена в поток: закрывать её от случайного клика по сцене
       было бы неожиданно. Само затемнение рисует ::after на узком
       экране; событие всплывает от него к контейнеру. */
    var bodyEl = document.getElementById("bow-body");
    if (bodyEl) {
      bodyEl.addEventListener("click", function (event) {
        if (!Bow.ui.isDrawerOpen()) { return; }
        if (!window.matchMedia || !window.matchMedia("(max-width: 900px)").matches) { return; }
        /* Клик пришёл мимо панели и мимо рельсы — значит, по затемнению. */
        if (event.target.closest("#bow-drawer") || event.target.closest("#bow-rail")) { return; }
        Bow.ui.setDrawer(false);
      });
    }

    /* Логотип раскрывает и убирает панель. */
    var logoBtn = document.getElementById("bow-logo-btn");
    if (logoBtn) {
      logoBtn.addEventListener("click", function (event) {
        event.preventDefault();
        Bow.ui.toggleDrawer();
      });
    }

    var btnSave = document.getElementById("bow-btn-save");
    if (btnSave) { btnSave.addEventListener("click", exportSave); }

    var btnLoad = document.getElementById("bow-btn-load");
    if (btnLoad) { btnLoad.addEventListener("click", importSave); }

    var btnRestart = document.getElementById("bow-btn-restart");
    if (btnRestart) { btnRestart.addEventListener("click", restart); }

    var btnContinue = document.getElementById("bow-btn-continue");
    if (btnContinue) {
      btnContinue.addEventListener("click", loadAutosave);
      btnContinue.disabled = false;
    }

    /* Гарантированный сброс отложенного автосейва при закрытии или сворачивании вкладки */
    global.addEventListener("pagehide", function () { if (autosaveDirty) { flushAutosave(true); } });
    global.addEventListener("beforeunload", function () { if (autosaveDirty) { flushAutosave(true); } });

    /* Применяем сохранённые настройки и отрисовываем стартовый экран. */
    if (Bow.ui.applySettings) { Bow.ui.applySettings(); }
    Bow.ui.setMessage("Осмотритесь. Здесь пока немного людей, но они настоящие.");
    refresh(true, true);
    startClock();
    if (Bow.ui.showDeviceModalIfNeeded) { Bow.ui.showDeviceModalIfNeeded(); }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }

})(typeof window !== "undefined" ? window : this);
