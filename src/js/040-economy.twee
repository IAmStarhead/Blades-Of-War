:: bow-economy [script]
/* ============================================================
   BOW ECONOMY — деньги, предметы, торговля.
   Деньги хранятся ТОЛЬКО в player.money и в кошельке NPC.
   Отдельного «предмета-монеты» нет: это была ошибка прототипа
   с двойным учётом.
   ============================================================ */
(function (global) {
  "use strict";

  var Bow = global.Bow = global.Bow || {};

  function findItemDef(itemId) {
    var items = Bow.data.items;
    var keys = Object.keys(items);
    for (var i = 0; i < keys.length; i++) {
      if (items[keys[i]].id === itemId) { return items[keys[i]]; }
    }
    return null;
  }

  /* Обратный поиск: по объекту товара вернуть его ключ в данных.
     Нужен интерфейсу, чтобы слать в действия именно ключ. */
  function keyOf(def) {
    if (!def) { return null; }
    var items = Bow.data.items;
    var keys = Object.keys(items);
    for (var i = 0; i < keys.length; i++) {
      if (items[keys[i]].id === def.id) { return keys[i]; }
    }
    return null;
  }

  function itemKeysOf(locationId) {
    var loc = Bow.data.locations[locationId];
    return loc ? loc.trades.slice() : [];
  }

  /* Цена покупки: базовая, слегка плывёт от состояния поселения.
     Пока без сложной экономики — честная простая надбавка. */
  function buyPrice(key, state) {
    var item = Bow.data.items[key];
    if (!item) { return null; }
    var mood = state.player.needs.mood;
    /* Рынок чуть охотнее торгуется с тем, у кого спокойный вид. */
    var modifier = mood >= 60 ? 1.0 : mood >= 30 ? 1.05 : 1.12;
    return Math.max(1, Math.round(item.base * modifier));
  }

  function sellPrice(key) {
    var item = Bow.data.items[key];
    if (!item) { return null; }
    return Math.max(1, Math.floor(item.base * 0.55));
  }

  function addItem(player, itemId, qty) {
    var entry = player.inventory.filter(function (e) { return e.itemId === itemId; })[0];
    if (entry) {
      entry.qty += qty;
    } else {
      player.inventory.push({ itemId: itemId, qty: qty });
    }
    return player.inventory;
  }

  function removeItem(player, itemId, qty) {
    var idx = -1;
    for (var i = 0; i < player.inventory.length; i++) {
      if (player.inventory[i].itemId === itemId) { idx = i; break; }
    }
    if (idx === -1) { return false; }

    var entry = player.inventory[idx];
    if (entry.qty < qty) { return false; }

    entry.qty -= qty;
    if (entry.qty <= 0) { player.inventory.splice(idx, 1); }
    return true;
  }

  function countItem(player, itemId) {
    var entry = player.inventory.filter(function (e) { return e.itemId === itemId; })[0];
    return entry ? entry.qty : 0;
  }

  function totalWeight(player) {
    return player.inventory.reduce(function (sum, entry) {
      var def = findItemDef(entry.itemId);
      return sum + (def ? def.weight * entry.qty : 0);
    }, 0);
  }

  /* ---------- Действия ---------- */

  function buy(state, locationId, key, qty) {
    qty = qty || 1;
    var item = Bow.data.items[key];
    if (!item) { return { ok: false, message: "Такого товара здесь нет." }; }

    if (itemKeysOf(locationId).indexOf(key) === -1) {
      return { ok: false, message: "В этом месте таким не торгуют." };
    }

    var price = buyPrice(key, state) * qty;
    if (state.player.money < price) {
      return { ok: false, message: "Не хватает монет: нужно " + price + ", у вас " + state.player.money + "." };
    }

    state.player.money -= price;
    addItem(state.player, item.id, qty);
    state.stats.tradesMade += 1;
    state.stats.actionsTaken += 1;

    Bow.bus.emit("trade:buy", { state: state, key: key, qty: qty, price: price });
    return {
      ok: true,
      message: "Куплено: " + item.name + (qty > 1 ? " ×" + qty : "") + " за " + price + " монет.",
      price: price
    };
  }

  function sell(state, locationId, key, qty) {
    qty = qty || 1;
    var item = Bow.data.items[key];
    if (!item) { return { ok: false, message: "Такого товара нет." }; }

    if (itemKeysOf(locationId).indexOf(key) === -1) {
      return { ok: false, message: "Здесь это не покупают." };
    }

    if (countItem(state.player, item.id) < qty) {
      return { ok: false, message: "У вас нет столько: " + item.name + "." };
    }

    var price = sellPrice(key) * qty;
    removeItem(state.player, item.id, qty);
    state.player.money += price;
    state.stats.tradesMade += 1;
    state.stats.actionsTaken += 1;

    Bow.bus.emit("trade:sell", { state: state, key: key, qty: qty, price: price });
    return { ok: true, message: "Продано: " + item.name + " за " + price + " монет.", price: price };
  }

  Bow.economy = {
    findItemDef: findItemDef,
    keyOf: keyOf,
    buyPrice: buyPrice,
    sellPrice: sellPrice,
    addItem: addItem,
    removeItem: removeItem,
    countItem: countItem,
    totalWeight: totalWeight,
    buy: buy,
    sell: sell
  };

})(typeof window !== "undefined" ? window : this);
