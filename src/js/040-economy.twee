:: bow-economy [script]
/* ============================================================
   BOW ECONOMY — деньги, предметы, торговля.
   Деньги хранятся ТОЛЬКО в player.money и в кошельке NPC.
   Отдельного «предмета-монеты» нет: это была ошибка прототипа
   с двойным учётом.
   ============================================================ */
(function (global) {
  "use strict";

  var Bow = global.Bow = global.Bow || {};

  function findItemDef(itemId) {
    var items = Bow.data.items;
    var keys = Object.keys(items);
    for (var i = 0; i < keys.length; i++) {
      if (items[keys[i]].id === itemId) { return items[keys[i]]; }
    }
    return null;
  }

  /* Обратный поиск: по объекту товара вернуть его ключ в данных.
     Нужен интерфейсу, чтобы слать в действия именно ключ. */
  function keyOf(def) {
    if (!def) { return null; }
    var items = Bow.data.items;
    var keys = Object.keys(items);
    for (var i = 0; i < keys.length; i++) {
      if (items[keys[i]].id === def.id) { return keys[i]; }
    }
    return null;
  }

  function itemKeysOf(locationId) {
    var loc = Bow.data.locations[locationId];
    return loc ? loc.trades.slice() : [];
  }

  /* Цена покупки: базовая, слегка плывёт от состояния поселения.
     Пока без сложной экономики — честная простая надбавка. */
  /* Наценка за отношение общины: тому, кого уважают, продают дешевле,
     а тому, кого считают врагом, — дороже. Репутация не «очки в вакууме»:
     она меняет цену на прилавке, и это видно в подписи товара. */
  function repModifier(state, locationId) {
    var orgId = Bow.data.locations[locationId] ? Bow.data.locations[locationId].org : null;
    if (!orgId || !Bow.work || !state.reputation) { return 1; }
    var rep = Bow.work.reputation(state, orgId);
    /* Скидка за доброе имя заметнее прежней: 0.88 на хлебе за 3
       давало 2, как и нейтраль, и разница исчезала. */
    /* 0.72 — это заметно и на хлебе за 3 (2.16 → 2), и на топоре.
       Скидка за доброе имя должна читаться, а не исчезать в округлении. */
    if (rep >= 60) { return 0.72; }
    if (rep >= 25) { return 0.89; }
    if (rep <= -60) { return 1.35; }
    if (rep <= -25) { return 1.2; }
    return 1;
  }

  /* ---------- Торг ----------
     Каждые десять очков торга дают 2% в свою пользу, потолок — 14%.
     Навык растёт медленно, поэтому разница видна не сразу, но она
     настоящая: одна и та же вещь стоит по-разному. */
  function tradeModifier(state) {
    if (!state || !state.player) { return 1; }
    var trade = (state.player.skills && state.player.skills.trade) || 0;
    /* Три процента за каждые десять очков, потолок — 18%.
       Навык растёт медленно, поэтому это видно не сразу. */
    return 1 - Math.min(0.18, trade * 0.003);
  }

  function buyPrice(key, state, locationId) {
    var item = Bow.data.items[key];
    if (!item) { return null; }
    var mood = state.player.needs.mood;
    /* Рынок чуть охотнее торгуется с тем, у кого спокойный вид. */
    var modifier = mood >= 60 ? 1.0 : mood >= 30 ? 1.03 : 1.12;
    var loc = locationId || (state.player ? state.player.location : null);
    modifier *= repModifier(state, loc);

    /* Торг впервые что-то делает (0.0.6.3): до этого навык рос
       от работы, но на цену не влиял. Скидка до 14%. */
    modifier *= tradeModifier(state);

    /* Скидка и наценка складываются в один множитель, и округление
       делается один раз: скидка вниз, наценка вверх. Раньше на хлебе
       за 3 уважение и торг по отдельности загоняли цену в один и тот
       же пол, и «торгуетесь вы или нет» было не видно. */
    var raw = item.base * modifier;
    var price = modifier < 1 ? Math.floor(raw) : Math.ceil(raw);
    return Math.max(1, price);
  }

  function sellPrice(key, state, locationId) {
    var item = Bow.data.items[key];
    if (!item) { return null; }
    var factor = 0.55;
    /* Хорошее имя помогает и при продаже: скупщик даёт больше. */
    if (state) {
      var loc = locationId || (state.player ? state.player.location : null);
      factor = factor / repModifier(state, loc);
      /* Торг помогает и продавать: скупщик не так сильно жмёт. */
      factor = factor / tradeModifier(state);
    }
    /* Округление в пользу игрока: иначе на дешёвом товаре разница
       между «уважают» и «не знают» исчезает в floor (3 × 0.55 = 1.65). */
    return Math.max(1, Math.round(item.base * factor));
  }

  function addItem(player, itemId, qty) {
    var entry = player.inventory.filter(function (e) { return e.itemId === itemId; })[0];
    if (entry) {
      entry.qty += qty;
    } else {
      player.inventory.push({ itemId: itemId, qty: qty });
    }
    return player.inventory;
  }

  function removeItem(player, itemId, qty) {
    var idx = -1;
    for (var i = 0; i < player.inventory.length; i++) {
      if (player.inventory[i].itemId === itemId) { idx = i; break; }
    }
    if (idx === -1) { return false; }

    var entry = player.inventory[idx];
    if (entry.qty < qty) { return false; }

    entry.qty -= qty;
    if (entry.qty <= 0) { player.inventory.splice(idx, 1); }
    return true;
  }

  function countItem(player, itemId) {
    var entry = player.inventory.filter(function (e) { return e.itemId === itemId; })[0];
    return entry ? entry.qty : 0;
  }

  function totalWeight(player) {
    return player.inventory.reduce(function (sum, entry) {
      var def = findItemDef(entry.itemId);
      return sum + (def ? def.weight * entry.qty : 0);
    }, 0);
  }

  /* ---------- Действия ---------- */

  function buy(state, locationId, key, qty) {
    qty = qty || 1;
    var item = Bow.data.items[key];
    if (!item) { return { ok: false, message: "Такого товара здесь нет." }; }

    if (itemKeysOf(locationId).indexOf(key) === -1) {
      return { ok: false, message: "В этом месте таким не торгуют." };
    }

    var price = buyPrice(key, state, locationId) * qty;
    if (state.player.money < price) {
      return { ok: false, message: "Не хватает монет: нужно " + price + ", у вас " + state.player.money + "." };
    }

    state.player.money -= price;
    addItem(state.player, item.id, qty);
    state.stats.tradesMade += 1;
    state.stats.actionsTaken += 1;

    Bow.bus.emit("trade:buy", { state: state, key: key, qty: qty, price: price });
    return {
      ok: true,
      message: "Куплено: " + item.name + (qty > 1 ? " ×" + qty : "") + " за " + price + " монет.",
      price: price
    };
  }

  function sell(state, locationId, key, qty) {
    qty = qty || 1;
    var item = Bow.data.items[key];
    if (!item) { return { ok: false, message: "Такого товара нет." }; }

    if (itemKeysOf(locationId).indexOf(key) === -1) {
      return { ok: false, message: "Здесь это не покупают." };
    }

    if (countItem(state.player, item.id) < qty) {
      return { ok: false, message: "У вас нет столько: " + item.name + "." };
    }

    var price = sellPrice(key, state, locationId) * qty;
    removeItem(state.player, item.id, qty);
    state.player.money += price;
    state.stats.tradesMade += 1;
    state.stats.actionsTaken += 1;

    Bow.bus.emit("trade:sell", { state: state, key: key, qty: qty, price: price });
    return { ok: true, message: "Продано: " + item.name + " за " + price + " монет.", price: price };
  }

  Bow.economy = {
    findItemDef: findItemDef,
    keyOf: keyOf,
    buyPrice: buyPrice,
    sellPrice: sellPrice,
    addItem: addItem,
    removeItem: removeItem,
    countItem: countItem,
    totalWeight: totalWeight,
    buy: buy,
    sell: sell
  };

})(typeof window !== "undefined" ? window : this);
