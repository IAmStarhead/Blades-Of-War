:: bow-guard [script]
/* ============================================================
   BOW GUARD — стража, клетка и расплата.

   Зачем: розыск в 0.0.5–0.0.6 был цифрой в панели. Убили торговку —
   и никто не пришёл. По ТЗ последствия должны быть событием,
   а не записью в профиле.

   Как устроено:
     • у стражи свой розыск (org:guard), он растёт от нападений
       и особенно от убийств;
     • перевалил за порог — стража приходит сама, внезапно,
       и предлагает выбор, а не бьёт без слова;
     • сдаться — клетка без драки; откупиться — если денег много;
       бежать — шанс от выживания, при провале изобьют и покалечат;
       оскорбить короля — казнят на месте;
       драться — трое против вас, и это видно заранее;
     • в клетке время идёт, розыск спадает, есть побег и подкуп;
     • увечья остаются навсегда.

   Модуль чистый: не знает ни про SugarCube, ни про DOM.
   ============================================================ */
(function (global) {
  "use strict";

  var Bow = global.Bow = global.Bow || {};

  var GUARD = "org:guard";

  function R() { return Bow.data.fightRules.guard; }
  function clamp(v, a, b) { return Bow.util.clamp(v, a, b); }
  function rnd(rng) { return (rng || Math.random)(); }

  /* ---------- Угроза ---------- */
  function heat(state) {
    return Bow.steal.heatOf(state, GUARD);
  }

  function shouldCome(state) {
    if (!state || state.dead || state.jail) { return false; }
    if (state.fight) { return false; }
    return heat(state) >= R().threshold;
  }

  /* Отряд стражи: имена и умения из данных, каждый — живой человек.
     Они не «мобы из воздуха»: их можно ранить, убить и запомнить. */
  function squad(state) {
    var cfg = R();
    var names = cfg.names || ["Стражник"];
    var units = [];
    for (var i = 0; i < cfg.squad; i++) {
      units.push({
        key: "guard:" + i,
        refId: null,
        side: "enemy",
        name: names[i % names.length],
        npc: true,
        person: false,
        skills: cfg.skills,
        needs: { health: 84, fatigue: 70, hunger: 60, mood: 55 },
        weapon: cfg.gear.weapon,
        armor: cfg.gear.armor,
        money: 10 + i * 4,
        pouch: i === 0 ? ["item:bandage"] : [],
        hp: 84
      });
    }
    return units;
  }

  /* ---------- Приход ----------
     Не «сразу после убийства», а через несколько часов: у стражи
     должно быть время узнать. Игрок получает выбор, а не удар в спину. */
  function schedule(state) {
    if (!shouldCome(state)) { return false; }
    if (state.flags.guardAt !== undefined && state.flags.guardAt !== null) { return false; }
    state.flags.guardAt = state.time.totalHours + R().arriveHours;
    return true;
  }

  /* Вызывается на каждом часу: пора ли. */
  function checkArrival(state) {
    if (state.flags.guardAt === undefined || state.flags.guardAt === null) { return false; }
    if (state.dead || state.jail || state.fight) { return false; }
    if (state.time.totalHours < state.flags.guardAt) { return false; }

    state.flags.guardAt = null;
    if (state.task) { state.task = null; }
    state.guard = {
      phase: "demand",
      arrived: true,
      squad: squad(state),
      fledTo: null,
      heatAt: heat(state)
    };
    Bow.journal.add(state, "На улице появилась стража. Они идут прямо к вам.", "guard");
    return true;
  }

  /* ---------- Варианты ---------- */

  /* Сдаться: без драки, сразу в клетку. */
  /* Стражу видно, только когда она пришла. Раньше сдаться и
     откупиться можно было и в момент, когда десятник ещё спал, —
     то есть одним щелчком закрыть дело, которого ещё нет. */
  function faceToFace(g) {
    return !!(g && g.phase === "demand" && g.arrived);
  }

  function surrender(state) {
    var g = state.guard;
    if (!faceToFace(g)) { return { ok: false, message: "Сейчас некому сдаваться." }; }
    state.guard = null;
    state.flags.guardAt = null;
    toJail(state, "сознался");
    return {
      ok: true,
      message: "Вы поднимаете руки. Вас ведут в клетку — без побоев, но и без пощады."
    };
  }

  /* Откуп: цена растёт вместе с розыском. */
  function bribeCost(state) {
    return Math.round(R().bribeBase + heat(state) * 1.6);
  }

  function bribe(state) {
    var g = state.guard;
    if (!faceToFace(g)) { return { ok: false, message: "Сейчас некому платить." }; }

    var cost = bribeCost(state);
    if (state.player.money < cost) {
      return { ok: false, message: "Столько у вас нет: нужно " + cost + " м." };
    }

    state.player.money -= cost;
    state.guard = null;
    state.flags.guardAt = null;
    Bow.steal.addHeat(state, GUARD, -Math.round(heat(state) * 0.7));
    Bow.work.addReputation(state, GUARD, 5);
    Bow.journal.add(state, "Стражу подкупили за " + cost + " м. Дело закрыли тихо.", "guard");
    return { ok: true, message: "Отдали " + cost + " м. Десятник отводит глаза и уходит." };
  }

  /* Побег: шанс от выживания и увечий. Провал — избиение, возможно,
     навсегда, и всё равно клетка. */
  function fleeChance(state) {
    /* Без стражи рядом бежать не от кого: раньше эта цифра
       показывалась и считалась всегда. */
    if (!faceToFace(state.guard)) { return 0; }
    var base = 0.30 + ((state.player.skills.survival || 0) / 240)
      + ((state.player.skills.stealth || 0) / 400)
      + Bow.fight.injuryPenalty(state.player, "flee");
    if (Bow.time.isNight(state)) { base += 0.10; }
    if (state.player.needs.fatigue < 30) { base -= 0.12; }
    return clamp(base, 0.08, 0.85);
  }

  function flee(state, rng) {
    var g = state.guard;
    if (!g || g.phase !== "demand") { return { ok: false, message: "Сейчас не от кого бежать." }; }

    Bow.time.advance(state, 1);
    Bow.needs.applyChange(state.player, "fatigue", -8);

    if (rnd(rng) < fleeChance(state)) {
      /* Ушли — но не исчезли: розыск остаётся, и каждый переход
         снова даёт шанс, что вас узнают. */
      var places = Object.keys(Bow.data.locations).filter(function (k) {
        return k !== state.player.location;
      });
      var to = places[Math.floor(rnd(rng) * places.length) % places.length];
      state.player.location = to;
      state.guard = null;
      state.flags.guardAt = null;
      /* В розыске каждый переход — новый шанс быть узнанным,
         без порога 60: иначе обещание «каждый переход» ложь. */
      state.flags.hunted = true;
      state.flags.huntedUntil = state.time.totalHours + 72;
      state.flags.huntedHeat = Math.max(heat(state), R().threshold);
      Bow.journal.add(state, "Вы ушли от стражи бегом. Теперь за вами смотрят внимательнее.", "guard");
      return {
        ok: true,
        escaped: true,
        message: "Вы ушли. Теперь каждый переход может стоить свободы."
      };
    }

    /* Поймали: бьют и калечат, но в клетку ведут живым (минимум 5 здор.). */
    var dmg = 12 + Math.round(rnd(rng) * 10);
    state.player.needs.health = Math.max(5, Bow.util.round1(state.player.needs.health - dmg));

    /* Увечье — не гарантия, а шанс. В тесте проверяется заведомо
       провальным броском: 0.99 проходит мимо порога maimChance. */
    var injury = null;
    if (rnd(rng) < Bow.data.fightRules.maimChance) {
      injury = Bow.fight.maim(state.player, rng);
    }

    state.guard = null;
    state.flags.guardAt = null;

    var text = "Вас догнали и били, пока не перестали подниматься.";
    if (injury) { text += " С тех пор " + injury.name + " — навсегда."; }
    Bow.journal.add(state, text, "guard");

    toJail(state, "бежал и попался");

    return {
      ok: true,
      escaped: false,
      injury: injury ? injury.name : null,
      message: text
    };
  }

  /* Оскорбить короля: короткий путь на плаху.
     Это осознанный выбор игрока, а не случайность. */
  function insultKing(state) {
    var g = state.guard;
    if (!g || g.phase !== "demand") { return { ok: false, message: "Сейчас не с кем говорить." }; }

    state.guard = null;
    state.flags.guardAt = null;
    state.dead = {
      cause: "казнь",
      text: "Вы сказали вслух то, что в Хладных Ветрах не говорят даже шёпотом. " +
        "Десятник не стал спорить: он просто кивнул своим.",
      hours: state.time.totalHours
    };
    Bow.journal.add(state, "Казнь за оскорбление короля.", "death");
    return { ok: true, message: "Вас казнили. Игра окончена." };
  }

  /* Драка со стражей. */
  function fight(state) {
    var g = state.guard;
    if (!g || g.phase !== "demand") { return { ok: false, message: "Сейчас не с кем драться." }; }

    var squadUnits = g.squad;
    state.guard = null;
    state.flags.guardAt = null;

    state.fight = {
      personId: null,
      mode: "guard",
      phase: "choose",
      round: 0,
      log: [],
      witnesses: Bow.steal.witnessesAt(state, state.player.location)
        .map(function (p) { return p.id; }),
      /* С кем вы пришли — с тем и стоите. Раньше бой со стражей
         всегда начинался в одиночку, и отряд был бесполезен там,
         где он нужнее всего. */
      allies: Bow.fight.alliesAvailable(state).filter(function (a) {
        return a.willing;
      }).map(function (a) { return a.id; }),
      enemies: [],
      guardSquad: squadUnits,
      units: [],
      heatTotal: 0,
      repTotal: 0
    };

    /* Стража не ждёт, пока игрок нажмёт вторую кнопку: решение
       «драться» уже принято. Иначе промежуточный экран обещает
       выбор, которого нет. */
    return Bow.fight.start(state, "guard");
  }

  /* ---------- Клетка (с живым поминутным отсчётом срока, 0.0.8.1) ---------- */
  var jailPauseTick = false;

  function syncJailMinutes(jail) {
    if (!jail) { return 0; }
    var h = Math.max(0, Number(jail.hoursLeft) || 0);
    if (typeof jail.minutesLeft !== "number" || isNaN(jail.minutesLeft) || jail._syncedHours !== h) {
      jail.minutesLeft = Math.max(0, Math.round(h * 60));
      jail._syncedHours = h;
    }
    return jail.minutesLeft;
  }

  function formatJailLeft(jail) {
    if (!jail) { return "0 мин."; }
    var totalMin = Math.max(0, Math.round(syncJailMinutes(jail)));
    var hrs = Math.floor(totalMin / 60);
    var mins = totalMin % 60;
    if (hrs <= 0) { return mins + " мин."; }
    if (mins === 0) { return hrs + " ч."; }
    return hrs + " ч. " + (mins < 10 ? "0" : "") + mins + " мин.";
  }

  function stepJailMinutes(state, mins) {
    if (!state || !state.jail || jailPauseTick) { return false; }
    var delta = Math.max(0, Math.round(Number(mins) || 0));
    if (!delta) { return false; }

    var curMin = syncJailMinutes(state.jail);
    var nextMin = Math.max(0, curMin - delta);
    state.jail.minutesLeft = nextMin;
    state.jail.hoursLeft = Math.ceil(nextMin / 60);
    state.jail._syncedHours = state.jail.hoursLeft;

    /* В клетке кормят скудной баландой, умереть с голоду не дают; на соломе уходит усталость. */
    if (state.player && state.player.needs) {
      if (state.player.needs.hunger < 35) {
        state.player.needs.hunger = 42;
      }
      Bow.needs.applyChange(state.player, "fatigue", (delta / 60) * 1.6);
      Bow.needs.applyChange(state.player, "mood", -(delta / 60) * 0.45);
    }

    if (nextMin <= 0) {
      release(state);
      if (Bow.ui && Bow.ui.setMessage) {
        Bow.ui.setMessage("Срок вышел. Сторож отпирает засов и выпускает вас из клетки.");
      }
      return true;
    }
    return false;
  }

  function toJail(state, reason) {
    var g = R();
    state.jail = {
      hoursLeft: g.cellsHours,
      minutesLeft: g.cellsHours * 60,
      _syncedHours: g.cellsHours,
      reason: reason || "вина",
      since: state.time.totalHours
    };
    if (state.task) { state.task = null; }
    state.guard = null;
    state.flags.guardAt = null;
    state.flags.hunted = false;
    state.player.location = "square";
    Bow.journal.add(state, "Вас заперли в клетке у частокола. Срок — " + g.cellsHours + " ч.", "guard");
    return state.jail;
  }

  /* Отсидеть: ускоренно перемотать несколько часов (или до конца срока). */
  function serve(state, hours) {
    if (!state.jail) { return { ok: false, message: "Вы не в клетке." }; }
    var curMin = syncJailMinutes(state.jail);
    var wantMin = Math.max(60, Math.round((hours || 4) * 60));
    var passMin = Math.min(wantMin, curMin);

    /* advanceMinutes сам вызовет tick:minute → stepJailMinutes ровно на passMin! */
    Bow.time.advanceMinutes(state, passMin);

    if (!state.jail) {
      return { ok: true, released: true, message: "Срок вышел. Вас выпускают из клетки." };
    }
    return {
      ok: true,
      message: "Прошло " + Math.round(passMin / 60) + " ч. Осталось " + formatJailLeft(state.jail) + "."
    };
  }

  function release(state) {
    state.jail = null;
    Bow.steal.addHeat(state, GUARD, -Math.round(heat(state) * 0.6));
    Bow.work.addReputation(state, GUARD, 8);
    Bow.journal.add(state, "Вас выпустили из клетки.", "guard");
  }

  /* Побег из клетки: труднее, чем с улицы, но возможен. */
  function escapeJail(state, rng) {
    if (!state.jail) { return { ok: false, message: "Вы не в клетке." }; }
    var base = 0.18 + ((state.player.skills.stealth || 0) / 300)
      + ((state.player.skills.survival || 0) / 500)
      + Bow.fight.injuryPenalty(state.player, "flee");
    if (state.time.hour >= 22 || state.time.hour < 5) { base += 0.12; }
    base = clamp(base, 0.05, 0.7);

    jailPauseTick = true;
    try {
      Bow.time.advance(state, 2);
    } finally {
      jailPauseTick = false;
    }

    if (rnd(rng) < base) {
      state.jail = null;
      state.flags.guardAt = null;
      Bow.steal.addHeat(state, GUARD, 15);
      Bow.journal.add(state, "Вы выбрались из клетки и ушли в темноту.", "guard");
      return { ok: true, escaped: true, message: "Засов поддался. Вас ищут злее прежнего." };
    }

    Bow.steal.addHeat(state, GUARD, 5);
    state.player.needs.health = Math.max(5, Bow.util.round1(state.player.needs.health - 6));
    Bow.journal.add(state, "Побег из клетки не удался.", "guard");
    return { ok: true, escaped: false, message: "Вас вернули на место. Теперь следят внимательнее." };
  }

  /* Подкуп в клетке: дешевле, чем на улице, но и денег уже меньше. */
  function bribeJail(state) {
    if (!state.jail) { return { ok: false, message: "Вы не в клетке." }; }
    syncJailMinutes(state.jail);
    var cost = Math.round(R().bribeBase * 0.8 + state.jail.hoursLeft);
    if (state.player.money < cost) {
      return { ok: false, message: "Нужно " + cost + " м., у вас " + state.player.money + "." };
    }
    state.player.money -= cost;
    state.jail = null;
    Bow.steal.addHeat(state, GUARD, -Math.round(heat(state) * 0.5));
    Bow.journal.add(state, "Клетку откупили за " + cost + " м.", "guard");
    return { ok: true, released: true, message: "Сторож отворачивается. Вы уходите." };
  }

  /* ---------- Каждый час, каждая минута (в клетке) и каждый переход ---------- */
  Bow.bus.on("tick:minute", function (state, mins) {
    if (!state || state.dead || !state.jail) { return; }
    stepJailMinutes(state, mins || 1);
  });

  Bow.bus.on("tick:hour", function (state) {
    if (state.dead || state.jail) { return; }
    schedule(state);
    checkArrival(state);
  });

  /* Каждый переход по городу — шанс, что вас узнают. */
  function onMove(state, rng) {
    if (state.dead || state.jail || state.fight || state.guard) { return false; }
    if (!state.flags.hunted) { return false; }
    if (state.flags.huntedUntil && state.time.totalHours > state.flags.huntedUntil) {
      state.flags.hunted = false;
      return false;
    }

    var knownHeat = state.flags.huntedHeat || heat(state);
    var chance = 0.22 + knownHeat / 400;
    if (rnd(rng) >= chance) { return false; }

    /* Узнали на новом месте: стража уже здесь, и ждать больше нечего. */
    state.guard = {
      phase: "demand",
      arrived: true,
      squad: squad(state),
      fledTo: state.player.location,
      heatAt: knownHeat
    };
    Bow.journal.add(state, "На новом месте вас уже ждут: стража узнала.", "guard");
    return true;
  }

  /* Шанс быть узнанным на переходе. Показывается игроку в розыске,
     чтобы «каждый переход может стоить свободы» было цифрой. */
  function huntedChance(state) {
    if (!state.flags.hunted) { return 0; }
    if (state.flags.huntedUntil && state.time.totalHours > state.flags.huntedUntil) { return 0; }
    return clamp(0.22 + (state.flags.huntedHeat || heat(state)) / 400, 0, 0.9);
  }

  Bow.guard = {
    heat: heat,
    huntedChance: huntedChance,
    shouldCome: shouldCome,
    schedule: schedule,
    checkArrival: checkArrival,
    surrender: surrender,
    bribeCost: bribeCost,
    bribe: bribe,
    fleeChance: fleeChance,
    flee: flee,
    insultKing: insultKing,
    fight: fight,
    squad: squad,
    toJail: toJail,
    serve: serve,
    release: release,
    escapeJail: escapeJail,
    bribeJail: bribeJail,
    formatJailLeft: formatJailLeft,
    syncJailMinutes: syncJailMinutes,
    onMove: onMove,
    THRESHOLD: function () { return R().threshold; }
  };

})(typeof window !== "undefined" ? window : this);
