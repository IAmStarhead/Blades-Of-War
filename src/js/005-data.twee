    /* ---------- Начальное состояние игрока ---------- */
    player: {
      id: "person:player",
      name: "Роберт",
      age: 27,
      pron: "m",
      role: "странник",
      status: "free",
      skills: { combat: 15, trade: 20, survival: 25, medicine: 10, leadership: 5, stealth: 10 },
      needs: { health: 85, hunger: 70, fatigue: 60, mood: 65 },
      money: 18,
      inventory: [
        { itemId: "item:bread", qty: 2 },
        { itemId: "item:knife", qty: 1 }
      ]
    },

    /* ---------- Правила потребностей ---------- */
    needsRules: {
      /* Естественное заживление за час: сытый и отдохнувший
         затягивает раны сам. Лечение ускоряет это втрое. */
      healPerHour: 0.4,
      perHour: { hunger: -1.6, fatigue: -1.1, mood: -0.3 },
      hungerLow: 20,
      fatigueLow: 15,
      healthPenalty: { hunger: -1.4, fatigue: -0.6, both: -2.4 },
      moodPenaltyHunger: -0.8,
      rest: { fatigue: 34, health: 4, mood: 6 },
      sleepHours: 7
    },

    /* ---------- Правила боя ----------
       Все числа в одном месте: их видно и можно менять, не трогая код.
       Порог сдачи — не «здоровье 0»: люди в Броде не дерутся насмерть
       без особой причины. */
    fightRules: {
      hours: 1,                  // час на весь бой, а не на каждый удар
      fatiguePerExchange: 3,
      guardFatigue: 2,
      yieldAt: { npc: 18, player: 12 },
      sparMinAttitude: -20,      // ниже — с вами просто не станут бороться
      /* Цена нападения: платится в начале, до исхода. */
      crimeHeat: 26,
      witnessHeat: 6,            // за каждого, кто видел начало
      crimeRep: -14,
      /* Развязка. Прибавка к уже уплаченному за нападение. */
      spareHeat: 10,
      spareRep: -6,
      robHeat: 22,
      robRep: -14,
      killHeat: 60,
      killRep: -45,

      /* ---------- Поле боя (0.0.6.1) ----------
         Простая сетка, как в старых пошаговых играх: каждая фишка
         стоит в своей клетке, ходить в этом прототипе нельзя.
         Позиция — только чтобы бой читался глазами. */
      arena: {
        cols: 7,
        rows: 3,
        spawn: {
          ally:  [[0, 0], [0, 1], [0, 2]],
          enemy: [[6, 0], [6, 1], [6, 2]]
        },
        /* Запасные места, если союзников или врагов больше трёх. */
        extra: { ally: [[1, 0], [1, 1], [1, 2]], enemy: [[5, 0], [5, 1], [5, 2]] },
        stunAt: 8,        // нокаут: фишка ложится, над ней звёздочки
        allySpawns: ["bror", "tarn"]
      },

      /* ---------- Отряд (0.0.6.3) ----------
         Спутник — не «плюс одна фишка». Он решает сам, идти ли,
         держится, пока видит смысл, и уходит, если его бросили
         на растерзание. Всё, что видно в интерфейсе, посчитано здесь. */
      squad: {
        /* С какого отношения человек вообще готов идти за вами. */
        willingAt: 15,
        /* И с каким боевым навыком от него есть польза. */
        minCombat: 30,
        /* Власть: каждый её десяток снижает требуемое отношение. */
        perLead: 6,
        /* Доверие падает, если спутника бьют, а вы не помогаете. */
        failDrop: 14,
        /* И растёт, если бой выигран вместе. */
        winGain: 5,
        /* Раненый спутник не пойдёт: ниже этого здоровья — отказ. */
        minHealth: 45,
        /* Разброс позиции: спутник встаёт рядом, но не вплотную. */
        rowSpread: 1
      },

      /* ---------- Кража (0.0.6.3) ----------
         До этого кража была одна кнопка «срезать кошель» и один бросок.
         Теперь у неё есть подход: приглядеться, отвлечь, взять.
         Каждая ступень тратит время и делает улицу внимательнее. */
      steal: {
        /* Приглядеться: сколько даёт к следующему броску и сколько стоит. */
        studyHours: 1,
        studyBonus: 0.18,
        studyFatigue: 2,
        /* Отвлечь: сбивает внимание, но заметнее и дольше. */
        distractHours: 1,
        distractBonus: 0.14,
        distractFatigue: 4,
        distractWitness: 0.10,
        /* Предел подготовки: больше двух приёмов подряд не помогают. */
        maxPrep: 2,
        /* Сколько берём из кошеля и с какого момента начинают искать. */
        takeMin: 0.35,
        takeMax: 0.75,
        /* Цена провала. */
        caughtHeat: 22,
        caughtRep: -10,
        /* Мелочь из карманов: не кошель, а платок, огниво, грош. */
        pocketChance: 0.5
      },

      /* ---------- Постоянные травмы ----------
         Последствия, которые остаются навсегда: рука, глаз, нога.
         Каждая что-то отнимает — иначе это была бы декорация. */
      injuries: {
        arm: {
          key: "arm", name: "покалеченная рука", short: "рука",
          hit: -0.10, power: 0.08, label: "бьёт слабее и реже попадает"
        },
        eye: {
          key: "eye", name: "выбитый глаз", short: "глаз",
          hit: -0.12, power: 0, label: "хуже видит удар"
        },
        leg: {
          key: "leg", name: "перебитая нога", short: "нога",
          hit: -0.05, power: 0, flee: -0.20, travel: 1.5,
          label: "медленно ходит и плохо бегает"
        },
        ribs: {
          key: "ribs", name: "сросшиеся рёбра", short: "рёбра",
          hit: -0.04, power: 0.08, fatigue: 1.3, label: "быстрее выматывается"
        }
      },
      /* ---------- Куда бить (0.0.6.3) ----------
         Один общий удар без выбора — это не тактика. Каждое место
         стоит по-своему: голова калечит и валит, корпус бьёт больно
         и надёжно, ноги замедляют и сбивают, руки лишают оружия.
         Точность каждого задана здесь, чтобы её правили данными. */
      aim: {
        head: {
          name: "голова", short: "в голову",
          hit: 0.62, hurt: 1.35, maim: 1.8,
          /* down — во сколько раз раньше порога сдачи лежит фишка.
             При stunAt 8 и множителе 3.2 фишка ложится с 25 здор.,
             то есть удар в голову валит раньше, чем человек сдастся. */
          down: 3.2,
          note: "труднее всего попасть, но валит и калечит"
        },
        body: {
          name: "корпус", short: "в корпус",
          hit: 1.00, hurt: 1.00, down: 1.0, maim: 0.7,
          note: "надёжно: попасть проще всего"
        },
        legs: {
          name: "ноги", short: "по ногам",
          hit: 0.86, hurt: 0.72, maim: 0.9, down: 2.6,
          note: "сбивает с ног и мешает уйти"
        },
        arms: {
          name: "руки", short: "по рукам",
          hit: 0.80, hurt: 0.62, down: 0.8, maim: 1.2,
          note: "слабый урон, зато цель роняет оружие"
        }
      },

      /* Шанс покалечить, когда бьют лежачего или добивают. */
      maimChance: 0.25,
      /* С какого урона удар способен оставить след навсегда.
         Порог высокий намеренно: увечье — не каждый второй удар. */
      maimAt: 26,

      /* ---------- Стража ----------
         Порог розыска, при котором за игроком приходят. */
      guard: {
        threshold: 60,
        arriveHours: 2,
        cellsHours: 20,          // срок в клетке
        bribeBase: 40,           // откуп: базовая цена
        fineRep: -25,
        /* Сколько стражников приходит и насколько они крепки.
           Трое — это уже не драка, а избиение: шансы честно видны. */
        squad: 3,
        skills: { combat: 48, survival: 40, leadership: 20 },
        gear: { weapon: "item:axe", armor: "item:padded" },
        names: ["Хаген", "Ульв", "Свейн", "Торд"]
      }
    }
  };

