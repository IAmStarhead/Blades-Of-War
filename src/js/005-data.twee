      bolts:         { id: "item:bolts",         name: "Колчан болтов",  weight: 1.1, slot: "offhand", offhandKind: "quiver", ammoFor: "bolts",  attackBonus: 3, armorPenBonus: 15, base: 19, desc: "Короткие тяжёлые гранёные болты для самострела." }
    },

    /* ---------- Персонажи ----------
       pron: m/f — пол. Текст обращений строится из этого поля.
       appearance — статичное описание наружности (не симуляция).
       dialog — дерево разговора: узлы с текстом и выбором.     */
    people: [
      {
        key: "sigi", id: "person:sigi", name: "Сигрид", age: 46, pron: "f",
        money: 46,
        role: "трактирщица", location: "tavern", org: "org:brod",
        skills: { combat: 8, trade: 52, survival: 30, medicine: 18, leadership: 34, stealth: 12 },
        /* gear — id предметов (item:…), а не ключи товаров:
