:: bow-data [script]
/* ============================================================
   BOW DATA — игровые данные тестового мира.
   Всё содержимое этого файла — ДАННЫЕ, не логика.
   Названия предложены разработчиком как временная тестовая
   локация и меняются правкой этого файла, без правки кода.

   Мир: Королевство Хладных Ветров (авторский канон владельца).
   Тестовая локация: поселение Студёный Брод на торговом тракте.
   ============================================================ */
(function (global) {
  "use strict";

  var Bow = global.Bow = global.Bow || {};

  Bow.data = {

    meta: {
      version: "0.0.2",
      title: "Blades Of War",
      worldName: "Эдем · Королевство Хладных Ветров",
      /* ВНИМАНИЕ: поселение ниже — тестовое, придумано разработчиком
         для прототипа. Не является каноном. Меняется в одном месте. */
      settlementName: "Студёный Брод",
      startLocation: "square"
    },

    /* ---------- Время ---------- */
    calendar: {
      months: ["Стужень", "Ветрень", "Капельник", "Травень", "Ярень", "Косень",
               "Страдень", "Заревень", "Листопад", "Мокрень", "Грудень", "Студень"],
      daysPerMonth: 30,
      seasons: ["Зима", "Весна", "Лето", "Осень"],
      startYear: 1024,
      startMonth: 1,
      startDay: 4,
      startHour: 8
    },

    /* ---------- Организации ---------- */
    orgs: {
      "org:coldwind": {
        id: "org:coldwind",
        name: "Королевство Хладных Ветров",
        type: "kingdom",
        short: "Хладные Ветры",
        ruler: "Норвинг IV",
        desc: "Северное королевство среди стужи и тайги. Здесь не терпят слабость, интриги и коварство.",
        laws: { slavery: "prohibited", heresy: "ignored", violence: "punished" }
      },
      "org:brod": {
        id: "org:brod",
        name: "Община Студёного Брода",
        type: "settlement",
        short: "Брод",
        ruler: "староста Хаген",
        desc: "Небольшое поселение на тракте. Живёт с торговли мехом, солью и перевозок.",
        laws: { slavery: "prohibited", heresy: "ignored", violence: "punished" }
      }
    },

    /* ---------- Локации ---------- */
    locations: {
      square: {
        id: "loc:square",
        name: "Торговая площадь",
        sub: "Студёный Брод",
        travelHours: 0,
        desc: [
          "Площадь вымощена тёсаным камнем, между плитами пробивается ледяная крошка. Ветер гонит по камню солому и обрывки рогожи.",
          "Справа возвышается дощатый навес трактира, слева — торговые лавки. У колодца переминаются двое возчиков, лошади выдыхают пар."
        ],
        trades: ["bread", "salt", "fur", "rope"],
        people: ["sigi", "liva"]
      },
      tavern: {
        id: "loc:tavern",
        name: "Трактир «Хромой олень»",
        sub: "Студёный Брод",
        travelHours: 1,
        desc: [
          "Низкий потолок, тёмные балки, запах дыма и варёной репы. Над очагом висит вырезанный из дерева олень с треснувшим рогом.",
          "За стойкой протирает кружки хозяйка. Пара возчиков играет в кости у окна, негромко и без азарта."
        ],
        trades: ["stew", "ale", "bread"],
        people: ["sigi", "tarn"]
      },
      smithy: {
        id: "loc:smithy",
        name: "Кузница",
        sub: "Студёный Брод",
        travelHours: 1,
        desc: [
          "Жар и грохот. Горн раздут до белого, на наковальне лежит заготовка ножа. Стены увешаны клещами и старыми подковами.",
          "Хозяин работает молча. Он не любит, когда его отвлекают, но цену за работу называет честно."
        ],
        trades: ["knife", "rope", "tool"],
        people: ["tarn"]
      },
      outskirts: {
        id: "loc:outskirts",
        name: "Околица",
        sub: "Студёный Брод",
        travelHours: 2,
        desc: [
          "Здесь кончаются дворы и начинается мокрая земля. Плетни стоят криво, за ними — сараи и поленницы.",
          "Следы на снегу ведут к частоколу, а от него — в тайгу. Кто-то ходил этой дорогой недавно."
        ],
        trades: [],
        people: ["bror"]
      },
      forest: {
        id: "loc:forest",
        name: "Опушка тайги",
        sub: "За околицей",
        travelHours: 3,
        desc: [
          "Тайга дышит сыростью и смолой. Ветки смыкаются над головой, свет пробивается серыми полосами.",
          "Дальше в глубину идти без лыж и без провожатого не стоит: здесь легко обойти круг и не вернуться."
        ],
        trades: [],
        people: ["bror"]
      }
    },

    /* ---------- Товары ---------- */
    items: {
      bread:  { id: "item:bread",  name: "Хлеб",            weight: 0.5, food: 18, base: 3,  desc: "Ржаной, тёмный, чёрствый по краям." },
      stew:   { id: "item:stew",   name: "Похлёбка",        weight: 0.6, food: 34, base: 6,  desc: "Горячая, с репой и мясной закваской." },
      ale:    { id: "item:ale",    name: "Кружка пива",     weight: 0.4, mood: 8,  base: 4,  desc: "Жидкое, но согревает." },
      salt:   { id: "item:salt",   name: "Мешочек соли",    weight: 1.0, base: 9,  desc: "Северная соль, крупная и серая. Ходовой товар." },
      fur:    { id: "item:fur",    name: "Шкура",           weight: 1.6, base: 14, desc: "Выделанная лисья шкура. Тепло и цена." },
      rope:   { id: "item:rope",   name: "Верёвка",         weight: 1.2, base: 5,  desc: "Пеньковая, сажени три." },
      knife:  { id: "item:knife",  name: "Нож",             weight: 0.3, equip: "weapon", attack: 4, base: 15, desc: "Простой кованый нож в деревянных ножнах." },
      tool:   { id: "item:tool",   name: "Инструмент",      weight: 1.8, base: 22, desc: "Клещи и молоток кузнечной работы." }
    },

    /* ---------- Персонажи ---------- */
    /* pron: m — мужской, f — женский. Текст обращений строится из этого поля,
       а не задаётся вручную, поэтому ошибок «она» про мужчину здесь нет. */
    people: [
      {
        key: "sigi", id: "person:sigi", name: "Сигрид", age: 46, pron: "f",
        role: "трактирщица", location: "tavern", org: "org:brod",
        skills: { combat: 8, trade: 52, survival: 30, medicine: 18, leadership: 34 },
        needs: { health: 82, hunger: 68, fatigue: 55, mood: 61 },
        traits: ["практичная", "памятливая", "не любит долги"],
        about: "Держит трактир «Хромой олень» уже девятнадцать лет. Знает, кто в округе чем дышит, и помнит каждую unpaid кружку пива.",
        greet: "Сигрид вытирает руки о полотенце и смотрит на вас без спешки. Она оценивает не человека, а его кошель.",
        lines: [
          "«На севере не спрашивают, откуда ты. Спрашивают, чем заплатишь».",
          "«Возчики говорят, на тракте за Бродом второй раз видели волчьи следы. Только слишком крупные для волка».",
          "«Купишь похлёбку — расскажу, что слышала от солевого обоза»."
        ]
      },
      {
        key: "tarn", id: "person:tarn", name: "Тарн", age: 38, pron: "m",
        role: "кузнец", location: "smithy", org: "org:brod",
        skills: { combat: 44, trade: 26, survival: 35, medicine: 6, leadership: 12 },
        needs: { health: 88, hunger: 62, fatigue: 48, mood: 44 },
        traits: ["молчаливый", "упрямый", "честный в работе"],
        about: "Пришёл в Брод десять лет назад с войны и остался. Кует всё, от гвоздей до наконечников, и не любит разговаривать о прошлом.",
        greet: "Тарн не поднимает глаз от наковальни. Он ждёт, пока вы скажете, зачем пришли.",
        lines: [
          "«Железо не врёт. Люди врут».",
          "«Нож тебе не нужен, если не умеешь им работать. Возьми лучше топор».",
          "«В прошлом месяце кто-то ночью вынес из кузни клещи. Нашёл я их у частокола»."
        ]
      },
      {
        key: "liva", id: "person:liva", name: "Лива", age: 19, pron: "f",
        role: "дочь торговца", location: "square", org: "org:brod",
        skills: { combat: 5, trade: 31, survival: 12, medicine: 14, leadership: 9 },
        needs: { health: 94, hunger: 76, fatigue: 39, mood: 72 },
        traits: ["любопытная", "доверчивая", "хочет уехать на юг"],
        about: "Дочь торговца припасами. Считает, что жизнь в Броде слишком мала для неё, и говорит об этом вслух.",
        greet: "Лива откладывает в сторону связку сушёной рыбы и смотрит на вас с живым интересом.",
        lines: [
          "«Вы ведь не здешний? Расскажите, что за Бродом. Только правду, а не как возчики».",
          "«Отец говорит, на юге города в три раза больше. Я бы уехала, если бы было с кем».",
          "«Сигрид думает, что я ничего не замечаю. А я замечаю»."
        ]
      },
      {
        key: "bror", id: "person:bror", name: "Брор", age: 57, pron: "m",
        role: "охотник", location: "outskirts", org: "org:brod",
        skills: { combat: 41, trade: 15, survival: 64, medicine: 22, leadership: 8 },
        needs: { health: 66, hunger: 58, fatigue: 62, mood: 37 },
        traits: ["нелюдимый", "осторожный", "знает тайгу"],
        about: "Живёт на околице, промышляет охотой. В поселение заходит редко и разговаривает ещё реже.",
        greet: "Брор стоит у поленницы с топором в руке. Он не опускает топор и не отводит взгляда.",
        lines: [
          "«В тайгу без провожатого не ходи. Там три дня — и ты уже не помнишь, откуда шёл».",
          "«Следы за частоколом не мои. Я своих следов не путаю».",
          "«Хочешь шкуру — приноси соль. Соль здесь дороже монеты»."
        ]
      }
    ],

    /* ---------- Начальное состояние игрока ---------- */
    player: {
      id: "person:player",
      name: "Роберт",
      age: 27,
      pron: "m",
      role: "странник",
      status: "free",
      skills: { combat: 15, trade: 20, survival: 25, medicine: 10, leadership: 5 },
      needs: { health: 85, hunger: 70, fatigue: 60, mood: 65 },
      money: 18,
      inventory: [
        { itemId: "item:bread", qty: 2 },
        { itemId: "item:knife", qty: 1 }
      ]
    },

    /* ---------- Правила потребностей ---------- */
    needsRules: {
      perHour: { hunger: -1.6, fatigue: -1.1, mood: -0.3 },
      /* Порог, ниже которого начинаются последствия */
      hungerLow: 20,
      fatigueLow: 15,
      healthPenalty: { hunger: -1.4, fatigue: -0.6, both: -2.4 },
      moodPenaltyHunger: -0.8,
      rest: { fatigue: 34, health: 4, mood: 6 },
      sleepHours: 7
    }
  };

})(typeof window !== "undefined" ? window : this);
