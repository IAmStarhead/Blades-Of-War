          dream: {
            text: "«Я хочу на юг. Там города в три раза больше, и никто не знает, чья ты дочь. Здесь все знают».",
            choices: [
              { text: "Сказать, что это смело", say: "Уехать одному, без денег и имени, — это смело. Глупо, но смело.", close: true, attitude: 2 },
              { text: "Отговорить: дорога опасна", say: "Не надо. Дорога никого не жалеет, а вас — тем более.", close: true, attitude: -1 }
