        gear: { weapon: "item:knife" },
        pouch: ["item:bread"],
        needs: { health: 82, hunger: 68, fatigue: 55, mood: 61 },
        traits: ["практичная", "памятливая", "не любит долгов"],
        about: "Держит трактир «Хромой олень» уже девятнадцать лет. Знает, кто в округе чем дышит, и помнит каждую неоплаченную кружку пива.",
        appearance: {
          height: "среднего роста",
          build: "плотная, с привычкой к тяжёлой работе",
          face: "обветренное лицо, светлые волосы убраны под тёмный платок",
          clothes: "шерстяное платье цвета старого вина, поверх — фартук в муке",
          marks: "на левом предплечье старый ожог от печной заслонки"
        },
        greet: "Сигрид вытирает руки о полотенце и смотрит на вас без спешки. Она оценивает не человека, а его кошель.",
        lines: [
          "«На севере не спрашивают, откуда ты. Спрашивают, чем заплатишь».",
          "«Возчики говорят, на тракте за Бродом второй раз видели волчьи следы. Только слишком крупные для волка».",
          "«Купишь похлёбку — расскажу, что слышала от солевого обоза»."
        ],
        dialog: {
          root: {
            text: "«Сначала скажи, чем заплатишь. Или что принесло тебя в Брод».",
            choices: [
              { text: "Спросить про трактовую дорогу", say: "Что слышно на трактовой дороге? Обозы ходят?", goto: "road", attitude: 1 },
              { text: "Спросить о ней самой", say: "А вы давно здесь? Трактир, кажется, старше половины Брода.", goto: "self", attitude: 2 },
              { text: "Уйти", close: true }
            ]
          },
          road: {
            text: "«Обоз с солью вышел три дня назад и до сих пор не вернулся. Возчики говорят про следы за частоколом. Я говорю: либо волки, либо кто похуже».",
            choices: [
              { text: "Спросить, кто может быть похуже", say: "Похуже волков — это кто? Люди?", goto: "worse", attitude: 1 },
              { text: "Поблагодарить и отойти", say: "Спасибо. Буду знать, куда смотреть.", close: true, attitude: 1 }
            ]
          },
          worse: {
            text: "«Люди. Всегда люди. Волк не станет резать мешки с солью и оставлять их на дороге».",
            choices: [
              { text: "Запомнить это", say: "Значит, не волки. Запомню.", close: true, attitude: 1, journal: "Сигрид считает, что солевой обоз пропал не из-за волков." }
            ]
          },
          self: {
            text: "«Девятнадцать лет держу этот трактир. Мужа забрала лихорадка, сын ушёл на юг и не пишет. Вот и всё, что обо мне нужно знать».",
            choices: [
              { text: "Сказать, что это тяжело", say: "Девятнадцать лет одному. Это тяжело, что бы вы ни говорили.", close: true, attitude: 2 },
              { text: "Спросить, не нужна ли помощь", say: "Может, вам нужна помощь? Я не за тем пришёл, но руки у меня есть.", goto: "help", attitude: 3 }
            ]
          },
          help: {
            text: "«Помощь? Принеси мне весть о солевом обозе. Тогда и поговорим по-человечески».",
            choices: [
              { text: "Согласиться поискать вести", say: "Хорошо. Найду, что случилось с обозом, и вернусь.", close: true, attitude: 3, journal: "Сигрид просит узнать, что случилось с солевым обозом." },
              { text: "Отказаться", say: "Нет. Я не за этим сюда шёл.", close: true, attitude: -1 }
            ]
          }
        }
      },
      {
        key: "tarn", id: "person:tarn", name: "Тарн", age: 38, pron: "m",
        money: 62,
        role: "кузнец", location: "smithy", org: "org:brod",
        skills: { combat: 44, trade: 26, survival: 35, medicine: 6, leadership: 12, stealth: 18 },
