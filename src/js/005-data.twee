        pouch: ["item:iron_ore"],
        needs: { health: 88, hunger: 62, fatigue: 48, mood: 44 },
        traits: ["молчаливый", "упрямый", "честный в работе"],
        about: "Пришёл в Брод десять лет назад с войны и остался. Кует всё, от гвоздей до наконечников, и не любит разговаривать о прошлом.",
        appearance: {
          height: "высокий, под потолок кузницы",
          build: "широкоплечий, с руками тяжелее, чем кажется по виду",
          face: "тёмная борода с проседью, глаза светлые и спокойные",
          clothes: "кожаный фартук, прожжённый в нескольких местах, рубаха без ворота",
          marks: "правая рука в старых ожогах, мизинец и безымянный покалечены"
        },
        greet: "Тарн не поднимает глаз от наковальни. Он ждёт, пока вы скажете, зачем пришли.",
        lines: [
          "«Железо не врёт. Люди врут».",
          "«Нож тебе не нужен, если не умеешь им работать. Возьми лучше топор».",
          "«В прошлом месяце кто-то ночью вынес из кузни клещи. Нашёл я их у частокола»."
        ],
        dialog: {
          root: {
            text: "«Говори быстро. Железо ждать не будет».",
            choices: [
              { text: "Спросить про работу", say: "Работа есть? Я не боюсь ни горна, ни молота.", goto: "work", attitude: 1 },
              { text: "Спросить про войну", say: "Вы воевали. Видно по рукам. Где?", goto: "war", attitude: 1 },
              { text: "Уйти", close: true }
            ]
          },
          work: {
            text: "«Нужны гвозди, подковы, клинки. Платят мало, работы много. Хочешь — приходи, руки всегда нужны».",
            choices: [
              { text: "Спросить, сколько стоит нож", say: "А нож сколько стоит? Тот, что у вас на стене.", goto: "price", attitude: 1 },
              { text: "Уйти", close: true }
            ]
          },
          price: {
            text: "«Пятнадцать монет. Дешевле не отдам — сталь не вода, её не зачерпнёшь».",
            choices: [
