              { text: "Спросить, с кем воевал", say: "С кем воевали-то? Не за пустое место же пальцы отдают.", goto: "war2", attitude: -1 }
            ]
          },
          war2: {
            text: "«С теми же, с кем и все. Север с югом не делит ничего, кроме дорог и кладбищ».",
            choices: [
              { text: "Оставить тему", say: "Ясно. Не моё дело.", close: true }
            ]
          }
        }
      },
