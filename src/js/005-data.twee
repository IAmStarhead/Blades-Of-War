            choices: [
              { text: "Рассказать о дороге", say: "Дорога как дорога. Снег, обозы, обмороженные носы. Никаких чудес.", goto: "road", attitude: 1 },
              { text: "Спросить, чего она сама хочет", say: "А вы сами чего хотите? Не отец, не Брод — вы.", goto: "dream", attitude: 2 },
