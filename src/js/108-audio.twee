  var state = {
    enabled: false,
    volume: 0.45,
    mode: "auto",         // "auto" (по локации: помещение vs улица) | "manual"
    realm: "outdoor",     // "indoor" | "outdoor"
    location: "square",
    mood: "calm",
    trackId: "citadel_of_ford"
  };

  /* Внутренние узлы Web Audio */
  var ctx = null;
  var masterGain = null;
  var indoorBus = null;
  var outdoorBus = null;
  var indoorDry = null;
  var indoorWet = null;
  var outdoorDry = null;
  var outdoorWet = null;
  var pluckCache = {};

  /* Планировщик точного времени Web Audio */
  var schedulerTimer = null;
  var nextSubTime = 0;
  var curBarIdx = 0;
  var curSubIdx = 0;
  var barsPlayedInTrack = 0;

  function midiToFreq(midi) {
    return 440 * Math.pow(2, (midi - 69) / 12);
  }

  function trackById(id) {
    for (var i = 0; i < TRACKS.length; i++) {
      if (TRACKS[i].id === id) { return TRACKS[i]; }
    }
    return TRACKS[0];
  }

  function tracksByRealm(realm) {
    return TRACKS.filter(function (t) { return t.realm === realm; });
  }

  function realmForLocation(locKey) {
    return (locKey === "tavern" || locKey === "smithy") ? "indoor" : "outdoor";
  }

  function preferredTrackForLocation(locKey, isNight) {
    if (locKey === "tavern") { return isNight ? "timber_hall_tale" : "hearth_embers"; }
    if (locKey === "smithy") { return "mead_and_anvil"; }
    if (locKey === "forest") { return "unbroken_tract"; }
    if (locKey === "outskirts") { return isNight ? "rime_and_stars" : "white_silence"; }
    return isNight ? "rime_and_stars" : "citadel_of_ford";
  }

  function loadPrefs() {
    try {
      var raw = global.localStorage && global.localStorage.getItem(STORAGE_KEY);
      if (!raw) { return; }
      var parsed = JSON.parse(raw);
      if (parsed && typeof parsed.volume === "number") {
        state.volume = Math.max(0, Math.min(1, parsed.volume));
      }
      if (parsed && typeof parsed.enabled === "boolean") {
        state.enabled = parsed.enabled;
      }
      if (parsed && (parsed.mode === "auto" || parsed.mode === "manual")) {
        state.mode = parsed.mode;
      }
      if (parsed && typeof parsed.trackId === "string" && trackById(parsed.trackId)) {
        state.trackId = parsed.trackId;
      }
    } catch (e) {}
  }

  function savePrefs() {
    try {
      if (global.localStorage) {
        global.localStorage.setItem(STORAGE_KEY, JSON.stringify({
          enabled: state.enabled,
          volume: state.volume,
          mode: state.mode,
          trackId: state.trackId
        }));
      }
    } catch (e) {}
  }

  function hasWebAudio() {
    return !!(global.AudioContext || global.webkitAudioContext);
  }

  /* ---------- Импульсные отклики свёрточной реверберации ----------
     1) Тёплый бревенчатый зал трактира / кузни (1.45 с, мягкое дерево);
     2) Просторная морозная долина Хладных Ветров (3.6 с, широкая стереопанорама). */
  function buildImpulseResponse(audioCtx, seconds, damping, earlyBoost, seedStart) {
    var rate = audioCtx.sampleRate || 44100;
    var len = Math.floor(rate * seconds);
    var buf = audioCtx.createBuffer(2, len, rate);
    var seed = seedStart || 419283;
    function nextRand() {
      seed = (seed * 1664525 + 1013904223) >>> 0;
      return (seed / 4294967296) * 2 - 1;
    }
    for (var ch = 0; ch < 2; ch++) {
      var d = buf.getChannelData(ch);
      var lp = 0;
      for (var i = 0; i < len; i++) {
        var t = i / len;
        var env = Math.pow(1 - t, 2.55);
        var w = nextRand();
        lp = lp * damping + w * (1 - damping);
        var sample = lp * env * 0.48;
        /* Ранние отражения бревенчатых стен для камерности трактира */
        if (earlyBoost && i > 0 && (i === Math.floor(rate * 0.019) || i === Math.floor(rate * 0.037) || i === Math.floor(rate * 0.061))) {
          sample += (ch === 0 ? 0.22 : -0.19) * earlyBoost;
        }
        d[i] = sample;
      }
    }
    return buf;
  }

  /* ---------- Физическая модель щипковой жильной струны Карплуса — Стронга ----------
     Генерирует реалистичный акустический буфер щипка лютни или арфы
     с точной линейной интерполяцией длины струны и тёплым деревянным затуханием. */
  function getPluckBuffer(midi, kind) {
    if (!ctx) { return null; }
    var key = kind + ":" + midi;
    if (pluckCache[key]) { return pluckCache[key]; }

    var sr = ctx.sampleRate || 44100;
    var freq = midiToFreq(midi);
    var dur = kind === "harp" ? 3.2 : 2.5;
    var total = Math.floor(sr * dur);
    var buf = ctx.createBuffer(1, total, sr);
    var out = buf.getChannelData(0);

    var exactPeriod = sr / freq;
    var N = Math.max(8, Math.floor(exactPeriod));
    var frac = exactPeriod - N;
    var ring = new Float32Array(N + 2);

    /* Начальное возбуждение пальцем по жильной струне (мягкое, без металлического треска) */
    var seed = (midi * 977 + (kind === "harp" ? 31337 : 12345)) >>> 0;
    var smooth = 0;
    var alpha = kind === "harp" ? 0.46 : 0.34;
    for (var i = 0; i < N + 2; i++) {
      seed = (seed * 1664525 + 1013904223) >>> 0;
      var n = (seed / 4294967296) * 2 - 1;
      /* Плавное купольное окно щипка посередине струны */
      var windowShape = Math.sin(Math.PI * Math.min(1, i / N));
      smooth = smooth * (1 - alpha) + n * alpha;
      ring[i] = smooth * (0.65 + 0.35 * windowShape);
    }

    var decay = kind === "harp"
      ? Math.min(0.9978, 0.9925 + (midi - 38) * 0.0001)
      : Math.min(0.9958, 0.9895 + (midi - 38) * 0.00011);
    var brightness = kind === "harp" ? 0.34 : 0.46; // 0.5 = максимальное сглаживание (тёплая жила)

    var idx = 0;
    var prevOut = 0;
    for (var s = 0; s < total; s++) {
      var nextIdx = (idx + 1) % N;
      var nextIdx2 = (idx + 2) % N;
      /* Дробная задержка для безупречного строя на высоких ладах */
      var delayed = ring[idx] * (1 - frac) + ring[nextIdx] * frac;
      var delayedNext = ring[nextIdx] * (1 - frac) + ring[nextIdx2] * frac;
      var filtered = ((1 - brightness) * delayed + brightness * delayedNext) * decay;
      ring[idx] = filtered;
      idx = nextIdx;

      /* Лёгкий резонанс корпуса в первых миллисекундах */
      prevOut = prevOut * 0.14 + delayed * 0.86;
      out[s] = prevOut;
    }

    pluckCache[key] = buf;
    return buf;
  }

  function ensureContext() {
    if (ctx) { return ctx; }
    var Ctor = global.AudioContext || global.webkitAudioContext;
    if (!Ctor) { return null; }
    try {
      ctx = new Ctor();
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.0001;
      masterGain.connect(ctx.destination);

      /* Шина 1: Тёплое помещение (Трактир, Кузница) */
      indoorBus = ctx.createGain();
      indoorBus.gain.value = 1.0;
      indoorDry = ctx.createGain();
      indoorDry.gain.value = 0.72;
      indoorWet = ctx.createGain();
      indoorWet.gain.value = 0.38;
      var inRev = ctx.createConvolver();
      inRev.buffer = buildImpulseResponse(ctx, 1.45, 0.76, 0.8, 108271);
      indoorDry.connect(indoorBus);
      indoorWet.connect(inRev);
      inRev.connect(indoorBus);
      indoorBus.connect(masterGain);

      /* Шина 2: Северный простор (Площадь, Околица, Тайга) */
      outdoorBus = ctx.createGain();
      outdoorBus.gain.value = 1.0;
      outdoorDry = ctx.createGain();
      outdoorDry.gain.value = 0.48;
      outdoorWet = ctx.createGain();
      outdoorWet.gain.value = 0.68;
      var outRev = ctx.createConvolver();
      outRev.buffer = buildImpulseResponse(ctx, 3.55, 0.82, 0.25, 791233);
      outdoorDry.connect(outdoorBus);
      outdoorWet.connect(outRev);
      outRev.connect(outdoorBus);
      outdoorBus.connect(masterGain);
    } catch (e) {
      ctx = null;
    }
    return ctx;
  }

  function routeToRealm(node, realm, panVal) {
    var targetDry = realm === "indoor" ? indoorDry : outdoorDry;
    var targetWet = realm === "indoor" ? indoorWet : outdoorWet;
    if (ctx.createStereoPanner && typeof panVal === "number") {
      var panner = ctx.createStereoPanner();
      panner.pan.value = Math.max(-0.85, Math.min(0.85, panVal));
      node.connect(panner);
      panner.connect(targetDry);
      panner.connect(targetWet);
    } else {
      node.connect(targetDry);
      node.connect(targetWet);
    }
  }

  /* ---------- Инструмент 1: Щипковая лютня / северная арфа ---------- */
  function playPluck(midi, when, gainVal, kind, realm, pan) {
    if (!ctx || midi < 30) { return; }
    var buf = getPluckBuffer(midi, kind || "lute");
    if (!buf) { return; }
    var src = ctx.createBufferSource();
    src.buffer = buf;

    /* Деревянная дека лютни (подъём тёплой середины 235 Гц) */
    var bodyEq = ctx.createBiquadFilter();
    bodyEq.type = "peaking";
    bodyEq.frequency.value = kind === "harp" ? 340 : 235;
    bodyEq.Q.value = 1.1;
    bodyEq.gain.value = kind === "harp" ? 2.5 : 4.2;

    var env = ctx.createGain();
    env.gain.setValueAtTime(0.0001, when);
    env.gain.linearRampToValueAtTime(gainVal, when + 0.006);
    env.gain.exponentialRampToValueAtTime(0.0002, when + (kind === "harp" ? 2.9 : 2.2));

    src.connect(bodyEq);
    bodyEq.connect(env);
    routeToRealm(env, realm, pan || 0);

    src.start(when);
    src.stop(when + (kind === "harp" ? 3.05 : 2.35));
  }

  /* ---------- Инструмент 2: Продольная деревянная флейта с дыханием ---------- */
  function playFlute(midi, when, durSec, gainVal, realm, pan) {
    if (!ctx || midi < 48) { return; }
    var freq = midiToFreq(midi);
    var osc = ctx.createOscillator();
    var subHarm = ctx.createOscillator();
    var vib = ctx.createOscillator();
    var vibGain = ctx.createGain();
    var lp = ctx.createBiquadFilter();
    var env = ctx.createGain();

    osc.type = "triangle";
    osc.frequency.setValueAtTime(freq * 0.997, when);
    osc.frequency.exponentialRampToValueAtTime(freq, when + 0.05);

    subHarm.type = "sine";
    subHarm.frequency.setValueAtTime(freq * 2, when);
    var g2 = ctx.createGain();
    g2.gain.value = 0.14;

    /* Живое вибрато дыхания */
    vib.type = "sine";
    vib.frequency.setValueAtTime(4.7, when);
    vibGain.gain.setValueAtTime(0.0, when);
    vibGain.gain.linearRampToValueAtTime(freq * 0.0065, when + Math.min(0.35, durSec * 0.4));
    vib.connect(vibGain);
    vibGain.connect(osc.frequency);

    lp.type = "lowpass";
    lp.frequency.value = Math.min(1850, freq * 2.7);
    lp.Q.value = 0.8;

    var attack = Math.min(0.11, durSec * 0.28);
    env.gain.setValueAtTime(0.0001, when);
    env.gain.linearRampToValueAtTime(gainVal, when + attack);
    env.gain.setValueAtTime(gainVal * 0.88, when + Math.max(attack + 0.02, durSec * 0.72));
    env.gain.exponentialRampToValueAtTime(0.0002, when + durSec + 0.18);

    osc.connect(lp);
    subHarm.connect(g2);
    g2.connect(lp);
    lp.connect(env);
    routeToRealm(env, realm, pan || 0.12);

    osc.start(when);
    subHarm.start(when);
    vib.start(when);
    osc.stop(when + durSec + 0.22);
    subHarm.stop(when + durSec + 0.22);
    vib.stop(when + durSec + 0.22);
  }

  /* ---------- Инструмент 3: Бархатный ансамбль смычковых (виолончели и виолы) ---------- */
  function playBowedChord(midis, when, durSec, gainPerVoice, realm) {
    if (!ctx || !midis || !midis.length) { return; }
    for (var i = 0; i < midis.length; i++) {
      var m = midis[i];
      if (m < 30) { continue; }
      var freq = midiToFreq(m);
      var oscA = ctx.createOscillator();
      var oscB = ctx.createOscillator();
      var lp = ctx.createBiquadFilter();
      var env = ctx.createGain();

      oscA.type = "sawtooth";
      oscB.type = "sawtooth";
      oscA.frequency.setValueAtTime(freq * 0.9972, when);
      oscB.frequency.setValueAtTime(freq * 1.0028, when);

      /* Мягкий смычковый фильтр (как в Dragonsreach: тёплый спектр ~560–750 Гц без рези) */
      lp.type = "lowpass";
      lp.frequency.setValueAtTime(Math.min(720, freq * 2.6), when);
      lp.frequency.linearRampToValueAtTime(Math.min(920, freq * 3.2), when + durSec * 0.48);
      lp.frequency.linearRampToValueAtTime(Math.min(620, freq * 2.2), when + durSec);
      lp.Q.value = 0.65;

      var att = Math.min(1.15, durSec * 0.36);
      env.gain.setValueAtTime(0.0001, when);
      env.gain.linearRampToValueAtTime(gainPerVoice, when + att);
      env.gain.setValueAtTime(gainPerVoice * 0.9, when + durSec * 0.68);
      env.gain.exponentialRampToValueAtTime(0.0002, when + durSec + 0.65);

      oscA.connect(lp);
      oscB.connect(lp);
      lp.connect(env);
      var pan = ((i / Math.max(1, midis.length - 1)) - 0.5) * 0.7;
      routeToRealm(env, realm, pan);

      oscA.start(when);
      oscB.start(when);
      oscA.stop(when + durSec + 0.72);
      oscB.stop(when + durSec + 0.72);
    }
  }

  /* ---------- Инструмент 4: Северный рог / валторна ---------- */
  function playHorn(midi, when, durSec, gainVal) {
    if (!ctx || midi < 36) { return; }
    var freq = midiToFreq(midi);
    var osc1 = ctx.createOscillator();
    var osc2 = ctx.createOscillator();
    var lp = ctx.createBiquadFilter();
    var env = ctx.createGain();

    osc1.type = "sawtooth";
    osc2.type = "triangle";
    osc1.frequency.setValueAtTime(freq * 0.998, when);
    osc2.frequency.setValueAtTime(freq * 1.002, when);

    lp.type = "lowpass";
    lp.frequency.setValueAtTime(260, when);
    lp.frequency.exponentialRampToValueAtTime(Math.min(820, freq * 3.4), when + durSec * 0.38);
    lp.frequency.exponentialRampToValueAtTime(340, when + durSec + 0.3);
    lp.Q.value = 1.25;

    env.gain.setValueAtTime(0.0001, when);
    env.gain.linearRampToValueAtTime(gainVal, when + Math.min(0.65, durSec * 0.32));
    env.gain.exponentialRampToValueAtTime(0.0002, when + durSec + 0.45);

    osc1.connect(lp);
    osc2.connect(lp);
    lp.connect(env);
    routeToRealm(env, "outdoor", -0.18);

    osc1.start(when);
    osc2.start(when);
    osc1.stop(when + durSec + 0.5);
    osc2.stop(when + durSec + 0.5);
  }

  /* ---------- Инструмент 5: Далёкий северный хор (формантный синтез гласных «А / О») ---------- */
  function playChoir(midi, when, durSec, gainVal) {
    if (!ctx || midi < 48) { return; }
    var freq = midiToFreq(midi);
    var osc1 = ctx.createOscillator();
    var osc2 = ctx.createOscillator();
    var f1 = ctx.createBiquadFilter();
    var f2 = ctx.createBiquadFilter();
    var env = ctx.createGain();

    osc1.type = "sawtooth";
    osc2.type = "sawtooth";
    osc1.frequency.setValueAtTime(freq * 0.996, when);
    osc2.frequency.setValueAtTime(freq * 1.004, when);

    /* Голосовые форманты мягкого хорового «О-А» */
    f1.type = "bandpass";
    f1.frequency.value = 560;
    f1.Q.value = 3.8;

    f2.type = "bandpass";
    f2.frequency.value = 1040;
    f2.Q.value = 4.2;

    env.gain.setValueAtTime(0.0001, when);
    env.gain.linearRampToValueAtTime(gainVal, when + Math.min(1.1, durSec * 0.42));
    env.gain.exponentialRampToValueAtTime(0.0002, when + durSec + 0.8);

    osc1.connect(f1);
    osc2.connect(f1);
    osc1.connect(f2);
    osc2.connect(f2);
    f1.connect(env);
    f2.connect(env);
    routeToRealm(env, "outdoor", 0.22);

    osc1.start(when);
    osc2.start(when);
    osc1.stop(when + durSec + 0.85);
    osc2.stop(when + durSec + 0.85);
  }

  /* ---------- Инструмент 6: Кожаный бубен бодран / походная литавра ---------- */
  function playFrameDrum(when, accent, deepTimpani, realm) {
    if (!ctx) { return; }
    var osc = ctx.createOscillator();
    var env = ctx.createGain();
    osc.type = "sine";

    var startF = deepTimpani ? 86 : (accent ? 116 : 148);
    var endF = deepTimpani ? 43 : (accent ? 56 : 82);
    var dur = deepTimpani ? 0.62 : 0.24;
    var vol = (accent ? 0.085 : 0.042) * (deepTimpani ? 1.15 : 1.0);

    osc.frequency.setValueAtTime(startF, when);
    osc.frequency.exponentialRampToValueAtTime(endF, when + dur * 0.7);

    env.gain.setValueAtTime(0.0001, when);
    env.gain.linearRampToValueAtTime(vol, when + 0.008);
    env.gain.exponentialRampToValueAtTime(0.0002, when + dur);

    osc.connect(env);
    routeToRealm(env, realm, -0.08);

    osc.start(when);
    osc.stop(when + dur + 0.04);
  }

  /* ---------- Озвучивание одного подшага (восьмой длительности) текущей композиции ---------- */
  function scheduleSubStep(track, bar, sub, totalSubs, subDur, when) {
    var realm = track.realm;

    if (realm === "indoor") {
      /* === ТРАКТИР И КУЗНИЦА (в духе Around the Fire) === */
      var chord = bar.chord || [];
      /* На сильную долю — тёплый бас лютни + мягкий аккорд */
      if (sub === 0 && bar.bass > 0) {
        playPluck(bar.bass, when, 0.14, "lute", "indoor", -0.18);
        if (chord[0]) { playPluck(chord[0], when + 0.018, 0.085, "lute", "indoor", -0.06); }
      }
      /* Перебор струн лютни по восьмым долям (живой арпеджиатор 3/4) */
      var arpPattern = track.style === "tavern_lively"
        ? [0, 1, 2, 3, 2, 1]
        : [0, 1, 3, 2, 3, 1];
      var cIdx = arpPattern[sub % arpPattern.length];
      if (sub > 0 && chord[cIdx] !== undefined) {
        var humanJitter = ((sub * 17 + curBarIdx * 7) % 9) * 0.0022;
        playPluck(chord[cIdx], when + humanJitter, sub === 2 || sub === 4 ? 0.085 : 0.065, "lute", "indoor", -0.12 + (sub % 3) * 0.08);
      }

      /* Вторая партия: деревянная флейта (или звонкая арфа в кузнице) ведёт мелодию */
      var mNote = bar.mel && bar.mel[sub];
      if (mNote && mNote > 0) {
        if (track.style === "tavern_lively") {
          playPluck(mNote, when + 0.008, 0.095, "harp", "indoor", 0.22);
          /* Во втором проведении подключается и флейта */
          if (barsPlayedInTrack >= 4) {
            playFlute(mNote, when, subDur * 1.65, 0.036, "indoor", 0.18);
          }
        } else {
          playFlute(mNote, when, subDur * 1.85, 0.046, "indoor", 0.16);
          if (sub === 0) {
            playPluck(mNote + 12, when + 0.02, 0.032, "harp", "indoor", 0.28);
          }
        }
      }

      /* Мягкий кожаный бубен бодран (дум — · — так — так) */
      if (bar.drum === 1 && (sub === 0 || sub === 4)) {
        playFrameDrum(when, sub === 0, false, "indoor");
      } else if (bar.drum === 2 && (sub === 0 || sub === 3 || sub === 4)) {
        playFrameDrum(when, sub === 0, false, "indoor");
      }
      return;
    }

    /* === УЛИЦА, ПЛОЩАДЬ, ОКОЛИЦА И ТАЙГА (Dragonsreach / Frostfall / Tundra / Unbroken Road) === */
    var barDur = subDur * totalSubs;

    if (sub === 0) {
      /* Полный смычковый аккорд на весь такт с глубоким басом */
      var fullStrings = [];
      if (bar.bass > 0) { fullStrings.push(bar.bass); }
      (bar.pad || []).forEach(function (n) { fullStrings.push(n); });
      playBowedChord(fullStrings, when, barDur * 0.98, 0.026, "outdoor");

      /* Благородный северный рог */
      if (bar.horn && bar.horn > 0) {
        playHorn(bar.horn, when + 0.08, barDur * 0.88, 0.034);
      }

      /* Далёкий северный хор с формантами */
      if (bar.choir && bar.choir > 0) {
        playChoir(bar.choir, when + 0.12, barDur * 0.92, 0.032);
      }

      /* Глубокая походная литавра на тракте */
      if (bar.drum === 3) {
        playFrameDrum(when, true, true, "outdoor");
      }
    } else if (bar.drum === 3 && sub === 6) {
      playFrameDrum(when, false, true, "outdoor");
    }

    /* Переливы северной мёрзлой арфы */
    var hNote = bar.harp && bar.harp[sub];
    if (hNote && hNote > 0) {
      var hGain = track.style === "outdoor_frost" ? 0.068 : 0.052;
      playPluck(hNote, when, hGain, "harp", "outdoor", ((sub % 4) - 1.5) * 0.22);
    }

    /* Одинокая высокая мелодия (флейта / хрустальный флажолет) */
    var outMel = bar.mel && bar.mel[sub];
    if (outMel && outMel > 0) {
      if (track.style === "outdoor_frost") {
        playPluck(outMel, when + 0.01, 0.062, "harp", "outdoor", 0.28);
      } else {
        playFlute(outMel, when, subDur * 2.1, 0.038, "outdoor", 0.2);
      }
    }
  }

  /* Автоматическая ротация вариаций внутри текущего пула (помещение / улица),
     чтобы музыка никогда не приедалась одним коротким кольцом. */
  function rotateVariationInRealm() {
    if (state.mode !== "auto") { return; }
    var pool = tracksByRealm(state.realm);
    if (pool.length <= 1) { return; }
    var curIdx = 0;
    for (var i = 0; i < pool.length; i++) {
      if (pool[i].id === state.trackId) { curIdx = i; break; }
    }
    state.trackId = pool[(curIdx + 1) % pool.length].id;
    curBarIdx = 0;
    curSubIdx = 0;
    barsPlayedInTrack = 0;
  }

  function schedulerTick() {
    if (!state.enabled || !ctx) { return; }
    var track = trackById(state.trackId);
    var totalSubs = (track.meter || 3) * (track.subPerBeat || 2);
    var beatSec = 60 / (track.bpm || 72);
    var subDur = beatSec / (track.subPerBeat || 2);

    /* Если вкладка спала — аккуратно подтягиваем указатель времени */
    if (nextSubTime < ctx.currentTime - 0.2) {
      nextSubTime = ctx.currentTime + 0.05;
    }

    while (nextSubTime < ctx.currentTime + 0.36) {
      var bar = track.bars[curBarIdx % track.bars.length];
      scheduleSubStep(track, bar, curSubIdx, totalSubs, subDur, nextSubTime);

      nextSubTime += subDur;
      curSubIdx += 1;
      if (curSubIdx >= totalSubs) {
        curSubIdx = 0;
        curBarIdx += 1;
        barsPlayedInTrack += 1;
        if (curBarIdx >= track.bars.length) {
          curBarIdx = 0;
          /* После двух полных проведений плавно переходим к следующей вариации этого же мира */
          if (barsPlayedInTrack >= track.bars.length * 2) {
            rotateVariationInRealm();
            track = trackById(state.trackId);
          }
        }
      }
    }
  }

  function updateRealmCrossfade() {
    if (!ctx || !indoorBus || !outdoorBus) { return; }
    var now = ctx.currentTime;
    var activeRealm = trackById(state.trackId).realm;
    indoorBus.gain.cancelScheduledValues(now);
    outdoorBus.gain.cancelScheduledValues(now);
    indoorBus.gain.setTargetAtTime(activeRealm === "indoor" ? 1.0 : 0.0001, now, 0.45);
    outdoorBus.gain.setTargetAtTime(activeRealm === "outdoor" ? 1.0 : 0.0001, now, 0.45);
  }

  function applyMasterGain() {
    if (!ctx || !masterGain) { return; }
    var now = ctx.currentTime;
    var target = state.enabled ? Math.max(0.0001, state.volume * 0.95) : 0.0001;
    masterGain.gain.cancelScheduledValues(now);
    masterGain.gain.setValueAtTime(Math.max(0.0001, masterGain.gain.value || 0.0001), now);
    masterGain.gain.linearRampToValueAtTime(target, now + 0.5);
  }

  function startScheduler() {
    if (schedulerTimer) { return; }
    if (!ctx) { return; }
    nextSubTime = ctx.currentTime + 0.06;
    schedulerTick();
    schedulerTimer = global.setInterval(schedulerTick, 160);
  }

  function stopScheduler() {
    if (schedulerTimer) {
      global.clearInterval(schedulerTimer);
      schedulerTimer = null;
    }
  }

  function switchToTrack(trackId, manual) {
    var found = trackById(trackId);
    if (!found) { return null; }
    state.mode = manual ? "manual" : state.mode;
    state.trackId = found.id;
    state.realm = found.realm;
    curBarIdx = 0;
    curSubIdx = 0;
    barsPlayedInTrack = 0;
    savePrefs();
    if (ctx) {
      nextSubTime = ctx.currentTime + 0.08;
      updateRealmCrossfade();
    }
    return found;
  }

  function setAutoMode(gameState) {
    state.mode = "auto";
    if (gameState) {
      syncMood(gameState, true);
    } else {
      var pick = preferredTrackForLocation(state.location || "square", false);
      switchToTrack(pick, false);
    }
    savePrefs();
    return currentTrack();
  }

  function nextTrack() {
    var cur = trackById(state.trackId);
    var idx = 0;
    for (var i = 0; i < TRACKS.length; i++) {
      if (TRACKS[i].id === cur.id) { idx = i; break; }
    }
    var next = TRACKS[(idx + 1) % TRACKS.length];
    return switchToTrack(next.id, true);
  }

  function start() {
    state.enabled = true;
    savePrefs();
    if (!ensureContext()) { return true; }
    if (ctx.state === "suspended" && typeof ctx.resume === "function") {
      ctx.resume();
    }
    updateRealmCrossfade();
    applyMasterGain();
    startScheduler();
    return true;
  }

  function stop() {
    state.enabled = false;
    savePrefs();
    stopScheduler();
    applyMasterGain();
    return false;
  }

  function toggle() {
    return state.enabled ? stop() : start();
  }

  function setVolume(vol) {
    var v = Number(vol);
    if (isNaN(v)) { return state.volume; }
    state.volume = Math.max(0, Math.min(1, v));
    savePrefs();
    applyMasterGain();
    return state.volume;
  }

  /* Автоматическое переключение между музыкой помещений (трактир, кузница)
     и музыкой улицы/тайги при переходах игрока. */
  function syncMood(gameState, forcePick) {
    if (!gameState || !gameState.player) { return; }
    var loc = gameState.player.location || "square";
    var hour = (gameState.time && typeof gameState.time.hour === "number") ? gameState.time.hour : 12;
    var isNight = (hour >= 21 || hour < 6);
    var targetRealm = realmForLocation(loc);

    var locChanged = loc !== state.location;
    var realmChanged = targetRealm !== state.realm;
    state.location = loc;
    state.mood = gameState.fight ? "combat" : (targetRealm === "indoor" ? "tavern" : "calm");

    if (state.mode === "auto" && (forcePick || realmChanged || locChanged)) {
      var nextId = preferredTrackForLocation(loc, isNight);
      state.realm = targetRealm;
      if (nextId !== state.trackId) {
        state.trackId = nextId;
        curBarIdx = 0;
        curSubIdx = 0;
        barsPlayedInTrack = 0;
        if (ctx) {
          nextSubTime = ctx.currentTime + 0.1;
          updateRealmCrossfade();
        }
      }
    }
  }

  function wakeOnGesture() {
    if (!state.enabled) { return; }
    if (!ctx) {
      start();
    } else {
      if (ctx.state === "suspended" && typeof ctx.resume === "function") {
        ctx.resume();
      }
      if (!schedulerTimer) { startScheduler(); }
    }
  }

  function currentTrack() {
    return trackById(state.trackId);
  }

  function listTracks() {
    return TRACKS.map(function (t) {
      return {
        id: t.id,
        title: t.title,
        subtitle: t.subtitle,
        realm: t.realm,
        bpm: t.bpm
      };
    });
  }

  loadPrefs();

  Bow.audio = {
    start: start,
    stop: stop,
    toggle: toggle,
    setVolume: setVolume,
    syncMood: syncMood,
    wakeOnGesture: wakeOnGesture,
    selectTrack: function (id) { return switchToTrack(id, true); },
    setAutoMode: setAutoMode,
    nextTrack: nextTrack,
    currentTrack: currentTrack,
    listTracks: listTracks,
    getMode: function () { return state.mode; },
    getRealm: function () { return trackById(state.trackId).realm; },
    isEnabled: function () { return !!state.enabled; },
    getVolume: function () { return state.volume; },
    isSupported: hasWebAudio
  };

})(typeof window !== "undefined" ? window : this);
