     C3=48, D3=50, E3=52, F3=53, G3=55, G#3=56, A3=57, Bb3=58, B3=59,
     C4=60, D4=62, E4=64, F4=65, F#4=66, G4=67, G#4=68, A4=69, Bb4=70, B4=71,
     C5=72, D5=74, E5=76, F5=77, G5=79, A5=81 */
