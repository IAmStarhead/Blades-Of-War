        { bass: 41, pad: [41, 48, 56], str: [41, 41, 53, 41, 56, 53, 48, 44], brass: [68, -1, 72, -1, 70, -1, 68, -1], highStr: [80, -1, 84, -1, 82, -1, 80, -1], choir: [68, 0, 0, 0, 70, 0, 0, 0],  drum: ["boom", ".", "tom", "boom", "tom", "rim", "boom", "tom"] },
        { bass: 34, pad: [34, 46, 53], str: [34, 34, 46, 34, 50, 46, 43, 41], brass: [70, -1, -1, 74, -1, 72, 70, -1], highStr: [82, -1, -1, 86, -1, 84, 82, -1], choir: [70, 0, 0, 74, 0, 0, 0, 0],  drum: ["boom", ".", "tom", "boom", ".", "tom", "boom", "rim"] },
        { bass: 31, pad: [31, 43, 55], str: [31, 43, 47, 50, 55, 50, 47, 43], brass: [67, -1, 68, 67, -1, 62, 59, -1], highStr: [79, -1, 80, 79, -1, -1, -1, -1], choir: [67, 0, 68, 67, 0, 0, 67, 0], drum: ["boom", "tom", "boom", "tom", "boom", "tom", "boom", "boom"] }
      ]
    },
    {
      id: "blood_and_glory",
      title: "Смерть или слава",
      subtitle: "Вихревая сеча 3/4 (в духе Skyrim Battle 7) · напор струнных, рога Совнгарда и ратный хор",
      realm: "combat",
      bpm: 158,
      meter: 3,
      subPerBeat: 2,   // 6 восьмых в такте
      style: "skyrim_34",
      bars: [
        { bass: 40, pad: [40, 52, 59], str: [40, 40, 52, 40, 47, 52], brass: [64, -1, 67, -1, 71, -1], choir: [64, 0, 0, 0, 71, 0], drum: ["boom", ".", "tom", "tom", "boom", "tom"] },
        { bass: 40, pad: [40, 52, 60], str: [40, 40, 52, 48, 47, 45], brass: [72, -1, 71, -1, 67, -1], choir: [72, 0, 0, 0, 0, 0],  drum: ["boom", ".", "tom", "rim", "boom", "tom"] },
        { bass: 36, pad: [36, 48, 55], str: [36, 36, 48, 36, 43, 48], brass: [67, -1, 69, -1, 72, -1], choir: [67, 0, 0, 0, 72, 0], drum: ["boom", ".", "tom", "tom", "boom", "tom"] },
        { bass: 38, pad: [38, 50, 57], str: [38, 38, 50, 45, 50, 54], brass: [74, -1, 69, -1, 66, -1], choir: [74, 0, 69, 0, 66, 0], drum: ["boom", "tom", "tom", "boom", "tom", "boom"] },
        { bass: 40, pad: [40, 52, 64], str: [52, 40, 52, 55, 59, 55], brass: [76, -1, 74, -1, 71, -1], highStr: [88, -1, 86, -1, 83, -1], choir: [76, 0, 0, 0, 71, 0], drum: ["boom", ".", "tom", "tom", "boom", "tom"] },
        { bass: 36, pad: [36, 48, 60], str: [48, 36, 48, 52, 55, 52], brass: [72, -1, 74, -1, 76, -1], highStr: [84, -1, 86, -1, 88, -1], choir: [72, 0, 0, 0, 76, 0], drum: ["boom", ".", "tom", "rim", "boom", "tom"] },
        { bass: 33, pad: [33, 45, 57], str: [45, 33, 45, 48, 52, 48], brass: [69, -1, 72, -1, 71, -1], highStr: [81, -1, 84, -1, 83, -1], choir: [69, 0, 0, 0, 72, 0], drum: ["boom", ".", "tom", "tom", "boom", "tom"] },
        { bass: 35, pad: [35, 47, 59], str: [35, 47, 51, 54, 59, 47], brass: [71, -1, -1, -1, 63, -1], highStr: [83, -1, -1, -1, 75, -1], choir: [71, 0, 71, 0, 71, 0], drum: ["boom", "tom", "boom", "tom", "boom", "boom"] }
      ]
    }
  ];

  var state = {
    enabled: false,
    volume: 0.45,
    streetBeat: true,     // Мягкий меланхоличный бит в стиле Enigma «Sadeness» на улице
    mode: "auto",         // "auto" | "manual"
    realm: "outdoor",     // "indoor" | "outdoor" | "combat"
    location: "square",
    mood: "calm",
    trackId: "citadel_of_ford",
    preCombatTrackId: null
  };

  /* Внутренние узлы Web Audio */
  var ctx = null;
  var masterGain = null;
  var indoorBus = null;
  var outdoorBus = null;
  var combatBus = null;
  var indoorDry = null;
  var indoorWet = null;
  var outdoorDry = null;
  var outdoorWet = null;
  var combatDry = null;
  var combatWet = null;
  var velvetNoiseBuf = null;
  var velvetNoiseByRate = {};

  /* Предзапекание петель треков через OfflineAudioContext (0.0.9.0):
     вместо сотни живых осцилляторов и 3 тяжёлых ConvolverNode в реальном времени
     браузер один раз в фоне рендерит бесшовную петлю трека (с наложением хвоста
     реверберации на начало такта 0) и крутит её ОДНИМ AudioBufferSourceNode! */
  var BAKE_SAMPLE_RATE = 24000;
  var bakedBuffers = {};
  var bakingPromises = {};
  var activeLoopSource = null;
  var activeLoopGain = null;
  var activeBakedKey = "";
  var autoRotateTimer = null;
  var bakeReqSeq = 0;

  /* Планировщик точного времени Web Audio (резервный режим, если нет OfflineAudioContext) */
  var schedulerTimer = null;
  var nextSubTime = 0;
  var curBarIdx = 0;
  var curSubIdx = 0;
  var barsPlayedInTrack = 0;

  function midiToFreq(midi) {
    return 440 * Math.pow(2, (midi - 69) / 12);
  }

  function trackById(id) {
    for (var i = 0; i < TRACKS.length; i++) {
      if (TRACKS[i].id === id) { return TRACKS[i]; }
    }
    return TRACKS[0];
  }

  function tracksByRealm(realm) {
    return TRACKS.filter(function (t) { return t.realm === realm; });
  }

  function realmForLocation(locKey) {
    return (locKey === "tavern" || locKey === "smithy") ? "indoor" : "outdoor";
  }

  function preferredTrackForLocation(locKey, isNight) {
    if (locKey === "tavern") { return isNight ? "timber_hall_tale" : "hearth_embers"; }
    if (locKey === "smithy") { return "mead_and_anvil"; }
    if (locKey === "forest") { return "unbroken_tract"; }
    if (locKey === "outskirts") { return isNight ? "rime_and_stars" : "white_silence"; }
    return isNight ? "rime_and_stars" : "citadel_of_ford";
  }

  var combatRotSeq = 0;
  function preferredCombatTrack(fightMode) {
    if (fightMode === "guard") { return "steel_on_steel"; }
    if (fightMode === "battle") { return "blood_and_glory"; }
    var picks = ["tooth_and_claw", "steel_on_steel", "blood_and_glory"];
    return picks[(combatRotSeq++) % picks.length];
  }

  function loadPrefs() {
    try {
      var raw = global.localStorage && global.localStorage.getItem(STORAGE_KEY);
      if (!raw) { return; }
      var parsed = JSON.parse(raw);
      if (parsed && typeof parsed.volume === "number") {
        state.volume = Math.max(0, Math.min(1, parsed.volume));
      }
      if (parsed && typeof parsed.enabled === "boolean") {
        state.enabled = parsed.enabled;
      }
      if (parsed && typeof parsed.streetBeat === "boolean") {
        state.streetBeat = parsed.streetBeat;
      }
      if (parsed && (parsed.mode === "auto" || parsed.mode === "manual")) {
        state.mode = parsed.mode;
      }
      if (parsed && typeof parsed.trackId === "string" && trackById(parsed.trackId)) {
        state.trackId = parsed.trackId;
      }
    } catch (e) {}
  }

  function savePrefs() {
    try {
      if (global.localStorage) {
        global.localStorage.setItem(STORAGE_KEY, JSON.stringify({
          enabled: state.enabled,
          volume: state.volume,
          streetBeat: state.streetBeat,
          mode: state.mode,
          trackId: state.trackId
        }));
      }
    } catch (e) {}
  }

  function hasWebAudio() {
    return !!(global.AudioContext || global.webkitAudioContext);
  }

  function hasOfflineAudio() {
    return !!(global.OfflineAudioContext || global.webkitOfflineAudioContext);
  }

  /* Бархатный розовый шум без треска (кэшируется по частоте дискретизации для OfflineAudioContext) */
  function getVelvetNoiseBuffer(audioCtx) {
    var sr = (audioCtx && audioCtx.sampleRate) ? audioCtx.sampleRate : 44100;
    if (velvetNoiseByRate[sr]) { return velvetNoiseByRate[sr]; }
    var len = Math.floor(sr * 1.4);
    var buf = audioCtx.createBuffer(1, len, sr);
    var d = buf.getChannelData(0);
    var seed = 918273;
    var b0 = 0, b1 = 0, b2 = 0;
    for (var i = 0; i < len; i++) {
      seed = (seed * 1664525 + 1013904223) >>> 0;
      var w = (seed / 4294967296) * 2 - 1;
      /* Мягкий фильтр розового шума Келлетта — тёплое дыхание без песка */
      b0 = 0.99765 * b0 + w * 0.0990460;
      b1 = 0.96300 * b1 + w * 0.2965164;
      b2 = 0.57000 * b2 + w * 1.0526913;
      d[i] = (b0 + b1 + b2 + w * 0.1848) * 0.14;
    }
    velvetNoiseByRate[sr] = buf;
    velvetNoiseBuf = buf;
    return buf;
  }

  /* Импульсные отклики свёрточной реверберации */
  function buildImpulseResponse(audioCtx, seconds, damping, earlyBoost, seedStart) {
    var rate = audioCtx.sampleRate || 44100;
    var len = Math.floor(rate * seconds);
    var buf = audioCtx.createBuffer(2, len, rate);
    var seed = seedStart || 419283;
    function nextRand() {
      seed = (seed * 1664525 + 1013904223) >>> 0;
      return (seed / 4294967296) * 2 - 1;
    }
    for (var ch = 0; ch < 2; ch++) {
      var d = buf.getChannelData(ch);
      var lp = 0;
      for (var i = 0; i < len; i++) {
        var t = i / len;
        var env = Math.pow(1 - t, 2.55);
        var w = nextRand();
        lp = lp * damping + w * (1 - damping);
        var sample = lp * env * 0.48;
        if (earlyBoost && i > 0 && (i === Math.floor(rate * 0.019) || i === Math.floor(rate * 0.037) || i === Math.floor(rate * 0.061))) {
          sample += (ch === 0 ? 0.22 : -0.19) * earlyBoost;
        }
        d[i] = sample;
      }
    }
    return buf;
  }

  function ensureContext() {
    if (ctx) { return ctx; }
    var Ctor = global.AudioContext || global.webkitAudioContext;
    if (!Ctor) { return null; }
    try {
      ctx = new Ctor({ latencyHint: "playback" });
      masterGain = ctx.createGain();
      masterGain.gain.value = 0.0001;
      masterGain.connect(ctx.destination);

      var useBaked = hasOfflineAudio();

      /* Шина 1: Тёплое помещение (Трактир, Кузница) */
      indoorBus = ctx.createGain();
      indoorBus.gain.value = 1.0;
      indoorDry = ctx.createGain();
      indoorDry.gain.value = 0.72;
      indoorWet = ctx.createGain();
      indoorWet.gain.value = 0.38;
      indoorDry.connect(indoorBus);
      if (!useBaked) {
        var inRev = ctx.createConvolver();
        inRev.buffer = buildImpulseResponse(ctx, 1.45, 0.76, 0.8, 108271);
        indoorWet.connect(inRev);
        inRev.connect(indoorBus);
      }
      indoorBus.connect(masterGain);

      /* Шина 2: Северный простор + гипнотическое эхо Enigma (Улица, Околица, Тайга) */
      outdoorBus = ctx.createGain();
      outdoorBus.gain.value = 1.0;
      outdoorDry = ctx.createGain();
      outdoorDry.gain.value = 0.50;
      outdoorWet = ctx.createGain();
      outdoorWet.gain.value = 0.70;
      outdoorDry.connect(outdoorBus);
      if (!useBaked) {
        var outRev = ctx.createConvolver();
        outRev.buffer = buildImpulseResponse(ctx, 3.65, 0.83, 0.22, 791233);
        outdoorWet.connect(outRev);
        outRev.connect(outdoorBus);
      }
      outdoorBus.connect(masterGain);

      /* Шина 3: Поле боя (единое тёплое акустическое пространство с остальным саундтреком, 0.0.8.2) */
      combatBus = ctx.createGain();
      combatBus.gain.value = useBaked ? 0.92 : 0.0001;
      combatDry = ctx.createGain();
      combatDry.gain.value = 0.52;
      combatWet = ctx.createGain();
      combatWet.gain.value = 0.64;
      combatDry.connect(combatBus);
      if (!useBaked) {
        var cbRev = ctx.createConvolver();
        cbRev.buffer = buildImpulseResponse(ctx, 3.45, 0.84, 0.42, 553911);
        combatWet.connect(cbRev);
        cbRev.connect(combatBus);
      }
      combatBus.connect(masterGain);
    } catch (e) {
      ctx = null;
    }
    return ctx;
  }

  function routeToRealm(node, realm, panVal) {
    var targetDry = realm === "indoor" ? indoorDry : (realm === "combat" ? combatDry : outdoorDry);
    var targetWet = realm === "indoor" ? indoorWet : (realm === "combat" ? combatWet : outdoorWet);
    if (ctx.createStereoPanner && typeof panVal === "number") {
      var panner = ctx.createStereoPanner();
      panner.pan.value = Math.max(-0.85, Math.min(0.85, panVal));
      node.connect(panner);
      panner.connect(targetDry);
      panner.connect(targetWet);
    } else {
      node.connect(targetDry);
      node.connect(targetWet);
    }
  }

  /* ---------- Инструмент 1: Тёплый камерный аккомпанемент очага (виолы и мягкий бурдон без щипков) ---------- */
  function playHearthPad(bassMidi, chordMidis, when, barDur) {
    if (!ctx) { return; }
    var voices = [];
    if (bassMidi && bassMidi > 0) { voices.push(bassMidi); }
    if (chordMidis && chordMidis.length) {
      for (var k = 0; k < Math.min(3, chordMidis.length); k++) {
        voices.push(chordMidis[k]);
      }
    }
    for (var i = 0; i < voices.length; i++) {
      var m = voices[i];
      if (m < 30) { continue; }
      var freq = midiToFreq(m);
      var isBass = (i === 0 && bassMidi > 0);
      var osc1 = ctx.createOscillator();
      var osc2 = ctx.createOscillator();
      var lp = ctx.createBiquadFilter();
      var env = ctx.createGain();

      osc1.type = "triangle";
      osc2.type = isBass ? "sine" : "sawtooth";
      osc1.frequency.setValueAtTime(freq * 0.9982, when);
      osc2.frequency.setValueAtTime(freq * 1.0018, when);

      var g2 = ctx.createGain();
      g2.gain.value = isBass ? 0.45 : 0.22;

      lp.type = "lowpass";
      lp.frequency.setValueAtTime(Math.min(600, freq * 2.4), when);
      lp.frequency.linearRampToValueAtTime(Math.min(790, freq * 3.0), when + barDur * 0.42);
      lp.frequency.linearRampToValueAtTime(Math.min(520, freq * 2.0), when + barDur);
      lp.Q.value = 0.65;

      var peak = isBass ? 0.046 : 0.025;
      var att = Math.min(0.42, barDur * 0.26);
      env.gain.setValueAtTime(0.0001, when);
      env.gain.linearRampToValueAtTime(peak, when + att);
      env.gain.setValueAtTime(peak * 0.88, when + barDur * 0.7);
      env.gain.exponentialRampToValueAtTime(0.0002, when + barDur + 0.38);

      osc1.connect(lp);
      osc2.connect(g2);
      g2.connect(lp);
      lp.connect(env);
      routeToRealm(env, "indoor", isBass ? -0.1 : ((i - 1.5) * 0.22));

      osc1.start(when);
      osc2.start(when);
      osc1.stop(when + barDur + 0.44);
      osc2.stop(when + barDur + 0.44);
    }
  }

  /* ---------- Инструмент 1б: Певучая сольная виола / виолончель (без удара по струне) ---------- */
  function playSoloViola(midi, when, durSec, gainVal, realm, pan) {
    if (!ctx || midi < 32) { return; }
    var freq = midiToFreq(midi);
    var osc1 = ctx.createOscillator();
    var osc2 = ctx.createOscillator();
    var vib = ctx.createOscillator();
    var vibGain = ctx.createGain();
    var lp = ctx.createBiquadFilter();
    var env = ctx.createGain();

    osc1.type = "sawtooth";
    osc2.type = "triangle";
    osc1.frequency.setValueAtTime(freq * 0.9985, when);
    osc2.frequency.setValueAtTime(freq * 1.0015, when);

    vib.type = "sine";
    vib.frequency.setValueAtTime(4.5, when);
    vibGain.gain.setValueAtTime(0.0, when);
    vibGain.gain.linearRampToValueAtTime(freq * 0.0055, when + Math.min(0.32, durSec * 0.45));
    vib.connect(vibGain);
    vibGain.connect(osc1.frequency);
    vibGain.connect(osc2.frequency);

    lp.type = "lowpass";
    lp.frequency.setValueAtTime(Math.min(760, freq * 2.4), when);
    lp.frequency.linearRampToValueAtTime(Math.min(1040, freq * 3.0), when + durSec * 0.45);
    lp.frequency.linearRampToValueAtTime(Math.min(660, freq * 2.0), when + durSec + 0.15);
    lp.Q.value = 0.85;

    var att = Math.min(0.16, durSec * 0.34);
    env.gain.setValueAtTime(0.0001, when);
    env.gain.linearRampToValueAtTime(gainVal, when + att);
    env.gain.setValueAtTime(gainVal * 0.86, when + Math.max(att + 0.02, durSec * 0.72));
    env.gain.exponentialRampToValueAtTime(0.0002, when + durSec + 0.28);

    osc1.connect(lp);
    osc2.connect(lp);
    lp.connect(env);
    routeToRealm(env, realm || "indoor", pan || -0.16);

    osc1.start(when);
    osc2.start(when);
    vib.start(when);
    osc1.stop(when + durSec + 0.34);
    osc2.stop(when + durSec + 0.34);
    vib.stop(when + durSec + 0.34);
  }

  /* ---------- Инструмент 1в: Плавный северный стеклянный флажолет (без щелчка) ---------- */
  function playFrostHarmonic(midi, when, durSec, gainVal, pan) {
    if (!ctx || midi < 48) { return; }
    var freq = midiToFreq(midi);
    var osc = ctx.createOscillator();
    var over = ctx.createOscillator();
    var overGain = ctx.createGain();
    var env = ctx.createGain();

    osc.type = "sine";
    osc.frequency.setValueAtTime(freq, when);
    over.type = "sine";
    over.frequency.setValueAtTime(freq * 2, when);
    overGain.gain.value = 0.14;

    var att = Math.min(0.24, durSec * 0.36);
    env.gain.setValueAtTime(0.0001, when);
    env.gain.linearRampToValueAtTime(gainVal, when + att);
    env.gain.exponentialRampToValueAtTime(0.0002, when + durSec + 0.95);

    osc.connect(env);
    over.connect(overGain);
    overGain.connect(env);
    routeToRealm(env, "outdoor", pan || 0.24);

    osc.start(when);
    over.start(when);
    osc.stop(when + durSec + 1.0);
    over.stop(when + durSec + 1.0);
  }

  /* ---------- Инструмент 2: Певучая флейта с воздушным скольжением в духе Shakuhachi / Enigma ---------- */
  function playFlute(midi, when, durSec, gainVal, realm, pan) {
    if (!ctx || midi < 48) { return; }
    var freq = midiToFreq(midi);
    var osc = ctx.createOscillator();
    var subHarm = ctx.createOscillator();
    var vib = ctx.createOscillator();
    var vibGain = ctx.createGain();
    var lp = ctx.createBiquadFilter();
    var env = ctx.createGain();

    osc.type = "triangle";
    /* Фирменный мягкий подъезд дыханием снизу (как у шакухати в Sadeness) */
    var glideFrom = realm === "outdoor" ? freq * 0.972 : freq * 0.994;
    osc.frequency.setValueAtTime(glideFrom, when);
    osc.frequency.exponentialRampToValueAtTime(freq, when + (realm === "outdoor" ? 0.11 : 0.05));

    subHarm.type = "sine";
    subHarm.frequency.setValueAtTime(freq * 2, when);
    var g2 = ctx.createGain();
    g2.gain.value = 0.12;

    vib.type = "sine";
    vib.frequency.setValueAtTime(4.8, when);
    vibGain.gain.setValueAtTime(0.0, when);
    vibGain.gain.linearRampToValueAtTime(freq * 0.007, when + Math.min(0.38, durSec * 0.42));
    vib.connect(vibGain);
    vibGain.connect(osc.frequency);

    lp.type = "lowpass";
    lp.frequency.value = Math.min(1650, freq * 2.5);
    lp.Q.value = 0.85;

    var attack = Math.min(0.14, durSec * 0.30);
    env.gain.setValueAtTime(0.0001, when);
    env.gain.linearRampToValueAtTime(gainVal, when + attack);
    env.gain.setValueAtTime(gainVal * 0.88, when + Math.max(attack + 0.02, durSec * 0.72));
    env.gain.exponentialRampToValueAtTime(0.0002, when + durSec + 0.24);

    /* Тихое дыхание трости на входе для живой флейты */
    if (realm === "outdoor") {
      var breathSrc = ctx.createBufferSource();
      breathSrc.buffer = getVelvetNoiseBuffer(ctx);
      var bBp = ctx.createBiquadFilter();
      bBp.type = "bandpass";
      bBp.frequency.value = Math.min(1400, freq * 2.1);
      bBp.Q.value = 2.6;
      var bEnv = ctx.createGain();
      bEnv.gain.setValueAtTime(0.0001, when);
      bEnv.gain.linearRampToValueAtTime(gainVal * 0.28, when + 0.06);
      bEnv.gain.exponentialRampToValueAtTime(0.0001, when + Math.min(0.28, durSec * 0.5));
      breathSrc.connect(bBp);
      bBp.connect(bEnv);
      routeToRealm(bEnv, realm, pan || 0.14);
      breathSrc.start(when);
      breathSrc.stop(when + 0.32);
    }

    osc.connect(lp);
    subHarm.connect(g2);
    g2.connect(lp);
    lp.connect(env);
    routeToRealm(env, realm, pan || 0.12);

    osc.start(when);
    subHarm.start(when);
    vib.start(when);
    osc.stop(when + durSec + 0.28);
    subHarm.stop(when + durSec + 0.28);
    vib.stop(when + durSec + 0.28);
  }

  /* ---------- Инструмент 3: Бархатный ансамбль смычковых (виолончели и виолы) ---------- */
  function playBowedChord(midis, when, durSec, gainPerVoice, realm) {
    if (!ctx || !midis || !midis.length) { return; }
    for (var i = 0; i < midis.length; i++) {
      var m = midis[i];
      if (m < 30) { continue; }
      var freq = midiToFreq(m);
      var oscA = ctx.createOscillator();
      var oscB = ctx.createOscillator();
      var lp = ctx.createBiquadFilter();
      var env = ctx.createGain();

      oscA.type = "sawtooth";
      oscB.type = "sawtooth";
      oscA.frequency.setValueAtTime(freq * 0.9972, when);
      oscB.frequency.setValueAtTime(freq * 1.0028, when);

      var maxCut = realm === "combat" ? 1050 : 860;
      lp.type = "lowpass";
      lp.frequency.setValueAtTime(Math.min(680, freq * 2.5), when);
      lp.frequency.linearRampToValueAtTime(Math.min(maxCut, freq * 3.2), when + durSec * 0.46);
      lp.frequency.linearRampToValueAtTime(Math.min(580, freq * 2.1), when + durSec);
      lp.Q.value = 0.65;

      var att = realm === "combat" ? Math.min(0.22, durSec * 0.24) : Math.min(1.1, durSec * 0.36);
      env.gain.setValueAtTime(0.0001, when);
      env.gain.linearRampToValueAtTime(gainPerVoice, when + att);
      env.gain.setValueAtTime(gainPerVoice * 0.9, when + durSec * 0.68);
      env.gain.exponentialRampToValueAtTime(0.0002, when + durSec + 0.62);

      oscA.connect(lp);
      oscB.connect(lp);
      lp.connect(env);
      var pan = ((i / Math.max(1, midis.length - 1)) - 0.5) * 0.7;
      routeToRealm(env, realm || "outdoor", pan);

      oscA.start(when);
      oscB.start(when);
      oscA.stop(when + durSec + 0.68);
      oscB.stop(when + durSec + 0.68);
    }
  }

  /* ---------- Инструмент 4: Северный рог / боевая медь ---------- */
  function playHorn(midi, when, durSec, gainVal, realm) {
    if (!ctx || midi < 34) { return; }
    var freq = midiToFreq(midi);
    var osc1 = ctx.createOscillator();
    var osc2 = ctx.createOscillator();
    var lp = ctx.createBiquadFilter();
    var env = ctx.createGain();

    osc1.type = "sawtooth";
    osc2.type = "triangle";
    osc1.frequency.setValueAtTime(freq * 0.998, when);
    osc2.frequency.setValueAtTime(freq * 1.002, when);

    var isCombat = realm === "combat";
    lp.type = "lowpass";
    lp.frequency.setValueAtTime(isCombat ? 340 : 250, when);
    lp.frequency.exponentialRampToValueAtTime(Math.min(isCombat ? 1180 : 800, freq * (isCombat ? 4.0 : 3.3)), when + durSec * 0.34);
    lp.frequency.exponentialRampToValueAtTime(320, when + durSec + 0.28);
    lp.Q.value = 1.2;

    var att = isCombat ? Math.min(0.18, durSec * 0.22) : Math.min(0.62, durSec * 0.32);
    env.gain.setValueAtTime(0.0001, when);
    env.gain.linearRampToValueAtTime(gainVal, when + att);
    env.gain.exponentialRampToValueAtTime(0.0002, when + durSec + 0.42);

    osc1.connect(lp);
    osc2.connect(lp);
    lp.connect(env);
    routeToRealm(env, realm || "outdoor", -0.18);

    osc1.start(when);
    osc2.start(when);
    osc1.stop(when + durSec + 0.48);
    osc2.stop(when + durSec + 0.48);
  }

  /* ---------- Инструмент 5: Григорианский / северный хор в квинту (в духе Sadeness и Skyrim) ---------- */
  function playChoir(midi, when, durSec, gainVal, realm) {
    if (!ctx || midi < 43) { return; }
    var notes = realm === "outdoor" ? [midi, midi + 7] : [midi, midi - 12];
    for (var nIdx = 0; nIdx < notes.length; nIdx++) {
      var m = notes[nIdx];
      if (m < 36) { continue; }
      var freq = midiToFreq(m);
      var osc1 = ctx.createOscillator();
      var osc2 = ctx.createOscillator();
      var f1 = ctx.createBiquadFilter();
      var f2 = ctx.createBiquadFilter();
      var env = ctx.createGain();

      osc1.type = "sawtooth";
      osc2.type = "sawtooth";
      osc1.frequency.setValueAtTime(freq * 0.996, when);
      osc2.frequency.setValueAtTime(freq * 1.004, when);

      /* Тёплые хоровые форманты «О — А» (григорианский распев на улице, грозный скандирующий хор в бою) */
      f1.type = "bandpass";
      f1.frequency.value = realm === "combat" ? 640 : 510;
      f1.Q.value = 3.6;

      f2.type = "bandpass";
      f2.frequency.value = realm === "combat" ? 1140 : 960;
      f2.Q.value = 4.0;

      var voiceGain = gainVal * (nIdx === 0 ? 1.0 : 0.58);
      var att = realm === "combat" ? Math.min(0.24, durSec * 0.28) : Math.min(1.05, durSec * 0.42);
      env.gain.setValueAtTime(0.0001, when);
      env.gain.linearRampToValueAtTime(voiceGain, when + att);
      env.gain.exponentialRampToValueAtTime(0.0002, when + durSec + 0.78);

      osc1.connect(f1);
      osc2.connect(f1);
      osc1.connect(f2);
      osc2.connect(f2);
      f1.connect(env);
      f2.connect(env);
      routeToRealm(env, realm || "outdoor", nIdx === 0 ? 0.20 : -0.22);

      osc1.start(when);
      osc2.start(when);
      osc1.stop(when + durSec + 0.85);
      osc2.stop(when + durSec + 0.85);
    }
  }

  /* ---------- Инструмент 6: Мягкий меланхоличный даунтемпо-грув Enigma «Sadeness» ----------
     Никаких резких щелчков или ударов по струнам:
       • Глубокая бархатная саб-бочка с округлым входом 24 мс;
       • Воздушный снейр-выдох (breath-snare) через формантный фильтр в длинный реверб;
       • Едва слышный шёпот бархатного шейкера. */
  function playEnigmaPillowKick(when, accent) {
    if (!ctx) { return; }
    var osc = ctx.createOscillator();
    var lp = ctx.createBiquadFilter();
    var env = ctx.createGain();

    osc.type = "sine";
    osc.frequency.setValueAtTime(accent ? 72 : 64, when);
    osc.frequency.exponentialRampToValueAtTime(36, when + 0.28);

    lp.type = "lowpass";
    lp.frequency.value = 120;

    var peak = accent ? 0.068 : 0.044;
    env.gain.setValueAtTime(0.0001, when);
    /* Округлый 24 мс подъём полностью исключает любой щелчок */
    env.gain.linearRampToValueAtTime(peak, when + 0.024);
    env.gain.exponentialRampToValueAtTime(0.0002, when + 0.42);

    osc.connect(lp);
    lp.connect(env);
    routeToRealm(env, "outdoor", 0);

    osc.start(when);
    osc.stop(when + 0.46);
  }

  function playEnigmaBreathSnare(when, softGhost) {
    if (!ctx) { return; }
    var src = ctx.createBufferSource();
    src.buffer = getVelvetNoiseBuffer(ctx);

    /* Мягкое тёплое тело малого барабана */
    var bodyOsc = ctx.createOscillator();
    bodyOsc.type = "sine";
    bodyOsc.frequency.setValueAtTime(142, when);
    bodyOsc.frequency.exponentialRampToValueAtTime(84, when + 0.18);
    var bodyEnv = ctx.createGain();
    bodyEnv.gain.setValueAtTime(0.0001, when);
    bodyEnv.gain.linearRampToValueAtTime(softGhost ? 0.008 : 0.022, when + 0.022);
    bodyEnv.gain.exponentialRampToValueAtTime(0.0001, when + 0.22);

    /* Воздушный выдох «ха-а» в духе Sadeness без верховой рези */
    var bp = ctx.createBiquadFilter();
    bp.type = "bandpass";
    bp.frequency.value = 580;
    bp.Q.value = 1.15;

    var lp = ctx.createBiquadFilter();
    lp.type = "lowpass";
    lp.frequency.value = 1050;

    var env = ctx.createGain();
    var dur = softGhost ? 0.22 : 0.44;
    var peak = softGhost ? 0.014 : 0.038;
    env.gain.setValueAtTime(0.0001, when);
    env.gain.linearRampToValueAtTime(peak, when + 0.036);
    env.gain.exponentialRampToValueAtTime(0.0002, when + dur);

    src.connect(bp);
    bp.connect(lp);
    lp.connect(env);
    bodyOsc.connect(bodyEnv);
    routeToRealm(env, "outdoor", 0.06);
    routeToRealm(bodyEnv, "outdoor", 0);

    src.start(when);
    bodyOsc.start(when);
    src.stop(when + dur + 0.05);
    bodyOsc.stop(when + 0.25);
  }

  function playVelvetShaker(when, gainVal) {
    if (!ctx) { return; }
    var src = ctx.createBufferSource();
    src.buffer = getVelvetNoiseBuffer(ctx);

    var bp = ctx.createBiquadFilter();
    bp.type = "bandpass";
    bp.frequency.value = 1520;
    bp.Q.value = 1.8;

    var env = ctx.createGain();
    env.gain.setValueAtTime(0.0001, when);
    env.gain.linearRampToValueAtTime(gainVal || 0.011, when + 0.020);
    env.gain.exponentialRampToValueAtTime(0.0001, when + 0.11);

    src.connect(bp);
    bp.connect(env);
    routeToRealm(env, "outdoor", -0.14);

    src.start(when);
    src.stop(when + 0.13);
  }

  /* ---------- Инструмент 7: Кожаный бубен у очага и боевые барабаны Skyrim ---------- */
  function playFrameDrum(when, accent, deepWar, realm) {
    if (!ctx) { return; }
    var osc = ctx.createOscillator();
    var lp = ctx.createBiquadFilter();
    var env = ctx.createGain();
    osc.type = "sine";

    var startF = deepWar ? (accent ? 96 : 118) : (accent ? 98 : 118);
    var endF = deepWar ? (accent ? 41 : 58) : (accent ? 52 : 70);
    var dur = deepWar ? (accent ? 0.48 : 0.30) : 0.28;
    var vol = deepWar ? (accent ? 0.072 : 0.038) : (accent ? 0.040 : 0.020);

    osc.frequency.setValueAtTime(startF, when);
    osc.frequency.exponentialRampToValueAtTime(endF, when + dur * 0.72);

    lp.type = "lowpass";
    lp.frequency.value = deepWar ? 185 : 150;

    env.gain.setValueAtTime(0.0001, when);
    env.gain.linearRampToValueAtTime(vol, when + 0.022);
    env.gain.exponentialRampToValueAtTime(0.0002, when + dur);

    osc.connect(lp);
    lp.connect(env);
    routeToRealm(env, realm || "indoor", -0.06);

    osc.start(when);
    osc.stop(when + dur + 0.05);
  }

  /* ---------- Инструмент 8: Оркестровые боевые партии Skyrim (спиккато струнных, героическая медь, хор Довакина и тайко) ---------- */

  /* 8а. Акустическое маркато / спиккато виолончелей и альтов (тёплая дека без синтезаторной «пилы», 0.0.8.2) */
  function playSpiccatoStrings(midi, when, durSec, accent, highSection) {
    if (!ctx || midi < 28) { return; }
    var voices = highSection ? [midi, midi - 12] : [midi, midi + 12];
    for (var v = 0; v < voices.length; v++) {
      var m = voices[v];
      var freq = midiToFreq(m);
      var osc1 = ctx.createOscillator();
      var osc2 = ctx.createOscillator();
      var osc3 = ctx.createOscillator();
      var gSaw = ctx.createGain();
      var lp = ctx.createBiquadFilter();
      var bodyPeak = ctx.createBiquadFilter();
      var env = ctx.createGain();

      /* Основа — тёплый деревянный треугольник + октавный синус, а смычковый обертон подан мягко (0.22) */
      osc1.type = "triangle";
      osc2.type = "sawtooth";
      osc3.type = "sine";
      osc1.frequency.setValueAtTime(freq * 0.9982, when);
      osc2.frequency.setValueAtTime(freq * 1.0020, when);
      osc3.frequency.setValueAtTime(freq * 2, when);
      gSaw.gain.value = highSection ? 0.18 : 0.24;

      var gHarm = ctx.createGain();
      gHarm.gain.value = 0.16;

      /* Деревянный корпус деки виолончели / виолы */
      bodyPeak.type = "peaking";
      bodyPeak.frequency.value = highSection ? 780 : 410;
      bodyPeak.Q.value = 1.1;
      bodyPeak.gain.value = 2.4;

      /* Тёплый акустический фильтр в том же диапазоне, что и камерные виолы игры */
      lp.type = "lowpass";
      var openF = highSection ? (accent ? 1320 : 1060) : (accent ? 980 : 760);
      var tailF = highSection ? 780 : 520;
      lp.frequency.setValueAtTime(openF, when);
      lp.frequency.exponentialRampToValueAtTime(tailF, when + Math.max(0.10, durSec * 0.85));
      lp.Q.value = 0.72;

      var peak = (highSection ? 0.030 : (v === 0 ? 0.048 : 0.032)) * (accent ? 1.18 : 0.88);
      var att = Math.min(0.038, durSec * 0.25);
      env.gain.setValueAtTime(0.0001, when);
      env.gain.linearRampToValueAtTime(peak, when + att);
      env.gain.exponentialRampToValueAtTime(peak * 0.52, when + Math.max(att + 0.04, durSec * 0.76));
      env.gain.exponentialRampToValueAtTime(0.0002, when + durSec + 0.18);

      osc1.connect(bodyPeak);
      osc2.connect(gSaw);
      gSaw.connect(bodyPeak);
      osc3.connect(gHarm);
      gHarm.connect(bodyPeak);
      bodyPeak.connect(lp);
      lp.connect(env);
      routeToRealm(env, "combat", highSection ? 0.24 : (v === 0 ? -0.20 : 0.14));

      /* Лёгкий шорох канифоли смычка на сильной доле для живой акустики */
      if (accent && v === 0) {
        var bowAir = ctx.createBufferSource();
        bowAir.buffer = getVelvetNoiseBuffer(ctx);
        var bowBp = ctx.createBiquadFilter();
        bowBp.type = "bandpass";
        bowBp.frequency.value = highSection ? 920 : 580;
        bowBp.Q.value = 2.2;
        var bowEnv = ctx.createGain();
        bowEnv.gain.setValueAtTime(0.0001, when);
        bowEnv.gain.linearRampToValueAtTime(peak * 0.22, when + 0.022);
        bowEnv.gain.exponentialRampToValueAtTime(0.0001, when + 0.11);
        bowAir.connect(bowBp);
        bowBp.connect(bowEnv);
        routeToRealm(bowEnv, "combat", -0.14);
        bowAir.start(when);
        bowAir.stop(when + 0.13);
      }

      osc1.start(when);
      osc2.start(when);
      osc3.start(when);
      osc1.stop(when + durSec + 0.22);
      osc2.stop(when + durSec + 0.22);
      osc3.stop(when + durSec + 0.22);
    }
  }

  /* 8б. Северные боевые рога и валторны (глубокий тёплый конический тембр без резкой синтезаторной меди, 0.0.8.2) */
  function playHeroicBrass(midi, when, durSec, gainVal) {
    if (!ctx || midi < 34) { return; }
    var notes = [midi, midi - 12];
    for (var i = 0; i < notes.length; i++) {
      var m = notes[i];
      if (m < 32) { continue; }
      var freq = midiToFreq(m);
      var osc1 = ctx.createOscillator();
      var osc2 = ctx.createOscillator();
      var oscSaw = ctx.createOscillator();
      var gHarm = ctx.createGain();
      var gSaw = ctx.createGain();
      var vib = ctx.createOscillator();
      var vibGain = ctx.createGain();
      var lp = ctx.createBiquadFilter();
      var env = ctx.createGain();

      osc1.type = "triangle";
      osc2.type = "sine";
      oscSaw.type = "sawtooth";
      osc1.frequency.setValueAtTime(freq * 0.991, when);
      osc1.frequency.exponentialRampToValueAtTime(freq * 0.999, when + 0.065);
      osc2.frequency.setValueAtTime(freq * 2, when);
      oscSaw.frequency.setValueAtTime(freq * 1.002, when);

      gHarm.gain.value = 0.28;
      gSaw.gain.value = 0.16;

      vib.type = "sine";
      vib.frequency.setValueAtTime(4.3, when);
      vibGain.gain.setValueAtTime(0.0, when);
      vibGain.gain.linearRampToValueAtTime(freq * 0.0045, when + Math.min(0.35, durSec * 0.5));
      vib.connect(vibGain);
      vibGain.connect(osc1.frequency);

      lp.type = "lowpass";
      lp.frequency.setValueAtTime(Math.min(480, freq * 1.9), when);
      lp.frequency.linearRampToValueAtTime(Math.min(1080, freq * 3.2), when + Math.min(0.18, durSec * 0.38));
      lp.frequency.exponentialRampToValueAtTime(Math.min(640, freq * 2.1), when + durSec + 0.24);
      lp.Q.value = 0.82;

      var vPeak = (i === 0 ? 1.0 : 0.62) * (gainVal || 0.052);
      var att = Math.min(0.065, durSec * 0.28);
      env.gain.setValueAtTime(0.0001, when);
      env.gain.linearRampToValueAtTime(vPeak, when + att);
      env.gain.setValueAtTime(vPeak * 0.86, when + Math.max(att + 0.03, durSec * 0.74));
      env.gain.exponentialRampToValueAtTime(0.0002, when + durSec + 0.34);

      osc1.connect(lp);
      osc2.connect(gHarm);
      gHarm.connect(lp);
      oscSaw.connect(gSaw);
      gSaw.connect(lp);
      lp.connect(env);
      routeToRealm(env, "combat", i === 0 ? -0.14 : 0.20);

      osc1.start(when);
      osc2.start(when);
      oscSaw.start(when);
      vib.start(when);
      osc1.stop(when + durSec + 0.38);
      osc2.stop(when + durSec + 0.38);
      oscSaw.stop(when + durSec + 0.38);
      vib.stop(when + durSec + 0.38);
    }
  }

  /* 8в. Северный мужской ратный хор (мягкий объёмный ансамбль в гулком зале без цифрового звона, 0.0.8.2) */
  function playNordicWarChoir(midi, when, durSec) {
    if (!ctx || midi <= 0) { return; }
    var chord = [midi - 12, midi - 5, midi];
    for (var i = 0; i < chord.length; i++) {
      var m = chord[i];
      if (m < 34) { continue; }
      var freq = midiToFreq(m);
      var osc1 = ctx.createOscillator();
      var osc2 = ctx.createOscillator();
      var g2 = ctx.createGain();
      var f1 = ctx.createBiquadFilter();
      var f2 = ctx.createBiquadFilter();
      var warmLp = ctx.createBiquadFilter();
      var sum = ctx.createGain();
      var env = ctx.createGain();

      osc1.type = "triangle";
      osc2.type = "sawtooth";
      osc1.frequency.setValueAtTime(freq * 0.996, when);
      osc2.frequency.setValueAtTime(freq * 1.004, when);
      g2.gain.value = 0.36;

      /* Глубокая северная мужская гласная «О-У» */
      f1.type = "bandpass";
      f1.frequency.value = 510;
      f1.Q.value = 2.9;

      f2.type = "bandpass";
      f2.frequency.value = 910;
      f2.Q.value = 3.4;

      warmLp.type = "lowpass";
      warmLp.frequency.value = 1280;

      osc1.connect(f1);
      osc2.connect(g2);
      g2.connect(f1);
      osc1.connect(f2);
      g2.connect(f2);
      f1.connect(sum);
      f2.connect(sum);
      sum.connect(warmLp);

      /* Живое дыхание хора в начале слога */
      var breath = ctx.createBufferSource();
      breath.buffer = getVelvetNoiseBuffer(ctx);
      var bBp = ctx.createBiquadFilter();
      bBp.type = "bandpass";
      bBp.frequency.value = 740;
      bBp.Q.value = 2.0;
      var bEnv = ctx.createGain();
      bEnv.gain.setValueAtTime(0.0001, when);
      bEnv.gain.linearRampToValueAtTime(0.014, when + 0.022);
      bEnv.gain.exponentialRampToValueAtTime(0.0001, when + 0.11);
      breath.connect(bBp);
      bBp.connect(bEnv);
      routeToRealm(bEnv, "combat", 0);

      var peak = i === 2 ? 0.064 : 0.050;
      env.gain.setValueAtTime(0.0001, when);
      env.gain.linearRampToValueAtTime(peak, when + 0.045);
      env.gain.setValueAtTime(peak * 0.82, when + Math.max(0.08, durSec * 0.68));
      env.gain.exponentialRampToValueAtTime(0.0002, when + durSec + 0.42);

      warmLp.connect(env);
      routeToRealm(env, "combat", (i - 1) * 0.24);

      breath.start(when);
      breath.stop(when + 0.13);
      osc1.start(when);
      osc2.start(when);
      osc1.stop(when + durSec + 0.46);
      osc2.stop(when + durSec + 0.46);
    }
  }

  /* 8г. Оркестровые боевые литавры, кожаные тайко и удар древком о щит */
  function playSkyrimWarDrum(when, kind, rootMidi) {
    if (!ctx || !kind || kind === ".") { return; }

    if (kind === "rim") {
      /* Удар по окованному краю щита — сухой деревянно-кованный отклик без резкого щелчка */
      var rSrc = ctx.createBufferSource();
      rSrc.buffer = getVelvetNoiseBuffer(ctx);
      var rBp = ctx.createBiquadFilter();
      rBp.type = "bandpass";
      rBp.frequency.value = 590;
      rBp.Q.value = 2.6;
      var rEnv = ctx.createGain();
      rEnv.gain.setValueAtTime(0.0001, when);
      rEnv.gain.linearRampToValueAtTime(0.036, when + 0.010);
      rEnv.gain.exponentialRampToValueAtTime(0.0001, when + 0.12);
      rSrc.connect(rBp);
      rBp.connect(rEnv);
      routeToRealm(rEnv, "combat", 0.18);
      rSrc.start(when);
      rSrc.stop(when + 0.14);
      return;
    }

    var isBoom = (kind === "boom");
    var baseFreq = rootMidi ? midiToFreq(rootMidi) : 73.4;

    /* 1. Котёл литавры / большого северного тайко (читаемый в районе 60–145 Гц на любых динамиках) */
    var osc = ctx.createOscillator();
    var bodyEnv = ctx.createGain();
    osc.type = "triangle";
    osc.frequency.setValueAtTime(isBoom ? 138 : 176, when);
    osc.frequency.exponentialRampToValueAtTime(isBoom ? Math.max(52, baseFreq * 0.75) : 86, when + (isBoom ? 0.24 : 0.15));

    var lp = ctx.createBiquadFilter();
    lp.type = "lowpass";
    lp.frequency.value = isBoom ? 340 : 420;

    var dur = isBoom ? 0.42 : 0.24;
    bodyEnv.gain.setValueAtTime(0.0001, when);
    bodyEnv.gain.linearRampToValueAtTime(isBoom ? 0.088 : 0.048, when + 0.014);
    bodyEnv.gain.exponentialRampToValueAtTime(0.0002, when + dur);

    osc.connect(lp);
    lp.connect(bodyEnv);
    routeToRealm(bodyEnv, "combat", isBoom ? 0 : -0.16);

    /* 2. Удар колотушки по натянутой коже барабана (плотный среднечастотный шлепок 360 Гц) */
    var skin = ctx.createBufferSource();
    skin.buffer = getVelvetNoiseBuffer(ctx);
    var skinBp = ctx.createBiquadFilter();
    skinBp.type = "bandpass";
    skinBp.frequency.value = isBoom ? 340 : 440;
    skinBp.Q.value = 1.35;
    var skinEnv = ctx.createGain();
    skinEnv.gain.setValueAtTime(0.0001, when);
    skinEnv.gain.linearRampToValueAtTime(isBoom ? 0.045 : 0.028, when + 0.011);
    skinEnv.gain.exponentialRampToValueAtTime(0.0001, when + 0.11);

    skin.connect(skinBp);
    skinBp.connect(skinEnv);
    routeToRealm(skinEnv, "combat", isBoom ? 0.04 : 0.16);

    osc.start(when);
    skin.start(when);
    osc.stop(when + dur + 0.04);
    skin.stop(when + 0.13);
  }
  function playBattleIntro() {
    if (!state.enabled || !ensureContext()) { return false; }
    if (ctx.state === "suspended" && typeof ctx.resume === "function") {
      ctx.resume();
    }
    var now = ctx.currentTime + 0.02;

    /* 1. Благородный звон скрещённой стали (три модальных обертона клинка без треска) */
    var bladeFreqs = [612, 1046, 1568];
    for (var i = 0; i < bladeFreqs.length; i++) {
      var bOsc = ctx.createOscillator();
      var bEnv = ctx.createGain();
      bOsc.type = i === 0 ? "triangle" : "sine";
      bOsc.frequency.setValueAtTime(bladeFreqs[i] * 1.015, now);
      bOsc.frequency.exponentialRampToValueAtTime(bladeFreqs[i], now + 0.09);
      var bPeak = [0.055, 0.038, 0.022][i];
      bEnv.gain.setValueAtTime(0.0001, now);
      bEnv.gain.linearRampToValueAtTime(bPeak, now + 0.014);
      bEnv.gain.exponentialRampToValueAtTime(0.0002, now + 0.95);
      bOsc.connect(bEnv);
      routeToRealm(bEnv, "combat", (i - 1) * 0.25);
      bOsc.start(now);
      bOsc.stop(now + 1.0);
    }

    /* 2. Грозный низкий удар литавры и тревожный клич боевого рога */
    playSkyrimWarDrum(now + 0.02, "boom", 38);
    playHeroicBrass(50, now + 0.05, 0.85, 0.058);
    playHeroicBrass(57, now + 0.14, 0.80, 0.048);
    return true;
  }

  /* Фирменный тревожный удар «!» в духе Metal Gear Solid при поимке на взломе (0.0.8.2) */
  function playMgsAlert() {
    if (!ensureContext()) { return false; }
    if (ctx.state === "suspended" && typeof ctx.resume === "function") {
      ctx.resume();
    }
    var now = ctx.currentTime + 0.01;
    /* Стремительный восходящий глиссандо-аккорд (5 голосов) с резким оркестровым акцентом и коротким эхом */
    var startNotes = [587.3, 740.0, 880.0, 1174.7, 1480.0];
    var hitNotes   = [784.0, 987.8, 1244.5, 1568.0, 2093.0];
    for (var i = 0; i < hitNotes.length; i++) {
      var osc = ctx.createOscillator();
      var lp = ctx.createBiquadFilter();
      var env = ctx.createGain();
      osc.type = (i % 2 === 0) ? "sawtooth" : "triangle";
      osc.frequency.setValueAtTime(startNotes[i], now);
      osc.frequency.exponentialRampToValueAtTime(hitNotes[i], now + 0.055);
      lp.type = "lowpass";
      lp.frequency.setValueAtTime(3200, now);
      lp.frequency.exponentialRampToValueAtTime(1400, now + 0.42);
      var pk = 0.048 * (state.volume || 0.55);
      env.gain.setValueAtTime(0.0001, now);
      env.gain.linearRampToValueAtTime(pk, now + 0.018);
      env.gain.setValueAtTime(pk * 0.92, now + 0.09);
      env.gain.exponentialRampToValueAtTime(0.0002, now + 0.48);
      osc.connect(lp);
      lp.connect(env);
      env.connect(ctx.destination);
      osc.start(now);
      osc.stop(now + 0.50);
    }
    return true;
  }

  /* Тактильные звуки железных штифтов, натяжения и открытия засова (0.0.8.2) */
  function playLockSound(kind) {
    if (!state.enabled || !ensureContext()) { return false; }
    if (ctx.state === "suspended") { return false; }
    var now = ctx.currentTime + 0.008;
    var vol = Math.max(0.15, state.volume || 0.5);

    if (kind === "open") {
      var freqs = [310, 468, 720];
      for (var i = 0; i < freqs.length; i++) {
        var o = ctx.createOscillator();
        var g = ctx.createGain();
        o.type = "triangle";
        o.frequency.setValueAtTime(freqs[i], now + i * 0.045);
        g.gain.setValueAtTime(0.0001, now + i * 0.045);
        g.gain.linearRampToValueAtTime(0.045 * vol, now + i * 0.045 + 0.012);
        g.gain.exponentialRampToValueAtTime(0.0001, now + i * 0.045 + 0.22);
        o.connect(g);
        g.connect(ctx.destination);
        o.start(now + i * 0.045);
        o.stop(now + i * 0.045 + 0.24);
      }
      return true;
    }

    var o1 = ctx.createOscillator();
    var g1 = ctx.createGain();
    o1.type = kind === "snap" ? "sawtooth" : "triangle";
    var fStart = kind === "snap" ? 890 : (kind === "scrape" ? 520 : 1180);
    var fEnd   = kind === "snap" ? 240 : (kind === "scrape" ? 390 : 860);
    var dSec   = kind === "snap" ? 0.16 : (kind === "scrape" ? 0.11 : 0.055);
    o1.frequency.setValueAtTime(fStart, now);
    o1.frequency.exponentialRampToValueAtTime(fEnd, now + dSec);
    g1.gain.setValueAtTime(0.0001, now);
    g1.gain.linearRampToValueAtTime((kind === "tick" ? 0.018 : 0.032) * vol, now + 0.008);
    g1.gain.exponentialRampToValueAtTime(0.0001, now + dSec);
    o1.connect(g1);
    g1.connect(ctx.destination);
    o1.start(now);
    o1.stop(now + dSec + 0.02);
    return true;
  }

  /* Тёплый скрип дубовой двери и щелчок щеколды при входе/выходе (0.0.9.1) */
  function playDoorCreak() {
    if (!state.enabled || !ensureContext()) { return false; }
    if (ctx.state === "suspended") { return false; }
    var now = ctx.currentTime + 0.008;
    var vol = Math.max(0.18, state.volume || 0.5);

    /* 1. Щелчок кованой щеколды */
    var latch = ctx.createOscillator();
    var latchGain = ctx.createGain();
    latch.type = "triangle";
    latch.frequency.setValueAtTime(640, now);
    latch.frequency.exponentialRampToValueAtTime(190, now + 0.05);
    latchGain.gain.setValueAtTime(0.0001, now);
    latchGain.gain.linearRampToValueAtTime(0.036 * vol, now + 0.006);
    latchGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.055);
    latch.connect(latchGain);
    latchGain.connect(ctx.destination);
    latch.start(now);
    latch.stop(now + 0.065);

    /* 2. Мягкий деревянный скрип петли */
    var wood = ctx.createOscillator();
    var woodBp = ctx.createBiquadFilter();
    var woodGain = ctx.createGain();
    wood.type = "sawtooth";
    wood.frequency.setValueAtTime(148, now + 0.045);
    wood.frequency.linearRampToValueAtTime(182, now + 0.16);
    wood.frequency.linearRampToValueAtTime(134, now + 0.28);
    woodBp.type = "bandpass";
    woodBp.frequency.setValueAtTime(420, now + 0.045);
    woodBp.Q.value = 3.6;
    woodGain.gain.setValueAtTime(0.0001, now + 0.045);
    woodGain.gain.linearRampToValueAtTime(0.024 * vol, now + 0.11);
    woodGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.30);
    wood.connect(woodBp);
    woodBp.connect(woodGain);
    woodGain.connect(ctx.destination);
    wood.start(now + 0.045);
    wood.stop(now + 0.32);
    return true;
  }

  /* Звон скрещённых клинков при нападении или блоке в живой схватке (0.0.9.1) */
  function playClashSteel(soft) {
    if (!state.enabled || !ensureContext()) { return false; }
    if (ctx.state === "suspended") { return false; }
    var now = ctx.currentTime + 0.006;
    var vol = Math.max(0.16, state.volume || 0.5) * (soft ? 0.52 : 1.0);
    var partials = [1180, 1765, 2640, 3510];
    for (var i = 0; i < partials.length; i++) {
      var o = ctx.createOscillator();
      var g = ctx.createGain();
      o.type = (i % 2 === 0) ? "triangle" : "sine";
      o.frequency.setValueAtTime(partials[i] * (soft ? 0.92 : 1.0), now);
      o.frequency.exponentialRampToValueAtTime(partials[i] * 0.96, now + 0.26);
      g.gain.setValueAtTime(0.0001, now);
      g.gain.linearRampToValueAtTime((0.028 / (i + 1)) * vol, now + 0.008);
      g.gain.exponentialRampToValueAtTime(0.0001, now + (soft ? 0.18 : 0.34));
      o.connect(g);
      g.connect(ctx.destination);
      o.start(now);
      o.stop(now + 0.36);
    }
    return true;
  }

  /* ---------- Озвучивание одного подшага текущей композиции ---------- */
  function scheduleSubStep(track, bar, sub, totalSubs, subDur, when) {
    var realm = track.realm;
    var barDur = subDur * totalSubs;

    /* === 1. ТРАКТИР И КУЗНИЦА (живой ритм бубна, хор у очага и перекличка флейты со смычковыми) === */
    if (realm === "indoor") {
      var chord = bar.chord || [];
      if (sub === 0) {
        playHearthPad(bar.bass, chord, when, barDur * 0.96);
        if (chord.length >= 3) {
          /* Мягкий мужской/камерный хоровой подголосок в квинту у очага (0.0.9.1) */
          playChoir(chord[0], when + 0.04, barDur * 0.90, 0.020, "indoor");
          playChoir(chord[2], when + 0.06, barDur * 0.86, 0.015, "indoor");
        }
      } else if ((sub === 2 || sub === 4) && chord.length >= 2) {
        playSoloViola(chord[sub === 2 ? 1 : 2] || chord[1], when, subDur * 1.9, 0.019, "indoor", sub === 2 ? -0.22 : 0.18);
      }

      var mNote = bar.mel && bar.mel[sub];
      if (mNote && mNote > 0) {
        if (track.style === "tavern_lively") {
          playSoloViola(mNote - 12, when, subDur * 1.85, 0.030, "indoor", -0.18);
          playFlute(mNote, when + 0.012, subDur * 1.72, 0.040, "indoor", 0.18);
        } else if (track.style === "tavern_calm") {
          playFlute(mNote, when, subDur * 2.05, 0.042, "indoor", 0.14);
          if (sub === 0 || sub === 3) {
            playSoloViola(mNote - 12, when + 0.018, subDur * 2.4, 0.024, "indoor", -0.2);
          }
        } else {
          playFlute(mNote, when, subDur * 1.9, 0.045, "indoor", 0.16);
        }
      }

      /* Упругий пульс северного рамочного бубна (боурана) без вялых провалов */
      if (sub === 0) {
        playFrameDrum(when, true, false, "indoor");
      } else if (sub === 3 || (bar.drum >= 1 && sub === 4)) {
        playFrameDrum(when, false, sub === 3, "indoor");
      } else if (bar.drum === 2 && sub === 2) {
        playVelvetShaker(when, 0.009);
      }
      return;
    }

    /* === 2. БОЕВАЯ ОРКЕСТРОВАЯ СЮИТА В ДУХЕ SKYRIM (Клык и сталь / Сталь о сталь / Смерть или слава) === */
    if (realm === "combat") {
      if (sub === 0) {
        var bedNotes = [];
        if (bar.bass && bar.bass > 0) { bedNotes.push(bar.bass); }
        (bar.pad || []).forEach(function (n) { bedNotes.push(n); });
        if (bedNotes.length) {
          playBowedChord(bedNotes, when, barDur * 0.98, 0.030, "combat");
        }
      }

      /* 1. Упругий спиккато-пульс виолончелей и альтов на каждую восьмую */
      var strNote = bar.str && bar.str[sub];
      if (strNote && strNote > 0) {
        var isStrongBeat = (sub === 0) || (track.style === "skyrim_68" && sub === 3) || (track.style === "skyrim_44" && sub === 4);
        playSpiccatoStrings(strNote, when, subDur * 0.88, isStrongBeat, false);
      }

      /* 2. Контрмелодия высоких скрипок в кульминации */
      var hiNote = bar.highStr && bar.highStr[sub];
      if (hiNote && hiNote > 0) {
        playSpiccatoStrings(hiNote, when, subDur * 1.65, sub === 0 || sub === 3, true);
      }

      /* 3. Героическая мелодия валторн и тромбонов */
      var brNote = bar.brass && bar.brass[sub];
      if (brNote && brNote > 0) {
        /* Считаем длительность до следующей ноты меди, чтобы фанфара пела слитно и мощно */
        var holdSubs = 1;
        for (var look = sub + 1; look < totalSubs; look++) {
          if (bar.brass[look] && bar.brass[look] > 0) { break; }
          holdSubs++;
        }
        playHeroicBrass(brNote, when, subDur * holdSubs * 0.94, 0.046);
        if (holdSubs >= 2) {
          playHorn(brNote, when + 0.02, subDur * holdSubs * 0.90, 0.028, "combat");
        }
      }

      /* 4. Ратные выкрики северного мужского хора («ХУ! / ХА! / ДО-РА!») */
      /* 4. Многоголосный ратный северный хор в квинту и октаву (0.0.9.1) */
      var chNote = bar.choir && bar.choir[sub];
      if (chNote && chNote > 0) {
        playNordicWarChoir(chNote, when, subDur * 2.05);
        playNordicWarChoir(chNote - 12, when + 0.015, subDur * 1.95);
        playChoir(chNote, when + 0.025, subDur * 1.95, 0.030, "combat");
        playChoir(chNote + 7, when + 0.035, subDur * 1.85, 0.022, "combat");
      } else if (sub === 0 && bar.bass && bar.bass > 0) {
        /* Басовая опора мужского хора на сильную долю каждого такта сечи */
        playChoir(bar.bass + 24, when + 0.02, subDur * 2.4, 0.022, "combat");
      }

      /* 5. Боевые литавры, кожаные тайко и удары о щит */
      var drKind = bar.drum && bar.drum[sub];
      if (drKind && drKind !== ".") {
        playSkyrimWarDrum(when, drKind, bar.bass);
      }
      return;
    }

    /* === 3. УЛИЦА И СЕВЕРНЫЕ ПРОСТОРЫ (драйвовый шагающий грув Enigma + трёхголосный северный хор) === */
    if (sub === 0) {
      var fullStrings = [];
      if (bar.bass > 0) { fullStrings.push(bar.bass); }
      (bar.pad || []).forEach(function (n) { fullStrings.push(n); });
      playBowedChord(fullStrings, when, barDur * 0.98, 0.026, "outdoor");

      if (bar.horn && bar.horn > 0) {
        playHorn(bar.horn, when + 0.06, barDur * 0.88, 0.034, "outdoor");
      }

      var chRoot = (bar.choir && bar.choir > 0) ? bar.choir : ((bar.pad && bar.pad[1]) || 0);
      if (chRoot > 0) {
        playChoir(chRoot, when + 0.06, barDur * 0.94, 0.038, "outdoor");
        playChoir(chRoot + 7, when + 0.10, barDur * 0.90, 0.026, "outdoor");
        playChoir(chRoot - 12, when + 0.08, barDur * 0.92, 0.022, "outdoor");
      }
    } else if (sub === 4 && bar.choir && bar.choir > 0) {
      /* Ответный верхний голос хора во второй половине такта */
      playChoir(bar.choir + 12, when + 0.04, subDur * 3.6, 0.022, "outdoor");
    }

    if (state.streetBeat && totalSubs === 8) {
      if (sub === 0) {
        playEnigmaPillowKick(when, true);
      } else if (sub === 3) {
        playEnigmaPillowKick(when + subDur * 0.48, false);
      } else if (sub === 4) {
        playEnigmaPillowKick(when, false);
      } else if (sub === 5 && track.style !== "outdoor_tundra") {
        playEnigmaPillowKick(when, false);
      }

      if (sub === 2 || sub === 6) {
        playEnigmaBreathSnare(when, false);
      } else if (sub === 7) {
        playEnigmaBreathSnare(when + subDur * 0.48, true);
      }

      playVelvetShaker(when, (sub % 2 === 1) ? 0.014 : 0.007);
    }

    /* Певучая мелодия улицы (шакухати-флейта с дыханием или мягкий стеклянный флажолет) */
    var outMel = bar.mel && bar.mel[sub];
    if (outMel && outMel > 0) {
      if (track.style === "outdoor_frost") {
        playFrostHarmonic(outMel, when, subDur * 2.4, 0.034, 0.24);
      } else {
        playFlute(outMel, when, subDur * 2.25, 0.040, "outdoor", 0.18);
      }
    }
  }

  function rotateVariationInRealm() {
    if (state.mode !== "auto") { return; }
    var pool = tracksByRealm(state.realm);
    if (pool.length <= 1) { return; }
    var curIdx = 0;
    for (var i = 0; i < pool.length; i++) {
      if (pool[i].id === state.trackId) { curIdx = i; break; }
    }
    state.trackId = pool[(curIdx + 1) % pool.length].id;
    curBarIdx = 0;
    curSubIdx = 0;
    barsPlayedInTrack = 0;
  }

  function schedulerTick() {
    if (!state.enabled || !ctx) { return; }
    var track = trackById(state.trackId);
    var totalSubs = (track.meter || 4) * (track.subPerBeat || 2);
    var beatSec = 60 / (track.bpm || 80);
    var subDur = beatSec / (track.subPerBeat || 2);

    if (nextSubTime < ctx.currentTime - 0.2) {
      nextSubTime = ctx.currentTime + 0.05;
    }

    while (nextSubTime < ctx.currentTime + 0.36) {
      var bar = track.bars[curBarIdx % track.bars.length];
      scheduleSubStep(track, bar, curSubIdx, totalSubs, subDur, nextSubTime);

      nextSubTime += subDur;
      curSubIdx += 1;
      if (curSubIdx >= totalSubs) {
        curSubIdx = 0;
        curBarIdx += 1;
        barsPlayedInTrack += 1;
        if (curBarIdx >= track.bars.length) {
          curBarIdx = 0;
          if (barsPlayedInTrack >= track.bars.length * 2) {
            rotateVariationInRealm();
            track = trackById(state.trackId);
          }
        }
      }
    }
  }

  function updateRealmCrossfade() {
    if (!ctx || !indoorBus || !outdoorBus || !combatBus) { return; }
    var now = ctx.currentTime;
    var activeRealm = trackById(state.trackId).realm;
    indoorBus.gain.cancelScheduledValues(now);
    outdoorBus.gain.cancelScheduledValues(now);
    combatBus.gain.cancelScheduledValues(now);
    indoorBus.gain.setTargetAtTime(activeRealm === "indoor" ? 1.0 : 0.0001, now, 0.38);
    outdoorBus.gain.setTargetAtTime(activeRealm === "outdoor" ? 1.0 : 0.0001, now, 0.38);
    combatBus.gain.setTargetAtTime(activeRealm === "combat" ? 1.0 : 0.0001, now, 0.28);
  }

  function applyMasterGain() {
    if (!ctx || !masterGain) { return; }
    var now = ctx.currentTime;
    var target = state.enabled ? Math.max(0.0001, state.volume * 0.95) : 0.0001;
    masterGain.gain.cancelScheduledValues(now);
    masterGain.gain.setValueAtTime(Math.max(0.0001, masterGain.gain.value || 0.0001), now);
    masterGain.gain.linearRampToValueAtTime(target, now + 0.45);
  }

  function trackBakeKey(track) {
    if (!track) { return ""; }
    var beatSuffix = (track.realm === "outdoor") ? (state.streetBeat ? ":b1" : ":b0") : "";
    return track.id + beatSuffix;
  }

  function trackLoopDuration(track) {
    var totalSubs = (track.meter || 4) * (track.subPerBeat || 2);
    var beatSec = 60 / (track.bpm || 80);
    var subDur = beatSec / (track.subPerBeat || 2);
    return (track.bars ? track.bars.length : 4) * totalSubs * subDur;
  }

  /* Фоновое запекание бесшовной петли трека через OfflineAudioContext:
     рендерим (loopDur + tailDur) секунд с настоящим ревербератором зала,
     а затем складываем хвост [loopDur .. loopDur+tailDur] в начало [0 .. tailDur].
     В итоге loop = true звучит абсолютно бесшовно и тратит < 1% CPU! */
  function bakeTrackAsync(trackId) {
    var track = trackById(trackId);
    if (!track || !hasOfflineAudio() || !ensureContext()) {
      return Promise.resolve(null);
    }
    var key = trackBakeKey(track);
    if (bakedBuffers[key]) {
      return Promise.resolve(bakedBuffers[key]);
    }
    if (bakingPromises[key]) {
      return bakingPromises[key];
    }

    var OfflineCtor = global.OfflineAudioContext || global.webkitOfflineAudioContext;
    var totalSubs = (track.meter || 4) * (track.subPerBeat || 2);
    var beatSec = 60 / (track.bpm || 80);
    var subDur = beatSec / (track.subPerBeat || 2);
    var barCount = track.bars.length;
    var loopDur = barCount * totalSubs * subDur;
    var tailDur = track.realm === "indoor" ? 1.85 : (track.realm === "combat" ? 3.55 : 3.75);
    var sr = BAKE_SAMPLE_RATE;
    var loopFrames = Math.max(1, Math.round(loopDur * sr));
    var tailFrames = Math.max(1, Math.round(tailDur * sr));
    var totalFrames = loopFrames + tailFrames;

    var offCtx;
    try {
      offCtx = new OfflineCtor(2, totalFrames, sr);
    } catch (err) {
      return Promise.resolve(null);
    }

    /* Строим в оффлайн-контексте ровно ту пространственную шину, которая нужна этому треку */
    var offBus = offCtx.createGain();
    offBus.gain.value = 1.0;
    offBus.connect(offCtx.destination);

    var offDry = offCtx.createGain();
    var offWet = offCtx.createGain();
    var offRev = offCtx.createConvolver();
    if (track.realm === "indoor") {
      offDry.gain.value = 0.72;
      offWet.gain.value = 0.38;
      offRev.buffer = buildImpulseResponse(offCtx, 1.45, 0.76, 0.8, 108271);
    } else if (track.realm === "combat") {
      offDry.gain.value = 0.52;
      offWet.gain.value = 0.64;
      offRev.buffer = buildImpulseResponse(offCtx, 3.45, 0.84, 0.42, 553911);
    } else {
      offDry.gain.value = 0.50;
      offWet.gain.value = 0.70;
      offRev.buffer = buildImpulseResponse(offCtx, 3.65, 0.83, 0.22, 791233);
    }
    offDry.connect(offBus);
    offWet.connect(offRev);
    offRev.connect(offBus);

    /* На 1 миллисекунду перенаправляем генераторы нот в оффлайн-граф и раскладываем все такты */
    var savedCtx = ctx;
    var savedInDry = indoorDry, savedInWet = indoorWet;
    var savedOutDry = outdoorDry, savedOutWet = outdoorWet;
    var savedCbDry = combatDry, savedCbWet = combatWet;
    try {
      ctx = offCtx;
      indoorDry = offDry; indoorWet = offWet;
      outdoorDry = offDry; outdoorWet = offWet;
      combatDry = offDry; combatWet = offWet;

      var tCursor = 0.0;
      for (var b = 0; b < barCount; b++) {
        var bar = track.bars[b];
        for (var s = 0; s < totalSubs; s++) {
          scheduleSubStep(track, bar, s, totalSubs, subDur, tCursor);
          tCursor += subDur;
        }
      }
    } finally {
      ctx = savedCtx;
      indoorDry = savedInDry; indoorWet = savedInWet;
      outdoorDry = savedOutDry; outdoorWet = savedOutWet;
      combatDry = savedCbDry; combatWet = savedCbWet;
    }

    var p = offCtx.startRendering().then(function (rendered) {
      delete bakingPromises[key];
      if (!ctx || !rendered) { return null; }
      var seamless = ctx.createBuffer(2, loopFrames, sr);
      for (var ch = 0; ch < 2; ch++) {
        var src = rendered.getChannelData(ch);
        var dst = seamless.getChannelData(ch);
        for (var i = 0; i < loopFrames; i++) {
          dst[i] = src[i];
        }
        /* Бесшовное наложение реверберационного и инструментального хвоста в начало петли */
        var foldLen = Math.min(tailFrames, src.length - loopFrames);
        for (var f = 0; f < foldLen; f++) {
          dst[f % loopFrames] += src[loopFrames + f];
        }
        /* Мягкое микроскопическое сглаживание стыка на 64 сэмплах (2.6 мс) от любых суб-сэмпловых ступенек */
        var xfade = Math.min(64, Math.floor(loopFrames / 8));
        for (var x = 0; x < xfade; x++) {
          var alpha = x / xfade;
          var tailSample = src[loopFrames - xfade + x] + ((loopFrames + tailFrames - xfade + x < src.length) ? src[loopFrames + tailFrames - xfade + x] : 0);
          dst[loopFrames - xfade + x] = dst[loopFrames - xfade + x] * (1 - alpha * 0.15) + tailSample * (alpha * 0.15);
        }
      }
      bakedBuffers[key] = seamless;
      return seamless;
    }).catch(function () {
      delete bakingPromises[key];
      return null;
    });

    bakingPromises[key] = p;
    return p;
  }

  function stopBakedPlayback(fadeSec) {
    if (autoRotateTimer) {
      global.clearTimeout(autoRotateTimer);
      autoRotateTimer = null;
    }
    if (!ctx || !activeLoopSource) {
      activeLoopSource = null;
      activeLoopGain = null;
      activeBakedKey = "";
      return;
    }
    var oldSrc = activeLoopSource;
    var oldGain = activeLoopGain;
    activeLoopSource = null;
    activeLoopGain = null;
    activeBakedKey = "";
    try {
      var now = ctx.currentTime;
      var fade = typeof fadeSec === "number" ? fadeSec : 0.35;
      if (oldGain) {
        oldGain.gain.cancelScheduledValues(now);
        oldGain.gain.setValueAtTime(Math.max(0.0001, oldGain.gain.value || 1.0), now);
        oldGain.gain.linearRampToValueAtTime(0.0001, now + fade);
      }
      oldSrc.stop(now + fade + 0.04);
    } catch (e) {}
  }

  function scheduleAutoVariationTimer(track) {
    if (autoRotateTimer) {
      global.clearTimeout(autoRotateTimer);
      autoRotateTimer = null;
    }
    if (!state.enabled || state.mode !== "auto" || !track) { return; }
    var waitMs = Math.max(16000, Math.round(trackLoopDuration(track) * 2 * 1000));
    autoRotateTimer = global.setTimeout(function () {
      autoRotateTimer = null;
      if (!state.enabled || state.mode !== "auto") { return; }
      rotateVariationInRealm();
      syncPlayback();
    }, waitMs);
  }

  function syncPlayback() {
    if (!state.enabled || !ctx) { return; }
    if (!hasOfflineAudio()) {
      updateRealmCrossfade();
      startScheduler();
      return;
    }
    stopScheduler();
    var track = trackById(state.trackId);
    var wantedKey = trackBakeKey(track);
    if (activeLoopSource && activeBakedKey === wantedKey) {
      scheduleAutoVariationTimer(track);
      return;
    }

    var mySeq = ++bakeReqSeq;
    bakeTrackAsync(track.id).then(function (buf) {
      if (mySeq !== bakeReqSeq || !state.enabled || !ctx) { return; }
      if (!buf) {
        /* Если браузер вдруг отклонил OfflineAudioContext — мягко падаем обратно на живой планировщик */
        updateRealmCrossfade();
        startScheduler();
        return;
      }
      stopBakedPlayback(0.38);
      var now = ctx.currentTime;
      var src = ctx.createBufferSource();
      var gNode = ctx.createGain();
      src.buffer = buf;
      src.loop = true;
      gNode.gain.setValueAtTime(0.0001, now);
      gNode.gain.linearRampToValueAtTime(1.0, now + 0.36);
      src.connect(gNode);
      gNode.connect(masterGain);
      src.start(now + 0.01);

      activeLoopSource = src;
      activeLoopGain = gNode;
      activeBakedKey = wantedKey;
      scheduleAutoVariationTimer(track);

      /* Тихо предзапекаем соседнюю вариацию этого же режима наперёд, чтобы ротация была мгновенной */
      var pool = tracksByRealm(track.realm);
      if (pool.length > 1) {
        for (var i = 0; i < pool.length; i++) {
          if (pool[i].id === track.id) {
            var nextCand = pool[(i + 1) % pool.length];
            global.setTimeout(function () { bakeTrackAsync(nextCand.id); }, 450);
            break;
          }
        }
      }
    });
  }

  function startScheduler() {
    if (hasOfflineAudio()) {
      syncPlayback();
      return;
    }
    if (schedulerTimer) { return; }
    if (!ctx) { return; }
    nextSubTime = ctx.currentTime + 0.06;
    schedulerTick();
    schedulerTimer = global.setInterval(schedulerTick, 150);
  }

  function stopScheduler() {
    if (schedulerTimer) {
      global.clearInterval(schedulerTimer);
      schedulerTimer = null;
    }
  }

  function switchToTrack(trackId, manual) {
    var found = trackById(trackId);
    if (!found) { return null; }
    state.mode = manual ? "manual" : state.mode;
    state.trackId = found.id;
    state.realm = found.realm;
    curBarIdx = 0;
    curSubIdx = 0;
    barsPlayedInTrack = 0;
    savePrefs();
    if (ctx && state.enabled) {
      if (hasOfflineAudio()) {
        syncPlayback();
      } else {
        nextSubTime = ctx.currentTime + 0.08;
        updateRealmCrossfade();
      }
    }
    return found;
  }

  function setAutoMode(gameState) {
    state.mode = "auto";
    state.preCombatTrackId = null;
    if (gameState) {
      syncMood(gameState, true);
    } else {
      var pick = preferredTrackForLocation(state.location || "square", false);
      switchToTrack(pick, false);
    }
    savePrefs();
    return currentTrack();
  }

  function toggleStreetBeat() {
    state.streetBeat = !state.streetBeat;
    savePrefs();
    if (ctx && state.enabled && hasOfflineAudio()) { syncPlayback(); }
    return state.streetBeat;
  }

  function setStreetBeat(on) {
    state.streetBeat = !!on;
    savePrefs();
    if (ctx && state.enabled && hasOfflineAudio()) { syncPlayback(); }
    return state.streetBeat;
  }

  function nextTrack() {
    var cur = trackById(state.trackId);
    var idx = 0;
    for (var i = 0; i < TRACKS.length; i++) {
      if (TRACKS[i].id === cur.id) { idx = i; break; }
    }
    var next = TRACKS[(idx + 1) % TRACKS.length];
    return switchToTrack(next.id, true);
  }

  function start() {
    state.enabled = true;
    savePrefs();
    if (!ensureContext()) { return true; }
    if (ctx.state === "suspended" && typeof ctx.resume === "function") {
      ctx.resume();
    }
    applyMasterGain();
    if (hasOfflineAudio()) {
      syncPlayback();
    } else {
      updateRealmCrossfade();
      startScheduler();
    }
    return true;
  }

  function stop() {
    state.enabled = false;
    bakeReqSeq += 1;
    savePrefs();
    stopScheduler();
    stopBakedPlayback(0.32);
    applyMasterGain();
    return false;
  }

  function toggle() {
    return state.enabled ? stop() : start();
  }

  function setVolume(vol) {
    var v = Number(vol);
    if (isNaN(v)) { return state.volume; }
    state.volume = Math.max(0, Math.min(1, v));
    savePrefs();
    applyMasterGain();
    return state.volume;
  }

  /* Автоматическое переключение между помещениями, уличным грувом Enigma
     и боевой музыкой Skyrim при начале/окончании схватки. */
  function syncMood(gameState, forcePick) {
    if (!gameState || !gameState.player) { return; }
    var loc = gameState.player.location || "square";
    var hour = (gameState.time && typeof gameState.time.hour === "number") ? gameState.time.hour : 12;
    var isNight = (hour >= 21 || hour < 6);
    var inActiveCombat = !!(
      (gameState.fight && (gameState.fight.phase === "exchange" || gameState.fight.phase === "aftermath")) ||
      (gameState.skirmish && gameState.skirmish.active)
    );

    if (inActiveCombat) {
      state.mood = "combat";
      if (state.realm !== "combat") {
        state.preCombatTrackId = state.trackId;
        var cbMode = (gameState.fight && gameState.fight.mode) || (gameState.skirmish && gameState.skirmish.mode) || "crime";
        var cbId = preferredCombatTrack(cbMode);
        state.realm = "combat";
        state.trackId = cbId;
        curBarIdx = 0;
        curSubIdx = 0;
        barsPlayedInTrack = 0;
        if (ctx && state.enabled) {
          if (hasOfflineAudio()) {
            syncPlayback();
          } else {
            nextSubTime = ctx.currentTime + 0.12;
            updateRealmCrossfade();
          }
        }
      }
      return;
    }

    var targetRealm = realmForLocation(loc);
    var locChanged = loc !== state.location;
    var leavingCombat = state.realm === "combat";
    var realmChanged = targetRealm !== state.realm;
    state.location = loc;
    state.mood = targetRealm === "indoor" ? "tavern" : "calm";

    if (state.mode === "auto" && (forcePick || leavingCombat || realmChanged || locChanged)) {
      var nextId = preferredTrackForLocation(loc, isNight);
      state.realm = targetRealm;
      state.preCombatTrackId = null;
      if (nextId !== state.trackId || leavingCombat) {
        state.trackId = nextId;
        curBarIdx = 0;
        curSubIdx = 0;
        barsPlayedInTrack = 0;
        if (ctx && state.enabled) {
          if (hasOfflineAudio()) {
            syncPlayback();
          } else {
            nextSubTime = ctx.currentTime + 0.1;
            updateRealmCrossfade();
          }
        }
      }
    } else if (state.mode === "manual" && leavingCombat && state.preCombatTrackId) {
      var restore = trackById(state.preCombatTrackId);
      state.preCombatTrackId = null;
      if (restore) {
        state.trackId = restore.id;
        state.realm = restore.realm;
        curBarIdx = 0;
        curSubIdx = 0;
        barsPlayedInTrack = 0;
        if (ctx && state.enabled) {
          if (hasOfflineAudio()) {
            syncPlayback();
          } else {
            nextSubTime = ctx.currentTime + 0.1;
            updateRealmCrossfade();
          }
        }
      }
    }
  }

  function wakeOnGesture() {
    if (!state.enabled) { return; }
    if (!ctx) {
      start();
    } else {
      if (ctx.state === "suspended" && typeof ctx.resume === "function") {
        ctx.resume();
      }
      if (hasOfflineAudio()) {
        if (!activeLoopSource) { syncPlayback(); }
      } else if (!schedulerTimer) {
        startScheduler();
      }
    }
  }

  function currentTrack() {
    return trackById(state.trackId);
  }

  function listTracks() {
    return TRACKS.map(function (t) {
      return {
        id: t.id,
        title: t.title,
        subtitle: t.subtitle,
        realm: t.realm,
        bpm: t.bpm
      };
    });
  }

  loadPrefs();

  Bow.audio = {
    start: start,
    stop: stop,
    toggle: toggle,
    setVolume: setVolume,
    syncMood: syncMood,
    wakeOnGesture: wakeOnGesture,
    playBattleIntro: playBattleIntro,
    playMgsAlert: playMgsAlert,
    playLockSound: playLockSound,
    playDoorCreak: playDoorCreak,
    playClashSteel: playClashSteel,
    selectTrack: function (id) { return switchToTrack(id, true); },
    setAutoMode: setAutoMode,
    nextTrack: nextTrack,
    toggleStreetBeat: toggleStreetBeat,
    setStreetBeat: setStreetBeat,
    isStreetBeat: function () { return state.streetBeat; },
    currentTrack: currentTrack,
    listTracks: listTracks,
    getMode: function () { return state.mode; },
    getRealm: function () { return state.realm; },
    isEnabled: function () { return state.enabled; },
    getVolume: function () { return state.volume; },
    isSupported: hasWebAudio,
    isBakedSupported: hasOfflineAudio,
    bakeTrackAsync: bakeTrackAsync,
    getBakedCount: function () { return Object.keys(bakedBuffers).length; }
  };
})(typeof window !== "undefined" ? window : this);
