:: bow-street [script]
/* ============================================================
   BOW STREET — внезапные встречи на улице.

   Зачем: до 0.0.6.1 мир реагировал только на клики игрока.
   Ходишь по городу — тихо. По ТЗ события должны иметь причину,
   а не быть украшением: грабитель выходит на того, у кого есть
   деньги и кто выглядит слабо, а не на каждого подряд.

   Как устроено:
     • встреча случается при переходе между локациями;
     • шанс зависит от времени суток, места и толщины кошеля;
     • всегда есть выбор: отдать, драться, бежать, припугнуть;
     • никто не нападает на того, кто только что был избит;
     • событие висит в состоянии и переживает перерисовку.

   Модуль чистый: не знает ни про SugarCube, ни про DOM.
   ============================================================ */
(function (global) {
  "use strict";

  var Bow = global.Bow = global.Bow || {};

  function clamp(v, a, b) { return Bow.util.clamp(v, a, b); }
  function rnd(rng) { return (rng || Math.random)(); }

  /* ---------- Кто выходит ----------
     Те же правила, что у жителей: имя, умения, оружие.
     Грабитель — не «моб», он потом может встретиться снова. */
  var NAMES = ["Косой", "Рваное Ухо", "Тихий", "Гнилой Зуб", "Пепел"];

  function makeRobber(state, rng) {
    var names = NAMES.filter(function (n) {
      return !Object.keys(state.people).some(function (id) { return state.people[id].name === n; });
    });
    var pool = names.length ? names : NAMES;
    var name = pool[Math.floor(rnd(rng) * pool.length) % pool.length];

    var strength = 25 + Math.round(rnd(rng) * 25);
    return {
      key: "robber",
      refId: null,
      side: "enemy",
      name: name,
      npc: true,
      person: false,
      skills: { combat: strength, survival: 30, stealth: 20 },
      needs: { health: 70, fatigue: 65, hunger: 40, mood: 50 },
      weapon: rnd(rng) < 0.5 ? "item:knife" : null,
      armor: null,
      hp: 70,
      demand: 6 + Math.round(rnd(rng) * 10),
      /* Свой кошель у него тоже есть — иначе «обобрать» было бы
         пустым обещанием, а победитель ушёл бы ни с чем. */
      money: 8 + Math.round(rnd(rng) * 20)
    };
  }

  /* ---------- Шанс встречи ----------
     Ночью, на околице, с полным кошелём — опасно.
     В трактире и у кузницы не грабят: там люди. */
  function chanceAt(state) {
    var loc = state.player.location;
    if (loc === "tavern" || loc === "smithy") { return 0; }
    if (state.player.needs.health < 25) { return 0; }

    var base = loc === "outskirts" ? 0.18 : loc === "forest" ? 0.14 : 0.07;
    if (Bow.time.isNight(state)) { base += 0.12; }
    if (state.player.money >= 40) { base += 0.08; }
    if (state.player.money >= 100) { base += 0.07; }
    /* Тот, кто умеет драться, выглядит менее заманчиво. */
    base -= ((state.player.skills.combat || 0) / 400);
    return clamp(base, 0, 0.45);
  }

  function maybeRob(state, rng) {
    if (state.dead || state.jail || state.fight || state.guard || state.encounter) { return false; }
    if (state.player.money <= 0) { return false; }
    var chance = chanceAt(state);
    if (chance <= 0) { return false; }
    if (rnd(rng) >= chance) { return false; }

    state.encounter = {
      kind: "robber",
      robber: makeRobber(state, rng),
      phase: "demand",
      at: state.player.location
    };
    Bow.journal.add(state, "Из-за угла выходит человек с ножом и просит кошель.", "danger");
    return true;
  }

  function close(state) {
    state.encounter = null;
    return { ok: true, message: "" };
  }

  /* ---------- Отдать ---------- */
  function pay(state) {
    var e = state.encounter;
    if (!e) { return { ok: false, message: "Никто ничего не требует." }; }
    var sum = Math.min(state.player.money, e.robber.demand);
    state.player.money -= sum;
    state.encounter = null;
    Bow.needs.applyChange(state.player, "mood", -3);
    Bow.journal.add(state, "Вы отдали грабителю " + sum + " м. и ушли целыми.", "danger");
    return { ok: true, message: "Кошель стал легче на " + sum + " м. Зато без крови." };
  }

  /* ---------- Припугнуть ----------
     Навык боя и оружие в руке решают: увидел топор — передумал. */
  function scareChance(state) {
    var e = state.encounter;
    if (!e) { return 0; }
    var weapon = Bow.fight.weaponOf(state.player);
    var base = 0.15 + ((state.player.skills.combat || 0) / 300);
    if (weapon) { base += 0.22; }
    /* Голос тоже оружие: власть — умение говорить так, чтобы
       поверили. До 0.0.6.3 этот навык не влиял ни на что. */
    base += Math.min(0.18, (state.player.skills.leadership || 0) / 350);
    base -= ((e.robber.skills.combat || 0) / 500);
    if (state.player.needs.health < 40) { base -= 0.15; }
    return clamp(base, 0.05, 0.8);
  }

  function scare(state, rng) {
    var e = state.encounter;
    if (!e) { return { ok: false, message: "Никого нет." }; }

    if (rnd(rng) < scareChance(state)) {
      state.encounter = null;
      Bow.needs.applyChange(state.player, "mood", 4);
      Bow.journal.add(state, "Грабитель посмотрел на ваши руки и передумал.", "danger");
      return { ok: true, scared: true, message: "Он отступил. В этот раз — без драки." };
    }

    /* Не испугался — сразу бьёт (оставляя минимум 5 здор. до начала боя). */
    state.player.needs.health = Math.max(5, Bow.util.round1(state.player.needs.health - 8));
    e.phase = "fight";
    Bow.journal.add(state, "Грабитель не испугался и ударил первым.", "danger");
    return { ok: true, scared: false, message: "Он ударил первым: −8 здор. Придётся драться." };
  }

  /* ---------- Драка ---------- */
  function fight(state) {
    var e = state.encounter;
    if (!e) { return { ok: false, message: "Никого нет." }; }

    var robber = e.robber;
    state.encounter = null;

    state.fight = {
      personId: null,
      mode: "robbery",
      phase: "choose",
      round: 0,
      log: [],
      witnesses: [],
      allies: [],
      enemies: [{
        key: "enemy:robber",
        refId: null,
        side: "enemy",
        name: robber.name,
        npc: true,
        person: false,
        skills: robber.skills,
        needs: robber.needs,
        weapon: robber.weapon,
        armor: null,
        hp: robber.hp,
        money: robber.money
      }],
      units: [],
      heatTotal: 0,
      repTotal: 0
    };

    return Bow.fight.start(state, "robbery");
  }

  /* ---------- Бежать ---------- */
  function fleeChance(state) {
    var e = state.encounter;
    if (!e) { return 0; }
    var base = 0.4 + ((state.player.skills.survival || 0) / 250)
      + Bow.fight.injuryPenalty(state.player, "flee");
    base -= ((e.robber.skills.combat || 0) / 500);
    return clamp(base, 0.1, 0.9);
  }

  function flee(state, rng) {
    var e = state.encounter;
    if (!e) { return { ok: false, message: "Никого нет." }; }

    if (rnd(rng) < fleeChance(state)) {
      /* Убежали — но в незнакомое место: телепорт не бесплатный. */
      var places = Object.keys(Bow.data.locations).filter(function (k) {
        return k !== state.player.location;
      });
      var to = places[Math.floor(rnd(rng) * places.length) % places.length];
      state.player.location = to;
      state.encounter = null;
      Bow.journal.add(state, "Вы ушли от грабителя бегом.", "danger");
      return { ok: true, escaped: true, message: "Вы ушли — правда, не туда, куда шли." };
    }

    state.player.needs.health = Math.max(5, Bow.util.round1(state.player.needs.health - 7));
    e.phase = "fight";
    Bow.journal.add(state, "Грабитель догнал вас на бегу.", "danger");
    return { ok: true, escaped: false, message: "Он догнал: −7 здор. Придётся драться." };
  }

  Bow.street = {
    chanceAt: chanceAt,
    maybeRob: maybeRob,
    makeRobber: makeRobber,
    pay: pay,
    scareChance: scareChance,
    scare: scare,
    fight: fight,
    fleeChance: fleeChance,
    flee: flee,
    close: close
  };

})(typeof window !== "undefined" ? window : this);
