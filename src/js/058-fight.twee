:: bow-fight [script]
/* ============================================================
   BOW FIGHT — бой на простом клеточном поле.

   Зачем переписано в 0.0.6.1: прежний бой был списком реплик.
   Владелец просил видеть, кто где стоит, кого снесли, кто лежит
   со звёздочками, а кто уже мёртв. Пока бой был текстом, нельзя
   было ни понять, сколько врагов, ни оценить, стоит ли ввязываться.

   Как устроено:
     • у каждого участника клетка (col,row) на сетке 7×3 — как на
       маленьком тактическом поле; ходить пока нельзя;
     • свои идут слева, противник справа; у каждого номер и цвет;
     • здоровье видно прямо над фишкой;
     • нокаут — фишка ложится, над ней звёздочки;
     • смерть — череп, фишка больше не поднимается;
     • у противника может быть несколько бойцов: стража приходит
       втроём, и это честно видно до начала;
     • постоянные травмы (рука, глаз, нога, рёбра) остаются навсегда
       и отнимают своё — иначе это была бы картинка.

   Модуль чистый: не знает ни про SugarCube, ни про DOM.
   ============================================================ */
(function (global) {
  "use strict";

  var Bow = global.Bow = global.Bow || {};

  function rules() { return Bow.data.fightRules; }
  function clamp(v, a, b) { return Bow.util.clamp(v, a, b); }
  function rollOf(rng) { return (rng || Math.random)(); }
  function round1(v) { return Math.round(v * 10) / 10; }

  /* Род — из данных персонажа, а не «он по умолчанию». */
  function He(p) { return p && p.pron === "f" ? "Она" : "Он"; }
  function his(p) { return p && p.pron === "f" ? "её" : "его"; }

  var fightIntroSeq = 0;

  /* Естественное склонение имён персонажей для заголовка боя:
     «Бой с Брором», «Бой с отрядом Брора», «Бой с Ливой» и т. д. */
  function instrumentalName(name, pron) {
    var s = String(name || "противником").trim();
    if (!s) { return "противником"; }
    if (/ой$/i.test(s) && pron !== "f") { return s.replace(/ой$/i, "ым"); }
    if (/ий$/i.test(s) && pron !== "f") { return s.replace(/ий$/i, "им"); }
    if (/а$/i.test(s)) { return s.slice(0, -1) + (/[жшчщц]$/i.test(s.slice(0, -1)) ? "ей" : "ой"); }
    if (/я$/i.test(s)) { return s.slice(0, -1) + "ей"; }
    if (/ь$/i.test(s)) { return pron === "f" ? (s + "ю") : (s.slice(0, -1) + "ем"); }
    if (/й$/i.test(s)) { return s.slice(0, -1) + "ем"; }
    if (/[бвгджзклмнпрстфхцчшщ]$/i.test(s)) {
      return s + (/[жшчщц]$/i.test(s) ? "ем" : "ом");
    }
    return s;
  }

  function genitiveName(name, pron) {
    var s = String(name || "противника").trim();
    if (!s) { return "противника"; }
    if (/ой$/i.test(s) && pron !== "f") { return s.replace(/ой$/i, "ого"); }
    if (/ий$/i.test(s) && pron !== "f") { return s.replace(/ий$/i, "его"); }
    if (/а$/i.test(s)) { return s.slice(0, -1) + (/[гкхжшчщ]$/i.test(s.slice(0, -1)) ? "и" : "ы"); }
    if (/я$/i.test(s)) { return s.slice(0, -1) + "и"; }
    if (/ь$/i.test(s)) { return s.slice(0, -1) + "и"; }
    if (/й$/i.test(s)) { return s.slice(0, -1) + "я"; }
    if (/[бвгджзклмнпрстфхцчшщ]$/i.test(s)) { return s + "а"; }
    return s;
  }

  /* Численный множитель отряда-стека (в духе King's Bounty: 1 фигурка = N бойцов). */
  function stackPowerMult(unitOrPerson) {
    var cnt = (unitOrPerson && typeof unitOrPerson.count === "number") ? unitOrPerson.count : 1;
    if (cnt <= 1) { return 1; }
    return 1 + Math.min(2.6, Math.log(cnt) / Math.LN2 * 0.30);
  }

  /* Создание отряда-стека («Рыцари ×100», «Стражники ×12», «Разбойники ×8»):
     на поле стоит одна фигурка со значком численности, а урон списывает бойцов из стека. */
  function createStack(opts) {
    opts = opts || {};
    var count = Math.max(1, Math.round(opts.count || 1));
    var unitHp = Math.max(10, Math.round(opts.unitHp || 80));
    var topHp = Math.max(1, Math.min(unitHp, Math.round(opts.topHp || unitHp)));
    var pct = Math.max(1, Math.round((topHp / unitHp) * 100));
    return {
      key: opts.key || ("stack:" + Math.random().toString(36).slice(2, 8)),
      refId: null,
      side: opts.side || "enemy",
      name: opts.name || "Отряд ратников",
      role: opts.role || "отряд",
      roleKey: opts.roleKey || "guard",
      npc: true,
      isStack: count > 1 || !!opts.isStack,
      count: count,
      maxCount: Math.max(count, Math.round(opts.maxCount || count)),
      unitHp: unitHp,
      topHp: topHp,
      hp: pct,
      needs: { health: pct, fatigue: 90, hunger: 80, mood: 65 },
      skills: {
        combat: typeof opts.combat === "number" ? opts.combat : 38,
        melee_defense: typeof opts.defense === "number" ? opts.defense : 30
      },
      attrs: opts.attrs || { strength: 18, toughness: 16, agility: 15, perception: 15 },
      weapon: opts.weapon !== undefined ? opts.weapon : "item:axe",
      armor: opts.armor !== undefined ? opts.armor : "item:coat",
      injuries: []
    };
  }

  /* Осмысленный заголовок схватки вместо одинокого имени персонажа («Бой с Брором» / «Бой с отрядом Брора»). */
  function titleOf(f, state) {
    if (!f) { return "Схватка"; }
    var npc = (state && state.people && f.personId) ? state.people[f.personId] : null;
    var foeList = (Array.isArray(f.units) && f.units.length)
      ? f.units.filter(function (u) { return u.side === "enemy"; })
      : (f.enemies || []);
    var totalFoes = foeList.reduce(function (sum, u) {
      return sum + (typeof u.count === "number" && u.count > 0 ? u.count : 1);
    }, 0);

    if (f.mode === "guard") {
      return "Бой со стражей Брода";
    }
    if (f.mode === "spar") {
      if (npc) {
        return totalFoes > 1
          ? ("Кулачный бой с людьми " + genitiveName(npc.name, npc.pron))
          : ("Кулачный бой с " + instrumentalName(npc.name, npc.pron));
      }
      return "Кулачный поединок";
    }
    if (f.mode === "robbery") {
      var rob = foeList[0];
      if (totalFoes > 1) { return "Бой с шайкой разбойников"; }
      return rob ? ("Схватка с грабителем (" + rob.name + ")") : "Схватка с грабителем";
    }
    if (npc) {
      return totalFoes > 1
        ? ("Бой с отрядом " + genitiveName(npc.name, npc.pron))
        : ("Бой с " + instrumentalName(npc.name, npc.pron));
    }
    if (foeList.length) {
      return (totalFoes > 1 || foeList.length > 1)
        ? ("Бой с отрядом: " + foeList[0].name)
        : ("Бой с " + instrumentalName(foeList[0].name, foeList[0].pron));
    }
    return "Схватка";
  }

  /* ---------- Кукла снаряжения из 8 слотов и статы предметов (0.0.9.2) ---------- */
  var EQUIP_SLOT_DEFS = [
    { key: "head",    label: "Шлем",     short: "Голова" },
    { key: "armor",   label: "Доспех",   short: "Корпус" },
    { key: "hands",   label: "Перчатки", short: "Руки" },
    { key: "legs",    label: "Штаны",    short: "Ноги" },
    { key: "boots",   label: "Сапоги",   short: "Обувь" },
    { key: "weapon",  label: "Оружие 1", short: "Оружие 1" },
    { key: "weapon2", label: "Оружие 2", short: "Оружие 2" },
    { key: "offhand", label: "Доп. рука",short: "Щит / Снаряды" }
  ];

  function slotOfItem(def) {
    if (!def) { return null; }
    return def.slot || def.equip || null;
  }

  function itemValue(def) {
    if (!def) { return 0; }
    return (def.attack || 0) * 1.4 + (def.defense || 0) * 1.3 + (def.block || 0) * 0.12 + (def.attackBonus || 0) + (def.warmth || 0) * 0.2;
  }

  function hasBagItem(person, itemId) {
    if (!person || !Array.isArray(person.inventory) || !itemId) { return false; }
    for (var i = 0; i < person.inventory.length; i++) {
      if (person.inventory[i].itemId === itemId && person.inventory[i].qty > 0) { return true; }
    }
    return false;
  }

  function ensureSlots(person) {
    if (!person) { return; }
    if (!Bow.util.isPlainObject(person.slots)) {
      person.slots = { head: null, armor: null, hands: null, legs: null, boots: null, weapon: null, weapon2: null, offhand: null };
    }
    if (!Bow.util.isPlainObject(person.slotsLocked)) {
      person.slotsLocked = {};
    }
    if (person.activeWeaponSet !== 1 && person.activeWeaponSet !== 2) {
      person.activeWeaponSet = 1;
    }
  }

  function bestEquipForSlot(person, slot, activeWeaponDef) {
    var best = null;
    (person.inventory || []).forEach(function (entry) {
      if (!entry || entry.qty <= 0) { return; }
      var def = Bow.economy.findItemDef(entry.itemId);
      if (!def) { return; }
      var itemSlot = slotOfItem(def);
      if (slot === "weapon") {
        if (itemSlot !== "weapon" && def.equip !== "weapon") { return; }
      } else if (slot === "armor") {
        if (itemSlot !== "armor" && def.equip !== "armor") { return; }
      } else if (slot === "offhand") {
        if (itemSlot !== "offhand") { return; }
        if (activeWeaponDef && activeWeaponDef.handsReq === 2 && def.offhandKind === "shield") { return; }
        if (def.offhandKind === "quiver" && (!activeWeaponDef || activeWeaponDef.ammoType !== def.ammoFor)) { return; }
      } else {
        if (itemSlot !== slot) { return; }
      }
      if (!best || itemValue(def) > itemValue(best)) { best = def; }
    });
    return best;
  }

  function bestEquip(person, slot) {
    return bestEquipForSlot(person, slot, null);
  }

  function equippedIn(person, slot) {
    if (!person || !person.inventory) { return null; }
    ensureSlots(person);
    if (person.slotsLocked[slot]) {
      var chosenId = person.slots[slot];
      if (!chosenId) { return null; }
      if (hasBagItem(person, chosenId)) {
        return Bow.economy.findItemDef(chosenId);
      }
      person.slots[slot] = null;
      person.slotsLocked[slot] = false;
    }
    if (slot === "weapon2") {
      var w2Id = person.slots.weapon2;
      if (w2Id && hasBagItem(person, w2Id)) { return Bow.economy.findItemDef(w2Id); }
      return null;
    }
    if (slot === "offhand") {
      var actSlot = person.activeWeaponSet === 2 ? "weapon2" : "weapon";
      var actWep = equippedIn(person, actSlot);
      return bestEquipForSlot(person, "offhand", actWep);
    }
    return bestEquipForSlot(person, slot, null);
  }

  function setEquipSlot(person, slot, itemId) {
    if (!person || !person.inventory) { return { ok: false, message: "Нет инвентаря." }; }
    ensureSlots(person);
    if (!itemId) {
      person.slots[slot] = null;
      person.slotsLocked[slot] = true;
      return { ok: true, slot: slot, itemId: null };
    }
    if (!hasBagItem(person, itemId)) {
      return { ok: false, message: "Этого предмета нет в сумке." };
    }
    var def = Bow.economy.findItemDef(itemId);
    if (!def) { return { ok: false, message: "Неизвестный предмет." }; }
    var naturalSlot = slotOfItem(def);
    var targetSlot = slot || naturalSlot;
    if ((targetSlot === "weapon" || targetSlot === "weapon2") && naturalSlot === "weapon") {
      /* Если этот же единственный экземпляр лежал в соседнем оружейном слоте, освободим дубль */
      var otherSlot = targetSlot === "weapon" ? "weapon2" : "weapon";
      var bagEntry = person.inventory.filter(function (e) { return e.itemId === itemId; })[0];
      if (bagEntry && bagEntry.qty < 2 && person.slots[otherSlot] === itemId) {
        person.slots[otherSlot] = null;
        person.slotsLocked[otherSlot] = true;
      }
    } else if (targetSlot !== naturalSlot) {
      return { ok: false, message: "Этот предмет нельзя надеть в выбранный слот." };
    }

    /* Правило двуручного оружия и щита */
    var activeSlot = person.activeWeaponSet === 2 ? "weapon2" : "weapon";
    if (targetSlot === activeSlot && def.handsReq === 2) {
      var curOff = equippedIn(person, "offhand");
      if (curOff && curOff.offhandKind === "shield") {
        person.slots.offhand = null;
        person.slotsLocked.offhand = true;
      }
    }
    if (targetSlot === "offhand" && def.offhandKind === "shield") {
      var curW = equippedIn(person, activeSlot);
      if (curW && curW.handsReq === 2) {
        return { ok: false, message: "Нельзя взять щит: обе руки заняты двуручным оружием (" + curW.name + ")." };
      }
    }

    person.slots[targetSlot] = itemId;
    person.slotsLocked[targetSlot] = true;
    return { ok: true, slot: targetSlot, itemId: itemId, name: def.name };
  }

  function swapWeaponSet(person) {
    if (!person) { return 1; }
    ensureSlots(person);
    person.activeWeaponSet = person.activeWeaponSet === 2 ? 1 : 2;
    var actW = equippedIn(person, person.activeWeaponSet === 2 ? "weapon2" : "weapon");
    var off = equippedIn(person, "offhand");
    if (actW && actW.handsReq === 2 && off && off.offhandKind === "shield") {
      person.slots.offhand = null;
      person.slotsLocked.offhand = true;
    }
    return person.activeWeaponSet;
  }

  function totalGearStats(person) {
    var res = { defense: 0, warmth: 0, mobility: 0, block: 0, attackBonus: 0, armorPenBonus: 0 };
    if (!person) { return res; }
    if (!person.inventory) {
      var npcArm = person.armor ? Bow.economy.findItemDef(person.armor) : null;
      if (npcArm) { res.defense += npcArm.defense || 0; }
      return res;
    }
    var actW = weaponOf(person);
    ["head", "armor", "hands", "legs", "boots", "offhand"].forEach(function (sl) {
      var def = equippedIn(person, sl);
      if (!def) { return; }
      if (sl === "offhand" && def.offhandKind === "shield" && actW && actW.handsReq === 2) { return; }
      res.defense += def.defense || 0;
      res.warmth += def.warmth || 0;
      res.mobility += def.mobility || 0;
      res.block += def.block || 0;
      if (sl === "offhand" && def.offhandKind === "quiver" && actW && actW.ammoType === def.ammoFor) {
        res.attackBonus += def.attackBonus || 0;
        res.armorPenBonus += def.armorPenBonus || 0;
      }
    });
    return res;
  }

  function weaponOf(person) {
    if (!person || person.disarmed) { return null; }
    if (person.inventory) {
      ensureSlots(person);
      var actSlot = person.activeWeaponSet === 2 ? "weapon2" : "weapon";
      return equippedIn(person, actSlot);
    }
    if (person.weapon) { return Bow.economy.findItemDef(person.weapon); }
    return null;
  }

  function armorOf(person) {
    if (!person) { return null; }
    if (person.inventory) { return equippedIn(person, "armor"); }
    if (person.armor) { return Bow.economy.findItemDef(person.armor); }
    return null;
  }

  /* ---------- Постоянные травмы ----------
     Остаются навсегда и отнимают своё. Список — в данных. */
  function injuryDefs() { return Bow.data.fightRules.injuries; }

  function hasInjury(person, key) {
    return (person.injuries || []).some(function (i) { return i.key === key; });
  }

  function injuryPenalty(person, field) {
    var total = 0;
    (person.injuries || []).forEach(function (i) {
      var def = injuryDefs()[i.key];
      if (def && typeof def[field] === "number") { total += def[field]; }
    });
    return total;
  }

  function injuryWord(person) {
    return (person.injuries || []).map(function (i) {
      var def = injuryDefs()[i.key];
      return def ? def.name : i.key;
    });
  }

  /* Нанести постоянную травму по месту удара (голова → глаз, руки → рука,
     ноги → колено, корпус → рёбра). Если такая травма уже есть — берём свободную. */
  var AIM_INJURY = { head: "eye", arms: "arm", legs: "leg", body: "ribs" };
  var BASE_INJURY_KEYS = ["arm", "eye", "leg", "ribs"];

  function applyInjuryAnatomy(person, key) {
    if (!person) { return; }
    if (Bow.state && Bow.state.ensureAnatomy) { Bow.state.ensureAnatomy(person); }
    person.organs = person.organs || { left_eye: true, right_eye: true, left_ear: true, right_ear: true };
    if (key === "eye") {
      if (person.organs.left_eye !== false) { person.organs.left_eye = false; }
      else { person.organs.right_eye = false; }
    } else if (key === "ear") {
      if (person.organs.left_ear !== false) { person.organs.left_ear = false; }
      else { person.organs.right_ear = false; }
    } else if (key === "arm_lost" && person.body) {
      var armKey = (person.body.left_arm && !person.body.left_arm.lost) ? "left_arm" : "right_arm";
      if (person.body[armKey]) { person.body[armKey].lost = true; person.body[armKey].hp = 0; }
    } else if (key === "leg_lost" && person.body) {
      var legKey = (person.body.left_leg && !person.body.left_leg.lost) ? "left_leg" : "right_leg";
      if (person.body[legKey]) { person.body[legKey].lost = true; person.body[legKey].hp = 0; }
    }
  }

  function maim(person, rng, aimKey, exactKey) {
    var defs = injuryDefs();
    var key = null;
    if (exactKey && defs[exactKey] && !hasInjury(person, exactKey)) {
      key = exactKey;
    } else {
      var freeBase = BASE_INJURY_KEYS.filter(function (k) { return defs[k] && !hasInjury(person, k); });
      var pool = freeBase.length ? freeBase : Object.keys(defs).filter(function (k) { return !hasInjury(person, k); });
      if (!pool.length) { return null; }
      var preferred = aimKey && AIM_INJURY[aimKey];
      key = (preferred && pool.indexOf(preferred) !== -1)
        ? preferred
        : pool[Math.floor(rollOf(rng) * pool.length) % pool.length];
    }
    var def = defs[key];
    person.injuries = person.injuries || [];
    person.injuries.push({ key: key, at: null });
    applyInjuryAnatomy(person, key);
    return def;
  }

  /* ---------- Сила ---------- */
  function weaponSkillOf(person, weapon) {
    if (!person || !person.skills) { return 0; }
    if (!weapon) { return person.skills.unarmed || 0; }
    var cls = weapon.weaponClass || (/axe/.test(weapon.id) ? "axes" : /knife|sword/.test(weapon.id) ? "blades" : "blunt");
    return person.skills[cls] || 0;
  }

  function attackPower(person, mode) {
    var weapon = mode === "spar" ? null : weaponOf(person);
    var gear = mode === "spar" ? { attackBonus: 0 } : totalGearStats(person);
    var skill = (person.skills && person.skills.combat) || 0;
    var wSkill = weaponSkillOf(person, weapon);
    var str = (Bow.state && Bow.state.effectiveAttr && person.attrs)
      ? Bow.state.effectiveAttr(person, "strength")
      : 14;
    var wepAtk = weapon ? ((weapon.attack || 0) + (gear.attackBonus || 0)) : 0;
    var raw = 12 + skill / 5.5 + wSkill / 22 + (str - 14) * 0.18 + wepAtk * 1.6;
    return Math.max(3, raw * (1 - injuryPenalty(person, "power")));
  }

  function defenseOf(person, mode) {
    var armor = mode === "spar" ? null : armorOf(person);
    var gear = mode === "spar" ? { defense: 0, block: 0 } : totalGearStats(person);
    var totalDefVal = person && person.inventory ? gear.defense : (armor ? (armor.defense || 0) : 0);
    var skill = (person.skills && person.skills.combat) || 0;
    var defSkill = (armor || totalDefVal > 0)
      ? ((person.skills && person.skills.melee_defense) || 0)
      : ((person.skills && person.skills.dodge) || 0);
    var tough = (Bow.state && Bow.state.effectiveAttr && person.attrs)
      ? Bow.state.effectiveAttr(person, "toughness")
      : 12;
    return skill / 28 + defSkill / 65 + Math.max(0, (tough - 12) * 0.08) + totalDefVal * 1.1 + (gear.block || 0) * 0.06;
  }

  function aimDef(key) {
    var all = rules().aim || {};
    return all[key] || all.body || { hit: 1, hurt: 1, down: 1, maim: 1, name: "корпус" };
  }

  /* ---------- Точность ----------
     Попасть — это не только «кто сильнее». Три вещи решают:
       • бой — насколько вы вообще умеете бить;
       • выживание — читать движение тела и не мазать в спешке;
       • куда бьёте — в голову попасть труднее всего.
     До 0.0.6.3 всё сводилось к разнице навыков боя. */
  function hitChance(attacker, defender, stance, aimKey) {
    var a = (attacker.skills && attacker.skills.combat) || 0;
    var d = (defender.skills && defender.skills.combat) || 0;
    var survival = (attacker.skills && attacker.skills.survival) || 0;

    var chance = 0.55 + (a - d) / 220;
    /* Навык выживания — это умение читать чужое движение. */
    chance += Math.min(0.10, survival / 900);
    chance += injuryPenalty(attacker, "hit");

    /* Точность места удара: голова — 0.62, корпус — 1.0. */
    var aim = aimDef(aimKey);
    chance *= aim.hit;

    var n = attacker.needs;
    if (n && n.fatigue < 30) { chance -= 0.10; }
    if (n && n.fatigue < 12) { chance -= 0.08; }
    if (n && n.health < 35 && !(attacker.count > 1)) { chance -= 0.08; }
    if (attacker.count > 1) {
      chance += Math.min(0.15, Math.log(attacker.count) / Math.LN10 * 0.075);
    }
    if (stance === "guard") { chance *= 0.65; }
    if (stance === "press") { chance += 0.03; }
    return clamp(chance, 0.10, 0.92);
  }

  function damageRoll(attacker, defender, mode, defenderStance, rng, aimKey) {
    var aim = aimDef(aimKey);
    var atkPwr = attackPower(attacker, mode) * stackPowerMult(attacker);
    var raw = atkPwr - defenseOf(defender, mode) * 0.7 + (rollOf(rng) * 4 - 1.5);
    raw *= aim.hurt;
    var damage = Math.max(2, Math.round(raw));
    if (defenderStance === "guard") { damage = Math.max(1, Math.round(damage * 0.5)); }
    if (mode === "spar") { damage = Math.max(1, Math.round(damage * 0.7)); }
    return damage;
  }

  /* ---------- Свидетели ----------
     Снимок делается в начале: кто видел начало драки. */
  function witnessIds(state, exceptId) {
    return Bow.steal.witnessesAt(state, state.player.location)
      .filter(function (p) { return p.id !== exceptId; })
      .map(function (p) { return p.id; });
  }

  function witnessNames(state) {
    var f = state.fight;
    if (!f || !f.witnesses) { return []; }
    return f.witnesses.map(function (id) {
      var p = state.people[id];
      return p ? p.name : null;
    }).filter(Boolean);
  }

  /* ---------- Кого можно позвать ----------
     Пока один спутник, но список — сразу: отряд будет расти. */
  /* ---------- Отряд ----------
     Спутник идёт не «потому что он в списке», а по трём вещам:
     насколько он к вам расположен, умеет ли драться и в каком он
     состоянии. Каждый отказ объяснён — игрок видит причину числом,
     а не гадает, почему кнопка серая.

     Власть работает здесь впервые: с высоким навыком люди идут
     за вами при меньшем отношении. */
  function allyState(state, personId) {
    var cfg = rules().squad || {};
    var p = state.people[personId];
    if (!p || !p.alive) { return null; }

    var need = Math.max(0,
      (cfg.willingAt === undefined ? 15 : cfg.willingAt) -
      Math.floor(((state.player.skills.leadership || 0) / 10) * (cfg.perLead || 6)));
    var combatNeed = cfg.minCombat === undefined ? 30 : cfg.minCombat;
    var minHealth = cfg.minHealth === undefined ? 45 : cfg.minHealth;

    var why = null;
    if (p.location !== state.player.location) { why = "не здесь"; }
    else if (p.attitude < need) { why = "не доверяет: " + Math.round(p.attitude) + " из " + need; }
    else if ((p.skills.combat || 0) < combatNeed) { why = "не боец: бой " + (p.skills.combat || 0); }
    else if (p.needs.health < minHealth) { why = "ранен: " + Math.round(p.needs.health) + " здор."; }

    return {
      id: p.id,
      name: p.name,
      role: p.role,
      attitude: p.attitude,
      trustNeed: need,
      health: p.needs.health,
      combat: p.skills.combat || 0,
      willing: !why,
      why: why
    };
  }

  function alliesAvailable(state) {
    var names = rules().arena.allySpawns || [];
    var foeId = state && state.fight && state.fight.personId ? state.fight.personId : null;
    return names.filter(function (key) {
      return ("person:" + key) !== foeId;
    }).map(function (key) {
      return allyState(state, "person:" + key);
    }).filter(Boolean);
  }

  /* Доверие после боя: выиграли вместе — стал ближе; его избили,
     пока вы не помогли, — запомнил. */
  function squadAftermath(state, outcome, lostAlly) {
    var cfg = rules().squad || {};
    (state.fight.allies || []).forEach(function (id) {
      var p = state.people[id];
      if (!p || !p.alive) { return; }
      if (lostAlly && lostAlly.refId === id) {
        p.attitude = clamp(p.attitude - (cfg.failDrop || 14), -100, 100);
        p.memory.push({
          kind: "abandoned",
          text: "Меня сбили, а " + state.player.name + " не помог.",
          weight: 8,
          totalHours: state.time.totalHours
        });
      } else if (outcome === "win") {
        p.attitude = clamp(p.attitude + (cfg.winGain || 5), -100, 100);
        p.memory.push({
          kind: "fought",
          text: "Мы держались вместе, и взяли верх.",
          weight: 5,
          totalHours: state.time.totalHours
        });
      }
      Bow.util.trim(p.memory, 40);
    });
  }

  /* ---------- Расстановка на поле ----------
     Свои слева, противник справа. Занятые клетки не повторяются. */
  function spawnUnits(state) {
    var A = rules().arena;
    var units = [];
    var taken = {};

    function free(cell) {
      var key = cell[0] + "," + cell[1];
      if (taken[key]) { return false; }
      taken[key] = true;
      return true;
    }

    var fCur = state.fight || {};
    var enemyCnt = (fCur.enemies || []).length;
    var isBigBattle = (fCur.mode === "battle") || (fCur.enemies || []).some(function (e) {
      return e && (e.isStack || (e.count && e.count > 1));
    });

    function place(side, index) {
      var list;
      if (side === "ally") {
        list = A.spawn.ally;
      } else if (isBigBattle && A.spawn.enemyBattle) {
        list = A.spawn.enemyBattle;
      } else if (enemyCnt > 1 && A.spawn.enemyGroup) {
        list = A.spawn.enemyGroup;
      } else {
        list = A.spawn.enemy;
      }
      if (index < list.length) { return list[index].slice(); }
      var extra = A.extra[side];
      return extra[(index - list.length) % extra.length].slice();
    }

    function put(side, unit, index) {
      var cell = place(side, index);
      var guard = 0;
      while (!free(cell) && guard++ < 30) {
        cell = [cell[0], (cell[1] + 1) % A.rows];
      }
      unit.col = cell[0];
      unit.row = cell[1];
      unit.maxHp = 100;
      if (typeof unit.count !== "number" || unit.count < 1) { unit.count = 1; }
      if (typeof unit.maxCount !== "number" || unit.maxCount < unit.count) { unit.maxCount = unit.count; }
      if (unit.count > 1) {
        unit.isStack = true;
        unit.unitHp = unit.unitHp || 80;
        unit.topHp = unit.topHp || unit.unitHp;
        unit.hp = Math.max(1, Math.round((unit.topHp / unit.unitHp) * 100));
        if (!unit.needs) { unit.needs = { health: unit.hp, fatigue: 90, hunger: 80, mood: 65 }; }
      }
      unit.stance = "press";
      unit.down = false;
      unit.dead = false;
      units.push(unit);
    }

    /* Игрок всегда первый слева. */
    put("ally", {
      key: "player", refId: state.player.id, side: "ally",
      name: state.player.name, npc: false, hp: state.player.needs.health
    }, 0);

    var allySlot = 1;
    (state.fight.allies || []).forEach(function (id) {
      var p = state.people[id];
      if (!p || !p.alive) { return; }
      /* Тяжело раненный в прошлом бою встаёт не сразу: это видно
         в списке отряда числом, а не выясняется отказом на кнопке. */
      put("ally", {
        key: "ally:" + id, refId: id, side: "ally",
        name: p.name, npc: true, hp: p.needs.health
      }, allySlot++);
    });

    (state.fight.allyUnits || []).forEach(function (au) {
      if (!au) { return; }
      au.side = "ally";
      put("ally", au, allySlot++);
    });

    (state.fight.enemies || []).forEach(function (enemy, i) {
      put("enemy", enemy, i);
    });

    return units;
  }

  /* Живой человек превращается в бойца на поле. */
  function enemyUnit(state, personId) {
    var p = state.people[personId];
    if (!p) { return null; }
    return {
      key: "enemy:" + personId,
      refId: personId,
      side: "enemy",
      name: p.name,
      npc: true,
      person: true,
      hp: p.needs.health
    };
  }

  /* ---------- Сколько стоит нападение ----------
     Показывает интерфейс до начала: шансы и последствия. */
  function odds(state, personId, mode) {
    var person = state.people[personId];
    if (!person) { return null; }
    var R = rules();
    var witnesses = witnessIds(state, personId).length;
    return {
      name: person.name,
      role: person.role,
      yourHit: hitChance(state.player, person, "press"),
      theirHit: hitChance(person, state.player, "press"),
      yourPower: Math.round(attackPower(state.player, mode)),
      theirPower: Math.round(attackPower(person, mode)),
      purse: typeof person.money === "number" ? person.money : 0,
      witnesses: witnesses,
      heat: R.crimeHeat + witnesses * R.witnessHeat,
      rep: R.crimeRep,
      canSpar: person.attitude >= R.sparMinAttitude
    };
  }

  /* ---------- Окно выбора ---------- */
  function open(state, personId) {
    var person = state.people[personId];
    if (!person || !person.alive) { return { ok: false, message: "Здесь никого нет." }; }
    if (person.location !== state.player.location) {
      return { ok: false, message: person.name + " не здесь." };
    }
    state.fight = {
      personId: personId,
      mode: null,
      phase: "choose",
      round: 0,
      log: [],
      witnesses: witnessIds(state, personId),
      allies: [],
      enemies: [],
      units: [],
      orders: { stance: "press", aim: "body", squad: "focus", speed: "paused" },
      heatTotal: 0,
      repTotal: 0
    };
    return { ok: true, message: "" };
  }

  function close(state) {
    state.fight = null;
    return { ok: true, message: "" };
  }

  function toggleAlly(state, personId) {
    var f = state.fight;
    if (!f || f.phase !== "choose") { return { ok: false, message: "Уже не время." }; }
    var who = alliesAvailable(state).filter(function (a) {
      return a.id === personId && a.willing;
    })[0];
    if (!who) { return { ok: false, message: "Он не пойдёт за вас." }; }

    var idx = f.allies.indexOf(personId);
    if (idx === -1) {
      f.allies.push(personId);
      return { ok: true, message: who.name + " идёт с вами." };
    }
    f.allies.splice(idx, 1);
    return { ok: true, message: who.name + " остаётся." };
  }

  /* ---------- Начать бой ---------- */
  function start(state, mode, rng) {
    var f = state.fight;
    if (!f || f.phase !== "choose") { return { ok: false, message: "Бой уже идёт." }; }

    var R = rules();
    var n = state.player.needs;
    /* Нападать первым или выходить на кулачный бой полумёртвым нельзя,
       но когда стража или грабитель уже взяли за ворот — отмахнуться
       придётся в любом состоянии. */
    if (mode !== "guard" && mode !== "robbery") {
      if (n.fatigue < 12) { return { ok: false, message: "Вы едва стоите. Сначала отдых." }; }
      if (n.health < 25) { return { ok: false, message: "Вы слишком плохи, чтобы драться." }; }
    }

    if (["spar", "crime", "guard", "robbery"].indexOf(mode) === -1) {
      return { ok: false, message: "Так не дерутся." };
    }

    var person = state.people[f.personId];

    /* У грабителя нет записи в людях — он приходит из встречи.
       Его противник уже лежит в f.enemies и ждёт только старта. */
    ensureOrders(f);

    if (mode === "robbery") {
      f.mode = mode;
      f.phase = "exchange";
      f.introId = ++fightIntroSeq;
      f.round = 0;
      f.heatTotal = 0;
      f.repTotal = 0;
      f.units = spawnUnits(state);
      Bow.needs.applyChange(state.player, "fatigue", -2);
      log(f, "narr", f.enemies[0].name + " выходит на свет с ножом. Разговор кончился.");
      Bow.journal.add(state, "Грабитель ударил первым.", "danger");
      return { ok: true, message: "Драка на улице. Противник: " + f.enemies[0].name + "." };
    }

    if (mode !== "guard") {
      if (!person || !person.alive) { return { ok: false, message: "Противник исчез." }; }
      if (person.location !== state.player.location) {
        return { ok: false, message: person.name + " уже не здесь." };
      }
      if (mode === "spar" && person.attitude < R.sparMinAttitude) {
        return { ok: false, message: person.name + " не станет с вами бороться." };
      }
    }

    f.mode = mode;
    f.phase = "exchange";
    f.introId = ++fightIntroSeq;
    f.round = 0;
    f.heatTotal = 0;
    f.repTotal = 0;

    /* Кто против нас. */
    if (mode === "guard") {
      f.enemies = (f.guardSquad || []).slice();
    } else if (Array.isArray(f.customEnemies) && f.customEnemies.length) {
      f.enemies = f.customEnemies.slice();
    } else {
      var unit = enemyUnit(state, f.personId);
      if (!unit) { return { ok: false, message: "Противник исчез." }; }
      f.enemies = [unit];
    }

    f.units = spawnUnits(state);

    /* В пошаговом бою мировые часы стоят на месте (0.0.7.3). */
    Bow.needs.applyChange(state.player, "fatigue", -2);

    if (mode === "guard" && Bow.work) {
      /* Поднять оружие на караул Брода — прямое падение отношения стражи. */
      Bow.work.addReputation(state, "org:guard", -14);
    }

    if (mode === "crime") {
      /* Нападение — преступление сразу, а не по итогу боя. */
      var heat = R.crimeHeat + f.witnesses.length * R.witnessHeat;
      f.heatTotal += Bow.steal.addHeat(state, person.org, heat);
      f.repTotal += Bow.work.addReputation(state, person.org, R.crimeRep);
      Bow.steal.addHeat(state, "org:guard", Math.round(heat * 0.5));
      if (Bow.work && person.org !== "org:guard") {
        Bow.work.addReputation(state, "org:guard", -8);
      }

      person.memory.push({
        kind: "attacked",
        text: state.player.name + " напал на меня без повода.",
        weight: 9,
        totalHours: state.time.totalHours
      });
      Bow.util.trim(person.memory, 40);
      person.attitude = clamp(person.attitude - 30, -100, 100);

      f.witnesses.forEach(function (id) {
        var w = state.people[id];
        if (!w || !w.alive) { return; }
        w.memory.push({
          kind: "witness",
          text: "Видел, как " + state.player.name + " напал на " + person.name + ".",
          weight: 8,
          totalHours: state.time.totalHours
        });
        Bow.util.trim(w.memory, 40);
        w.attitude = clamp(w.attitude - 8, -100, 100);
      });

      log(f, "narr", "Вы бьёте первым, без слова. " +
        (f.witnesses.length
          ? "Видели: " + witnessNames(state).join(", ") + "."
          : "Свидетелей не было."));

      Bow.journal.add(state,
        "Вы напали первым. " +
        (f.witnesses.length ? "Видели: " + witnessNames(state).join(", ") + "." : "Свидетелей не было.") +
        " Община " + Bow.work.orgName(state, person.org) + " узнает.",
        "crime");

      return { ok: true, message: "Драка началась. Противников: " + f.enemies.length + "." };
    }

    if (mode === "guard") {
      log(f, "narr", "Стража перекрывает вам дорогу. Их несколько, и они умеют этим заниматься.");
      Bow.journal.add(state, "Стража Брода пришла за вами.", "guard");
      return { ok: true, message: "Стража здесь. Разговор будет коротким." };
    }

    log(f, "narr", person.name + " скидывает куртку и встаёт напротив. Без злобы — проверяет, чего вы стоите.");
    Bow.journal.add(state, "Кулачный бой с " + person.name + ".", "fight");
    return { ok: true, message: "Кулачный бой начался." };
  }

  /* Выбрать цель до удара. Ход не тратится: это прицеливание,
     а не действие. */
  function ensureOrders(f) {
    if (!f) { return null; }
    if (!f.orders) {
      f.orders = {
        stance: "press",
        aim: "body",
        squad: "free",
        speed: "paused"
      };
    }
    if (!f.orders.stance) { f.orders.stance = "press"; }
    if (!f.orders.aim) { f.orders.aim = "body"; }
    if (!f.orders.squad) { f.orders.squad = "free"; }
    if (!f.orders.speed) { f.orders.speed = "paused"; }
    return f.orders;
  }

  /* Тактический приказ в полуручном бою (0.0.7): меняется мгновенно,
     хоть на паузе, хоть на живом ходу, не тратя такт обмена. */
  function setOrder(state, kind, value) {
    var f = state.fight;
    if (!f || f.phase !== "exchange") { return { ok: false, message: "Сейчас не бой." }; }
    var o = ensureOrders(f);

    if (kind === "stance") {
      if (["press", "guard", "flee"].indexOf(value) === -1) {
        return { ok: false, message: "Неизвестная стойка." };
      }
      o.stance = value;
      var sLabel = value === "guard" ? "Глухая защита." : value === "flee" ? "Ищете окно для прорыва." : "Идёте в напор.";
      return { ok: true, orders: o, message: sLabel };
    }

    if (kind === "aim") {
      if (["head", "body", "legs", "arms"].indexOf(value) === -1) {
        return { ok: false, message: "Туда не бьют." };
      }
      o.aim = value;
      if (o.stance === "flee") { o.stance = "press"; }
      return { ok: true, orders: o, message: "Метите " + aimDef(value).short + "." };
    }

    if (kind === "squad") {
      if (["focus", "free", "guard", "hold"].indexOf(value) === -1) {
        return { ok: false, message: "Неизвестный приказ отряду." };
      }
      o.squad = value === "guard" ? "hold" : value;
      var qLabel = o.squad === "free" ? "Отряд сам сближается и бьётся вольно."
        : o.squad === "hold" ? "Отряд держит позицию в защите."
        : "Отряд сближается с вашей целью.";
      return { ok: true, orders: o, message: qLabel };
    }

    if (kind === "speed") {
      if (["paused", "auto", "1x", "2x"].indexOf(value) === -1) {
        return { ok: false, message: "Неизвестная скорость." };
      }
      o.speed = value === "paused" ? "paused" : "auto";
      return { ok: true, orders: o, message: o.speed === "paused" ? "Бой на паузе." : "Автобой включён." };
    }

    return { ok: false, message: "Неизвестный приказ." };
  }

  /* Один такт живого боя по текущим приказам командира. */
  function step(state, rng) {
    var f = state.fight;
    if (!f || f.phase !== "exchange") { return { ok: false, message: "Сейчас не бой." }; }
    var o = ensureOrders(f);
    return move(state, o.stance || "press", rng, f.target || null, o.aim || "body");
  }

  function setTarget(state, key) {
    var f = state.fight;
    if (!f || f.phase !== "exchange") { return { ok: false, message: "Сейчас не бой." }; }
    var foe = aliveUnits(f, "enemy").filter(function (u) { return u.key === key; })[0];
    if (!foe) { return { ok: false, message: "Этого противника уже нет." }; }
    f.target = key;
    return { ok: true, message: "Цель — " + foe.name + "." };
  }

  function log(f, who, text, extra) {
    var entry = { who: who, text: text, round: (f.round || 0) + 1 };
    if (extra) {
      if (extra.amount) { entry.amount = extra.amount; }
      if (extra.injury) { entry.injury = extra.injury; }
    }
    f.log.push(entry);
    Bow.util.trim(f.log, 60);
    return entry;
  }

  /* ---------- Кто на поле ---------- */
  function unitByKey(f, key) {
    for (var i = 0; i < f.units.length; i++) {
      if (f.units[i].key === key) { return f.units[i]; }
    }
    return null;
  }

  function aliveUnits(f, side) {
    return f.units.filter(function (u) {
      return u.side === side && !u.down && !u.dead;
    });
  }

  /* Боец на поле может быть трёх родов: сам игрок, житель из
     state.people и «безликий» противник (стражник, грабитель),
     у которого счёт идёт прямо в фишке. Без этого стражники
     не получали ни урона, ни хода: их просто не находили. */
  function personOf(state, unit) {
    if (unit.key === "player") { return state.player; }
    if (unit.refId) { return state.people[unit.refId] || null; }
    return unit;
  }

  /* Фишка получает состояние по здоровью: стоит, лежит или мертва. */
  function syncUnit(state, unit) {
    var p = personOf(state, unit);
    if (!p || !p.needs) { return; }
    if (unit.isStack && typeof unit.count === "number") {
      if (unit.count <= 0) {
        unit.hp = 0;
        unit.down = true;
        return;
      }
      unit.hp = Math.max(1, Math.round(((unit.topHp || unit.unitHp || 80) / (unit.unitHp || 80)) * 100));
      return;
    }
    unit.hp = p.needs.health;

    /* У игрока поля alive может не быть вовсе — тогда он жив.
       Из-за обратного «!p.alive» фишка игрока считалась мёртвой
       с первого же удара, и бой кончался «поражением» на ровном месте. */
    if (p.alive === false) { unit.dead = true; unit.down = false; return; }

    /* Вниз фишка уходит только при настоящем нокауте, и сдача —
       состояние фазы боя, а не положение фишки. Здесь только
       одно правило: очнувшийся боец снова встаёт.

       До 0.0.6.3 здесь стоял порог stunAt (8), и он сбрасывал
       падение, поставленное тяжёлым ударом в голову: фишка ложилась,
       а через строку вставала обратно, потому что здоровья 25 > 8. */
    var vitalDown = Bow.state && Bow.state.criticalVitalOf ? Bow.state.criticalVitalOf(p) : null;
    if (unit.down && !unit.dead && p.needs.health > rules().yieldAt.npc && !(vitalDown && vitalDown.hp < 0)) {
      unit.down = false;
    }
  }

  /* ---------- Пространство поля боя (0.0.7.1) ----------
     Удар в рукопашной достаёт только вплотную (соседняя клетка).
     Никто не бьёт через всю карту: чтобы ударить — надо подойти. */
  function inMelee(a, b) {
    if (!a || !b) { return false; }
    return Math.abs((a.col || 0) - (b.col || 0)) <= 1 &&
           Math.abs((a.row || 0) - (b.row || 0)) <= 1;
  }

  function gridDist(a, b) {
    return Math.abs((a.col || 0) - (b.col || 0)) + Math.abs((a.row || 0) - (b.row || 0));
  }

  function cellOccupied(f, col, row, ignoreKey) {
    var A = rules().arena;
    if (col < 0 || col >= A.cols || row < 0 || row >= A.rows) { return true; }
    for (var i = 0; i < f.units.length; i++) {
      var u = f.units[i];
      if (u.key === ignoreKey || u.down || u.dead) { continue; }
      if (u.col === col && u.row === row) { return true; }
    }
    return false;
  }

  /* Сближение к цели по снегу: до maxSteps клеток за такт, обходя занятые клетки. */
  function stepToward(f, mover, target, maxSteps) {
    if (!mover || !target || inMelee(mover, target)) { return false; }
    var moved = false;
    var steps = maxSteps || 1;
    for (var s = 0; s < steps; s++) {
      if (inMelee(mover, target)) { break; }
      var dc = target.col > mover.col ? 1 : (target.col < mover.col ? -1 : 0);
      var dr = target.row > mover.row ? 1 : (target.row < mover.row ? -1 : 0);
      var candidates = [];
      /* Если цель уже в пределах соседнего ряда (±1) — держим свою полосу шеренги; если дальше по вертикали — идём наискось по гексу на охват. */
      if (dc !== 0 && Math.abs(target.col - mover.col) > 1 && Math.abs(target.row - mover.row) <= 1) {
        candidates.push([mover.col + dc, mover.row]);
        if (dr !== 0) { candidates.push([mover.col + dc, mover.row + dr]); }
      } else {
        if (dc !== 0 && dr !== 0) { candidates.push([mover.col + dc, mover.row + dr]); }
        if (dc !== 0) { candidates.push([mover.col + dc, mover.row]); }
      }
      if (dr !== 0) { candidates.push([mover.col, mover.row + dr]); }
      if (dc !== 0) {
        candidates.push([mover.col + dc, mover.row - 1]);
        candidates.push([mover.col + dc, mover.row + 1]);
      }
      var picked = null;
      for (var c = 0; c < candidates.length; c++) {
        if (!cellOccupied(f, candidates[c][0], candidates[c][1], mover.key)) {
          picked = candidates[c];
          break;
        }
      }
      if (!picked) { break; }
      mover.col = picked[0];
      mover.row = picked[1];
      moved = true;
    }
    return moved;
  }

  function hexName(col, row) {
    var letters = ["А", "Б", "В", "Г", "Д", "Е", "Ж", "З"];
    return (letters[col] || String(col + 1)) + String((row || 0) + 1);
  }

  /* Карта гексов, куда герой может шагнуть одним тактическим приказом (0.0.8.2):
     • если враг стоит вплотную (зона контроля) — смещение на 1 соседний гекс;
     • на свободном просторе без контакта — манёвр до 2 гексов за ход (как в King's Bounty / HoMM3). */
  function reachableHexes(state) {
    var map = {};
    var f = state && state.fight;
    if (!f || f.phase !== "exchange") { return map; }
    var A = rules().arena;
    var playerUnit = unitByKey(f, "player");
    if (!playerUnit || playerUnit.down || playerUnit.dead) { return map; }
    var engaged = aliveUnits(f, "enemy").some(function (e) { return inMelee(playerUnit, e); });
    var maxReach = engaged ? 1 : 2;
    for (var r = 0; r < A.rows; r++) {
      for (var c = 0; c < A.cols; c++) {
        if (c === playerUnit.col && r === playerUnit.row) { continue; }
        if (cellOccupied(f, c, r, playerUnit.key)) { continue; }
        var cheb = Math.max(Math.abs(c - playerUnit.col), Math.abs(r - playerUnit.row));
        if (cheb <= maxReach) {
          map[c + ":" + r] = true;
        }
      }
    }
    return map;
  }

  /* Ручной приказ идти на выбранный гекс поля боя (клик по соте, 0.0.8.2). */
  function moveTo(state, col, row, rng) {
    var f = state && state.fight;
    if (!f || f.phase !== "exchange") { return { ok: false, message: "Сейчас не бой." }; }
    var A = rules().arena;
    var c = parseInt(col, 10);
    var r = parseInt(row, 10);
    if (isNaN(c) || isNaN(r) || c < 0 || c >= A.cols || r < 0 || r >= A.rows) {
      return { ok: false, message: "За пределы поля уйти нельзя." };
    }

    var playerUnit = unitByKey(f, "player");
    if (!playerUnit || playerUnit.down || playerUnit.dead) {
      return { ok: false, message: "Вы не можете двигаться." };
    }

    /* Клик по своей же клетке — удержание позиции в защите. */
    if (c === playerUnit.col && r === playerUnit.row) {
      return move(state, "guard", rng, f.target || null);
    }

    /* Если на этом гексе стоит живой враг — выбираем его целью и атакуем/сближаемся. */
    var occEnemy = aliveUnits(f, "enemy").filter(function (e) { return e.col === c && e.row === r; })[0];
    if (occEnemy) {
      f.target = occEnemy.key;
      return move(state, "press", rng, occEnemy.key);
    }

    if (cellOccupied(f, c, r, playerUnit.key)) {
      return { ok: false, message: "Эта клетка занята союзником." };
    }

    var engaged = aliveUnits(f, "enemy").some(function (e) { return inMelee(playerUnit, e); });
    var maxReach = engaged ? 1 : 2;
    var cheb = Math.max(Math.abs(c - playerUnit.col), Math.abs(r - playerUnit.row));
    var fromC = playerUnit.col;
    var fromR = playerUnit.row;

    if (cheb <= maxReach) {
      playerUnit.col = c;
      playerUnit.row = r;
    } else {
      /* Если кликнули по дальней клетке через всё поле — шагаем прямо к ней на доступный ход. */
      for (var st = 0; st < maxReach; st++) {
        if (playerUnit.col === c && playerUnit.row === r) { break; }
        var dc = c > playerUnit.col ? 1 : (c < playerUnit.col ? -1 : 0);
        var dr = r > playerUnit.row ? 1 : (r < playerUnit.row ? -1 : 0);
        var tries = [];
        if (dc !== 0 && dr !== 0) { tries.push([playerUnit.col + dc, playerUnit.row + dr]); }
        if (dc !== 0) { tries.push([playerUnit.col + dc, playerUnit.row]); }
        if (dr !== 0) { tries.push([playerUnit.col, playerUnit.row + dr]); }
        var stepCell = null;
        for (var ti = 0; ti < tries.length; ti++) {
          if (!cellOccupied(f, tries[ti][0], tries[ti][1], playerUnit.key)) {
            stepCell = tries[ti];
            break;
          }
        }
        if (!stepCell) { break; }
        playerUnit.col = stepCell[0];
        playerUnit.row = stepCell[1];
      }
    }

    if (playerUnit.col === fromC && playerUnit.row === fromR) {
      return { ok: false, message: "Проход к этой клетке перекрыт." };
    }

    f._manualHexLabel = hexName(playerUnit.col, playerUnit.row);
    return move(state, "hex-step", rng, f.target || null);
  }

  /* Шаг назад: разорвать контакт за спины спутников и встать в защиту. */
  function stepBack(state, rng) {
    var f = state.fight;
    if (!f || f.phase !== "exchange") { return { ok: false, message: "Сейчас не бой." }; }
    var playerUnit = unitByKey(f, "player");
    if (!playerUnit || playerUnit.down) { return { ok: false, message: "Вы не можете отойти." }; }
    var o = ensureOrders(f);
    o.stance = "guard";
    var stepped = false;
    var backCols = [playerUnit.col - 1, playerUnit.col];
    var tryRows = [playerUnit.row, playerUnit.row - 1, playerUnit.row + 1];
    for (var bi = 0; bi < backCols.length && !stepped; bi++) {
      for (var ri = 0; ri < tryRows.length && !stepped; ri++) {
        if (backCols[bi] === playerUnit.col && tryRows[ri] === playerUnit.row) { continue; }
        if (!cellOccupied(f, backCols[bi], tryRows[ri], playerUnit.key)) {
          playerUnit.col = backCols[bi];
          playerUnit.row = tryRows[ri];
          stepped = true;
        }
      }
    }
    if (stepped) {
      log(f, "you", "Вы отступаете на шаг назад и закрываетесь.");
    }
    return move(state, "guard", rng, f.target || null, o.aim || "body");
  }

  /* ---------- Один такт боя ----------
     Сначала ходят свои, потом отвечает противник. Чтобы ударить,
     нужно стоять вплотную (inMelee); кто держит позицию — ждёт врага. */
  function move(state, stance, rng, targetKey, aimKey) {
    var f = state.fight;
    var R = rules();
    if (!f || f.phase !== "exchange") { return { ok: false, message: "Сейчас не бой." }; }

    if (stance === "flee") { return flee(state, rng); }
    if (stance === "back") { return stepBack(state, rng); }
    var isHexStep = (stance === "hex-step");
    if (!isHexStep && stance !== "press" && stance !== "guard") { return { ok: false, message: "Так не дерутся." }; }

    var ordM = ensureOrders(f);
    if (!isHexStep) { ordM.stance = stance; }
    if (aimKey && R.aims && R.aims[aimKey]) { ordM.aim = aimKey; }

    f.units.forEach(function (u) { syncUnit(state, u); });
    var playerUnit = unitByKey(f, "player");
    if (!playerUnit) { return { ok: false, message: "Вас нет на поле." }; }

    f.round += 1;

    if (state.player.needs.health <= R.yieldAt.player) {
      endBySide(state, "enemy");
      return { ok: true, message: "" };
    }

    var foes = aliveUnits(f, "enemy");
    if (!foes.length) { endBySide(state, "ally"); return { ok: true, message: "" }; }

    var want = targetKey || f.target || null;
    var foe = foes[0];
    if (want) {
      var picked = foes.filter(function (u) { return u.key === want; })[0];
      if (picked) { foe = picked; }
    }
    f.target = foe.key;

    f.aim = [];
    f.lastStrikes = [];
    ensureOrders(f);
    playerUnit.stance = isHexStep ? (ordM.stance || "guard") : stance;

    /* --- 1. Ход героя (сближение по 1 клетке за круг или ручной переход по гексам, 0.0.8.2) --- */
    if (!playerUnit.down) {
      if (isHexStep) {
        var cellLbl = f._manualHexLabel || hexName(playerUnit.col, playerUnit.row);
        f._manualHexLabel = null;
        Bow.needs.applyChange(state.player, "fatigue", -0.8);
        log(f, "you", "Вы переходите на клетку " + cellLbl + ".");
      } else if (stance === "press") {
        if (inMelee(playerUnit, foe)) {
          strike(state, playerUnit, foe, stance, rng, aimKey || (f.orders && f.orders.aim) || "body");
          syncUnit(state, playerUnit);
          syncUnit(state, foe);
          f.aim.push({ from: playerUnit.key, to: foe.key });
        } else if (stepToward(f, playerUnit, foe, 1)) {
          /* Постепенно сближаемся на 1 клетку к выбранной цели (без прыжка на 2 клетки). */
          Bow.needs.applyChange(state.player, "fatigue", -0.5);
          log(f, "you", "Вы делаете шаг навстречу (" + foe.name + ").");
        } else {
          /* Если проход к выбранной цели плотно перекрыт строем, бьём того, кто мешает вплотную. */
          var adjFoe = aliveUnits(f, "enemy").filter(function (e) { return inMelee(playerUnit, e); })[0];
          if (adjFoe) {
            strike(state, playerUnit, adjFoe, stance, rng, aimKey || (f.orders && f.orders.aim) || "body");
            syncUnit(state, playerUnit);
            syncUnit(state, adjFoe);
            f.aim.push({ from: playerUnit.key, to: adjFoe.key });
          } else {
            Bow.needs.applyChange(state.player, "fatigue", -0.5);
            log(f, "you", "Вы ищете проход к " + foe.name + ".");
          }
        }
      } else {
        /* «Держать позицию» (guard): герой НЕ бежит вперёд. Если враг уже
           подошёл вплотную — встречает коротким ударом из защиты; иначе
           держит место и переводит дух. */
        var nearFoe = inMelee(playerUnit, foe)
          ? foe
          : aliveUnits(f, "enemy").filter(function (e) { return inMelee(playerUnit, e); })[0];
        if (nearFoe) {
          strike(state, playerUnit, nearFoe, "guard", rng, aimKey || (f.orders && f.orders.aim) || "body");
          syncUnit(state, playerUnit);
          syncUnit(state, nearFoe);
          f.aim.push({ from: playerUnit.key, to: nearFoe.key });
        } else {
          Bow.needs.applyChange(state.player, "fatigue", 2);
          log(f, "you", "Вы держите позицию в защите и ждёте противника.");
        }
      }
    }

    /* --- 2. Ход спутников по приказу командира ---
       • focus — сами подходят к вашей цели и бьют её;
       • free  — сами подходят к ближайшему/слабейшему врагу и рубятся (как в Kenshi);
       • hold / guard — стоят на месте стеной в защите, бьют только подошедших вплотную. */
    var rawSquad = (f.orders && f.orders.squad) || "focus";
    var squadOrder = rawSquad === "guard" ? "hold" : rawSquad;

    aliveUnits(f, "ally").forEach(function (u) {
      if (u.key === "player") { return; }
      var live = aliveUnits(f, "enemy");
      if (!live.length) { return; }
      var allyStance = squadOrder === "hold" ? "guard" : "press";
      var allyAim = "body";
      var prey = live[0];

      if (squadOrder === "free") {
        live.sort(function (a, b) {
          var da = inMelee(u, a) ? 0 : 1;
          var db = inMelee(u, b) ? 0 : 1;
          if (da !== db) { return da - db; }
          return a.hp - b.hp;
        });
        prey = live[0];
        allyAim = chooseAim(u, state);
      } else if (squadOrder === "focus" && f.target) {
        var focused = live.filter(function (e) { return e.key === f.target; })[0];
        if (focused) { prey = focused; }
      } else if (squadOrder === "hold") {
        var adjacent = live.filter(function (e) { return inMelee(u, e); })[0];
        prey = adjacent || null;
      }

      u.stance = allyStance;

      if (squadOrder === "hold") {
        if (prey) {
          strike(state, u, prey, "guard", rng, "body");
          syncUnit(state, u);
          syncUnit(state, prey);
          f.aim.push({ from: u.key, to: prey.key });
        }
        return;
      }

      if (inMelee(u, prey)) {
        strike(state, u, prey, allyStance, rng, allyAim);
        syncUnit(state, u);
        syncUnit(state, prey);
        f.aim.push({ from: u.key, to: prey.key });
      } else if (stepToward(f, u, prey, 1)) {
        log(f, "you", u.name + " сближается на шаг.");
      } else {
        var nearAny = live.filter(function (e) { return inMelee(u, e); })[0];
        if (nearAny) {
          strike(state, u, nearAny, allyStance, rng, allyAim);
          syncUnit(state, u);
          syncUnit(state, nearAny);
          f.aim.push({ from: u.key, to: nearAny.key });
        }
      }
    });

    if (!aliveUnits(f, "enemy").length) { endBySide(state, "ally"); return { ok: true, message: "" }; }
    if (enemyGivesUp(f)) { endBySide(state, "ally"); return { ok: true, message: "" }; }

    /* --- 3. Противник сближается по 1 клетке и отвечает вплотную --- */
    aliveUnits(f, "enemy").forEach(function (foeUnit) {
      /* Если игрок уже сбит до порога и стоящих союзников не осталось —
         остальные стражники не бьют лежачего на «−0 здор.». */
      if (state.player.needs.health <= R.yieldAt.player) {
        playerUnit.down = true;
      }
      var ours = aliveUnits(f, "ally");
      if (!ours.length) { return; }

      var foeStance = chooseStance(foeUnit);
      foeUnit.stance = foeStance;
      if (foeStance === "yield") { return; }

      /* Сначала те, кто реально уже стоит перед врагом вплотную! */
      var engaged = ours.filter(function (a) { return inMelee(foeUnit, a); });
      var victim = null;
      if (engaged.length) {
        engaged.sort(function (a, b) { return a.hp - b.hp; });
        victim = engaged[0];
      } else {
        ours.sort(function (a, b) {
          var d = gridDist(foeUnit, a) - gridDist(foeUnit, b);
          return d !== 0 ? d : (a.hp - b.hp);
        });
        victim = ours[0];
        if (foeStance === "press") {
          stepToward(f, foeUnit, victim, 1);
          log(f, "them", foeUnit.name + " делает шаг навстречу.");
        }
        return;
      }

      strike(state, foeUnit, victim, foeStance, rng, chooseAim(foeUnit, state));
      syncUnit(state, victim);
      if (victim.key === "player" && state.player.needs.health <= R.yieldAt.player) {
        victim.down = true;
      }
      f.aim.push({ from: foeUnit.key, to: victim.key });
    });

    /* Игрок на нуле — бой кончен, даже если фишка ещё «стоит»:
       у него иные пороги, чем у фишек-жителей. */
    if (state.player.needs.health <= R.yieldAt.player) {
      endBySide(state, "enemy");
      return { ok: true, message: "" };
    }
    if (!aliveUnits(f, "ally").length) { endBySide(state, "enemy"); return { ok: true, message: "" }; }
    return { ok: true, message: "" };
  }

  /* Сдаётся ли противник: здоровье у порога и он не может больше
     держаться. Это не то же самое, что нокаут. */
  function enemyGivesUp(f) {
    var R = rules();
    var foes = f.units.filter(function (u) { return u.side === "enemy" && !u.dead; });
    if (!foes.length) { return true; }
    return foes.every(function (u) {
      if (u.isStack && u.count > 1) { return false; }
      return u.hp <= R.yieldAt.npc;
    });
  }

  /* Боец не «глупый бот»: закрывается, если ему больно, давит,
     если чувствует перевес. */
  /* Противник не бьёт вслепую: тот, кто сильнее, метит в голову,
     слабый и осторожный — в корпус. Это видно в хронике. */
  function chooseAim(foe, state) {
    var p = state ? personOf(state, foe) : foe;
    var combat = (p && p.skills && p.skills.combat) || 0;
    if (foe.hp < 35) { return "legs"; }
    if (combat >= 45) { return "head"; }
    if (combat >= 30) { return "body"; }
    return "body";
  }

  function chooseStance(foe) {
    var R = rules();
    if (foe.isStack && foe.count > 1) { return "press"; }
    if (foe.hp <= R.yieldAt.npc) { return "yield"; }
    if (foe.hp < 40) { return "guard"; }
    return "press";
  }

  /* ---------- Удар ----------
     Вся арифметика здесь, чтобы хроника и поле говорили одно и то же. */
  function strike(state, attacker, defender, stance, rng, aimKey) {
    var f = state.fight;
    var R = rules();
    var aP = personOf(state, attacker);
    var dP = personOf(state, defender);
    if (!aP || !dP) { return; }

    var mode = f.mode;
    var aim = aimDef(aimKey);
    var hit = rollOf(rng) < hitChance(aP, dP, stance, aimKey);

    /* Усталость тратится и на удар, и на глухую защиту. */
    var cost = stance === "guard" ? R.guardFatigue : R.fatiguePerExchange;
    Bow.needs.applyChange(aP, "fatigue", -cost);

    var who = attacker.side === "ally" ? "you" : "them";

    if (!Array.isArray(f.lastStrikes)) { f.lastStrikes = []; }

    if (!hit) {
      f.lastStrikes.push({
        from: attacker.key,
        to: defender.key,
        hit: false,
        damage: 0,
        aim: aimKey || "body",
        round: f.round || 1
      });
      log(f, who, sideName(attacker) + " " + (attacker.key === "player" ? "бьёте" : "бьёт") +
        " " + aim.short + " — мимо.");
      return;
    }

    var defGuarding = (defender.stance === "guard");
    var damage = damageRoll(aP, dP, mode, stance === "guard" ? "guard" : defender.stance || "press", rng, aimKey);

    /* === МЕХАНИКА СТЕКОВ ОТРЯДОВ В ДУХЕ KING'S BOUNTY (0.0.8.0) ===
       Если цель — отряд из N бойцов (например, «Рыцари ×100»), урон вычитается
       из общего пула здоровья отряда, уменьшая численность стека. */
    if (defender.isStack && typeof defender.count === "number" && defender.count >= 1) {
      var uHp = Math.max(10, defender.unitHp || 80);
      var curTop = typeof defender.topHp === "number" ? defender.topHp : uHp;
      var totalPool = (defender.count - 1) * uHp + curTop;
      var nextPool = Math.max(0, totalPool - damage);
      var prevCnt = defender.count;
      var slain = 0;

      if (nextPool <= 0) {
        slain = prevCnt;
        defender.count = 0;
        defender.topHp = 0;
        defender.hp = 0;
        dP.needs.health = 0;
        defender.down = true;
        if (mode !== "spar") { defender.dead = true; }
      } else {
        var nextCnt = Math.ceil(nextPool / uHp);
        var nextTop = nextPool - (nextCnt - 1) * uHp;
        slain = Math.max(0, prevCnt - nextCnt);
        defender.count = nextCnt;
        defender.topHp = nextTop;
        var pctLeft = Math.max(1, Math.round((nextTop / uHp) * 100));
        /* Пока в отряде больше 1 бойца, стек держит строй и не сдаётся от раны передового */
        if (nextCnt > 1) {
          dP.needs.health = Math.max(R.yieldAt.npc + 4, pctLeft);
          defender.hp = pctLeft;
        } else {
          dP.needs.health = pctLeft;
          defender.hp = pctLeft;
          if (pctLeft <= R.yieldAt.npc) { defender.down = true; }
        }
      }

      f.lastStrikes.push({
        from: attacker.key,
        to: defender.key,
        hit: true,
        blocked: defGuarding,
        damage: damage,
        slain: slain,
        stackLeft: defender.count,
        aim: aimKey || "body",
        part: "chest",
        round: f.round || 1
      });

      var stackNote = slain > 0
        ? (" · пало: " + slain + (defender.count > 0 ? ", в строю ×" + defender.count : " · отряд разбит!"))
        : (" · в строю ×" + defender.count);
      log(f, who, sideName(attacker) + " → " + defender.name + ": −" + damage + " ур." + stackNote, { amount: damage, slain: slain });
      return;
    }

    /* Урон НЕ ограничивается порогом сдачи. В 0.0.6 ограничение
       было, и получалась нелепость: противника нельзя было довести
       до порога, значит он никогда не сдавался, а бой заканчивался
       «победой» над стоящим на ногах человеком. */
    if (mode === "spar") {
      /* В спарринге бьют вполсилы: до порога, но не ниже. */
      var sparFloor = (defender.side === "ally" && !defender.npc) ? R.yieldAt.player : R.yieldAt.npc;
      if (dP.needs.health - damage < sparFloor) {
        damage = Math.max(1, Math.round(dP.needs.health - sparFloor));
      }
    }

    /* Попадание бьёт в конкретную конечность или часть тела.
       В духе Kenshi здоровье части тела может уходить в минус (-100..100). */
    var sideParity = (((f.round || 0) + (attacker.col || 0)) % 2) === 0;
    var hitPartKey = aimKey === "head" ? "head"
      : aimKey === "arms" ? (sideParity ? "right_arm" : "left_arm")
      : aimKey === "legs" ? (sideParity ? "left_leg" : "right_leg")
      : (sideParity ? "chest" : "stomach");

    var vitalKnockedNegative = false;
    if (dP.body && dP.body[hitPartKey] && !dP.body[hitPartKey].lost && mode !== "spar") {
      dP.body[hitPartKey].hp = clamp(Math.round(dP.body[hitPartKey].hp - damage * 0.9), -100, dP.body[hitPartKey].max || 100);
      if (dP.body[hitPartKey].hp < 0) {
        dP.body[hitPartKey].bandaged = false;
        if (hitPartKey === "head" || hitPartKey === "chest" || hitPartKey === "stomach") {
          vitalKnockedNegative = true;
        }
      }
    }

    f.lastStrikes.push({
      from: attacker.key,
      to: defender.key,
      hit: true,
      blocked: defGuarding,
      damage: damage,
      slain: 0,
      aim: aimKey || "body",
      part: hitPartKey,
      round: f.round || 1
    });

    /* Рост боевых навыков и Крепости от реального дела (как в Kenshi). */
    if (Bow.work && Bow.work.growSkill) {
      if (attacker.key === "player") {
        var atkWep = mode === "spar" ? null : weaponOf(aP);
        if (!atkWep) { Bow.work.growSkill(aP, "unarmed", 0.14); }
        else if (atkWep.weaponClass) { Bow.work.growSkill(aP, atkWep.weaponClass, 0.14); }
        if (aimKey === "head" || aimKey === "legs") { Bow.work.growSkill(aP, "precision", 0.08); }
      }
      if (defender.key === "player") {
        if ((defender.stance || "press") === "guard") { Bow.work.growSkill(dP, "melee_defense", 0.16); }
        else if (!armorOf(dP)) { Bow.work.growSkill(dP, "dodge", 0.12); }
        if (Bow.work.growAttr && damage > 0) { Bow.work.growAttr(dP, "toughness", 0.15); }
      }
    }

    /* Увечье, потеря глаза/уха или конечности — ОЧЕНЬ редкое явление (0.0.7.4):
       как в Kenshi, отсечь конечность или лишить глаза/уха может только опытный боец
       (combat >= 52) острым оружием, когда эта часть тела уже сильно измочалена. */
    var maimed = null;
    var atkWeapon = mode === "spar" ? null : weaponOf(aP);
    var isSharp = !!(atkWeapon && atkWeapon.sharp !== false);
    var atkCombat = (aP.skills && aP.skills.combat) || 0;
    var partHpNow = (dP.body && dP.body[hitPartKey]) ? dP.body[hitPartKey].hp : 50;

    if (mode !== "spar" && isSharp && atkCombat >= 52 && damage >= R.maimAt && partHpNow <= 38) {
      var defTough = (Bow.state && Bow.state.effectiveAttr && dP.attrs)
        ? Bow.state.effectiveAttr(dP, "toughness")
        : 12;
      var toughMit = Math.max(0.35, 1 - (defTough - 12) * 0.012);
      var baseMaim = (0.03 + (atkCombat - 52) * 0.0028 + (damage - R.maimAt) * 0.005) * aim.maim * toughMit;
      var injuryRoll = Math.min(0.30, baseMaim);
      if (rollOf(rng) < injuryRoll) {
        var exactInj = null;
        if ((aimKey === "arms" || aimKey === "legs") && partHpNow <= 8 && atkCombat >= 60 && /axe|sword/.test(atkWeapon.id)) {
          exactInj = aimKey === "arms" ? "arm_lost" : "leg_lost";
        } else if (aimKey === "head" && hasInjury(dP, "eye") && !hasInjury(dP, "ear")) {
          exactInj = "ear";
        }
        maimed = maim(dP, rng, aimKey, exactInj);
      }
    }

    /* Сбить с ног можно и не убивая: удар в голову или по ногам
       валит фишку раньше, чем кончится здоровье. Но не раньше,
       чем урон упирается в порог: иначе фишка ложится, а здоровье
       остаётся выше порога — и «нокаут» перестаёт значить «выдохся». */
    var stunLine = R.arena.stunAt * aim.down;

    /* Спутник и чужие бойцы выбывают по здоровью, а не по красоте.
       У игрока в спарринге порог = порог сдачи: его роняют ровно
       тогда, когда бой и так кончен. */
    var floorForDefender = defender.side === "ally" && !defender.npc
      ? R.yieldAt.player
      : R.yieldAt.npc;

    if (dP.needs.health - damage <= stunLine && dP.needs.health - damage <= floorForDefender) {
      defender.down = true;
      if (defender.side === "ally" && defender.npc) {
        log(f, "narr", dP.name + " падает и больше не встаёт. Бой продолжается без него.");
      }
    }
    if (defender.side === "ally" && !defender.npc && dP.needs.health - damage <= R.yieldAt.player) {
      var room = Bow.util.round1(dP.needs.health - R.yieldAt.player);
      damage = Math.max(0, Math.min(damage, room));
      defender.down = true;
      if (damage <= 0) { return; }
    }
    if (defender.side === "ally" && defender.npc && mode === "spar" &&
        dP.needs.health - damage <= R.yieldAt.npc) {
      /* В спарринге спутника тоже не калечат до нуля. */
      damage = Math.max(1, Math.round(dP.needs.health - R.yieldAt.npc));
    }

    Bow.needs.applyChange(dP, "health", -damage);
    /* Если жизненно важная часть тела (голова / грудь / живот) ушла в минус —
       боец сразу теряет сознание и падает на землю (в духе Kenshi, 0.0.7.5). */
    if (vitalKnockedNegative) {
      defender.down = true;
      var vLabel = (dP.body && dP.body[hitPartKey] && dP.body[hitPartKey].name) || hitPartKey;
      if (defender.key === "player") {
        if (dP.needs.health > R.yieldAt.player) { dP.needs.health = R.yieldAt.player; }
        log(f, "narr", "Тяжёлый удар в «" + vLabel + "» уводит область в минус — в глазах темнеет, вы не можете удержаться на ногах!");
      } else {
        if (dP.needs.health > R.yieldAt.npc) { dP.needs.health = R.yieldAt.npc; }
        log(f, "narr", dP.name + " рушится без сознания (пробита область «" + vLabel + "»).");
      }
    }
    defender.hp = dP.needs.health;

    /* Куда пришёлся удар — видно в каждой строке: без этого выбор
       «в голову или в корпус» ничем не отличался бы в хронике. */
    var where = aimKey && aimKey !== "body" ? " (" + aim.short + ")" : "";
    log(f, who,
      sideName(attacker) + " → " + (defender.key === "player" ? "вы" : defender.name) +
        ": −" + damage + " здор." + where,
      { amount: damage });

    if (maimed) {
      log(f, "narr",
        (defender.key === "player" ? "Вы" : defender.name) + ": " + maimed.name +
          " — навсегда.", { injury: maimed.key });
    }

    /* Удар по рукам роняет оружие — это делает такой удар осмысленным,
       хотя урон у него самый низкий. В спарринге оружия нет. */
    if (aimKey === "arms" && mode !== "spar" && !defender.disarmed && weaponOf(dP)) {
      defender.disarmed = true;
      log(f, "narr", (defender.key === "player" ? "Вы" : defender.name) +
        " роняет оружие. Дальше — голыми руками.");
    }
  }

  /* «Вы», а не «Роберт»: игрок смотрит на себя изнутри. */
  function sideName(unit) {
    return unit.key === "player" ? "Вы" : unit.name;
  }

  /* ---------- Итог ---------- */
  function endBySide(state, side) {
    var f = state.fight;
    var R = rules();

    if (side === "ally") {
      if (f.mode === "spar") { finish(state, "win", {}); return; }
      squadAftermath(state, "win", null);

      /* Победа над человеком даёт выбор, что с ним делать. */
      var first = f.enemies[0];
      if (f.mode === "robbery") {
        first.hp = Math.max(R.yieldAt.npc, first.hp);
        first.down = false;
        f.phase = "aftermath";
        log(f, "narr", first.name + " садится в снег и держит руку на боку. Он больше не полезет.");
        return;
      }
      if (f.mode === "crime" && first && first.person) {
        var p = state.people[first.refId];
        if (p) { p.needs.health = Math.max(R.yieldAt.npc, p.needs.health); }
        /* Фишка должна показать то же, что в состоянии: иначе
           «сдался» и «0 здоровья» — разные истории про одно. */
        first.hp = p ? p.needs.health : first.hp;
        first.down = false;
        f.phase = "aftermath";
        log(f, "narr", (p ? p.name : "Противник") + " опускается на снег и больше не бьётся.");
        return;
      }
      finish(state, "win", {});
      return;
    }

    /* Наши все лежат. */
    if (f.mode === "guard") {
      playerDown(state, null);
      return;
    }
    playerDown(state, null);
  }

  function playerDown(state, rng) {
    var f = state.fight;
    var R = rules();
    var lost = 0;
    var person = state.people[f.personId];
    var lostAlly = f.units.filter(function (u) {
      return u.side === "ally" && u.npc && u.down;
    })[0] || null;

    if ((f.mode === "crime" || f.mode === "guard" || f.mode === "robbery") && state.player.money > 0) {
      lost = Math.max(1, Math.round(state.player.money * (0.25 + rollOf(rng) * 0.3)));
      state.player.money -= lost;
      if (person) { person.money += lost; }
    }

    Bow.needs.applyChange(state.player, "mood", -12);

    if (f.mode === "guard") {
      log(f, "narr", "Вас бьют, пока вы не перестаёте подниматься. Дальше — клетка.");
      var hadMoney = state.player.money + lost;
      finish(state, "caught", { lost: lost });
      /* Пойманный игрок не остаётся на улице: его ведут в клетку.
         Это делает итог боя со стражей настоящим, а не записью. */
      state.player.money = hadMoney - lost;
      Bow.guard.toJail(state, "сопротивлялся");
      return;
    }

    log(f, "narr", (person ? person.name : "Противник") + " останавливается, когда вы падаете. " +
      (lost ? "Из кошеля пропало " + lost + " м." : "Ваш кошель не тронут."));
    squadAftermath(state, "loss", lostAlly);
    finish(state, "loss", { lost: lost });
    if (Bow.needs && Bow.needs.syncComaState) {
      Bow.needs.syncComaState(state);
    }
  }

  /* ---------- Отступление ---------- */
  function fleeChance(state) {
    var f = state.fight;
    if (!f) { return 0; }
    var base = 0.45 + ((state.player.skills.survival || 0) / 250);
    base += injuryPenalty(state.player, "flee");
    var foes = aliveUnits(f, "enemy");
    if (foes.length > 1) { base -= (foes.length - 1) * 0.12; }
    foes.forEach(function (foe) {
      var p = personOf(state, foe);
      if (!p) { return; }
      if (p.needs.fatigue < 30) { base += 0.12; }
      base -= ((p.skills.combat || 0) / 500);
    });
    return clamp(base, 0.10, 0.9);
  }

  function flee(state, rng) {
    var f = state.fight;
    var R = rules();
    Bow.needs.applyChange(state.player, "fatigue", -2);

    if (rollOf(rng) < fleeChance(state)) {
      log(f, "narr", "Вы разрываете дистанцию и уходите. За вами не гонятся.");
      finish(state, "fled", {});
      return { ok: true, fled: true, message: "Вы ушли. Не доблесть — зато целы." };
    }

    var foes = aliveUnits(f, "enemy");
    var foe = foes[0];
    var p = foe ? personOf(state, foe) : null;
    var damage = p ? Math.round(damageRoll(p, state.player, f.mode, "press", rng) * 1.3) : 6;
    var floorAt = R.yieldAt.player;
    if (state.player.needs.health - damage <= floorAt) {
      damage = Math.max(1, Math.round(state.player.needs.health - floorAt));
    }
    Bow.needs.applyChange(state.player, "health", -damage);
    log(f, "them", "Уйти не вышло: −" + damage + " здор.", { amount: damage });

    if (state.player.needs.health <= floorAt) { playerDown(state, rng); }
    return { ok: true, fled: false, message: "Уйти не вышло — " + damage + " урона." };
  }

  /* ---------- Развязка после победы и создание лутаемых трупов ---------- */
  function spawnCorpse(state, opts) {
    if (!Array.isArray(state.corpses)) { state.corpses = []; }
    var items = [];
    (opts.items || []).forEach(function (id) {
      if (id) { items.push({ itemId: id, qty: 1 }); }
    });
    var cid = "corpse:" + (opts.personId || ((opts.roleKey || "foe") + ":" + state.time.totalHours + ":" + state.corpses.length));
    var corpse = {
      id: cid,
      personId: opts.personId || null,
      roleKey: opts.roleKey || "villager",
      name: opts.name || "Неизвестный",
      role: opts.role || "житель",
      location: state.player.location,
      killedAt: state.time.totalHours,
      money: Math.max(0, Math.round(opts.money || 0)),
      items: items,
      looted: false
    };
    state.corpses.push(corpse);
    return corpse;
  }

  function decide(state, choice, rng) {
    var f = state.fight;
    if (!f || f.phase !== "aftermath") { return { ok: false, message: "Сейчас решать нечего." }; }

    var npc = state.people[f.personId];
    var player = state.player;

    /* 1. Грабитель на улице: записи в людях у него нет, но кошель и нож настоящие. */
    var faceless = !npc && f.mode === "robbery" ? f.enemies[0] : null;
    if (faceless) {
      var loot = Math.max(0, Math.round(faceless.money || 0));
      if (choice === "spare") {
        log(f, "narr", faceless.name + " остаётся сидеть в снегу, зажимая бок.");
        finish(state, "win", {});
        Bow.journal.add(state, "Вы оставили грабителя в снегу.", "danger");
        return { ok: true, message: faceless.name + " остался сидеть в снегу." };
      }
      if (choice === "rob") {
        player.money += loot;
        faceless.money = 0;
        var robTaken = [loot + " м."];
        if (faceless.weapon) {
          Bow.economy.addItem(player, faceless.weapon, 1);
          var rwDef = Bow.economy.findItemDef(faceless.weapon);
          robTaken.push(rwDef ? rwDef.name : faceless.weapon);
          faceless.weapon = null;
        }
        var robText = robTaken.join(", ");
        log(f, "narr", "Вы забираете у поверженного налётчика: " + robText + ".");
        finish(state, "win", {});
        Bow.journal.add(state, "Вы обобрали грабителя: +" + robText + ".", "crime");
        return { ok: true, message: "Забрано у грабителя: " + robText + "." };
      }
      if (choice === "kill") {
        (f.units || []).forEach(function (u) {
          if (u.side === "enemy") { u.dead = true; u.down = false; u.hp = 0; }
        });
        var rCorpse = spawnCorpse(state, {
          roleKey: "robber",
          name: faceless.name,
          role: "уличный налётчик",
          money: loot,
          items: [faceless.weapon, faceless.armor].concat(faceless.pouch || [])
        });
        faceless.money = 0;
        faceless.weapon = null;
        var gHeat = Bow.steal.addHeat(state, "org:guard", 12);
        f.heatTotal += gHeat;
        if (Bow.guard && Bow.guard.schedule) { Bow.guard.schedule(state); }
        log(f, "narr", "Вы добиваете налётчика на снегу. Тело остаётся лежать у дороги.");
        finish(state, "killed", { heat: gHeat, corpseIds: [rCorpse.id] });
        Bow.journal.add(state, "Вы добили грабителя (" + faceless.name + "). Тело осталось на земле.", "crime");
        return { ok: true, message: faceless.name + " мёртв. Тело можно обыскать.", corpseId: rCorpse.id };
      }
      return { ok: false, message: "Так нельзя." };
    }

    /* 2. Разгромленный патруль стражи (если игрок победил всех троих). */
    if (!npc && f.mode === "guard") {
      if (choice === "spare") {
        var spHeat = Bow.steal.addHeat(state, "org:guard", 15);
        if (Bow.work) { Bow.work.addReputation(state, "org:guard", -6); }
        f.heatTotal += spHeat;
        log(f, "narr", "Поверженные стражники остаются лежать в снегу.");
        finish(state, "win", { heat: spHeat });
        Bow.journal.add(state, "Вы сбили патруль стражи с ног и пощадили их.", "crime");
        return { ok: true, message: "Стражники повержены, но живы." };
      }
      if (choice === "rob") {
        var gTake = 18 + Math.round(rollOf(rng) * 14);
        player.money += gTake;
        var gGearTaken = [gTake + " м."];
        (f.enemies || []).forEach(function (ge) {
          if (ge.weapon) {
            Bow.economy.addItem(player, ge.weapon, 1);
            var gw = Bow.economy.findItemDef(ge.weapon);
            gGearTaken.push(gw ? gw.name : ge.weapon);
            ge.weapon = null;
          }
          if (ge.armor) {
            Bow.economy.addItem(player, ge.armor, 1);
            var ga = Bow.economy.findItemDef(ge.armor);
            gGearTaken.push(ga ? ga.name : ge.armor);
            ge.armor = null;
          }
        });
        var rbHeat = Bow.steal.addHeat(state, "org:guard", 25);
        if (Bow.work) { Bow.work.addReputation(state, "org:guard", -14); }
        f.heatTotal += rbHeat;
        log(f, "narr", "Вы снимаете со стражников монеты и снаряжение: " + gGearTaken.join(", ") + ".");
        finish(state, "win", { heat: rbHeat });
        Bow.journal.add(state, "Вы обобрали патруль стражи: +" + gTake + " м. и снаряжение.", "crime");
        return { ok: true, message: "Снято со стражи: " + gGearTaken.join(", ") + "." };
      }
      if (choice === "kill") {
        (f.units || []).forEach(function (u) {
          if (u.side === "enemy") { u.dead = true; u.down = false; u.hp = 0; }
        });
        var gCorpseIds = (f.enemies || []).map(function (ge, idx) {
          var gc = spawnCorpse(state, {
            roleKey: "guard",
            name: ge.name || ("Стражник " + (idx + 1)),
            role: "стражник Брода",
            money: 7 + idx * 3,
            items: [ge.weapon, ge.armor].concat(ge.pouch || [])
          });
          return gc.id;
        });
        var klHeat = Bow.steal.addHeat(state, "org:guard", 45);
        if (Bow.work) { Bow.work.addReputation(state, "org:guard", -30); }
        f.heatTotal += klHeat;
        log(f, "narr", "Стражники добиты на снегу. За такое в Хладных Ветрах вешают без суда.");
        finish(state, "killed", { heat: klHeat, corpseIds: gCorpseIds });
        Bow.journal.add(state, "Вы перебили патруль стражи Брода. Тела остались лежать на снегу.", "crime");
        return { ok: true, message: "Патруль стражи мёртв. Тела остались на месте боя.", corpseIds: gCorpseIds };
      }
      return { ok: false, message: "Так нельзя." };
    }

    if (!npc || !npc.alive) { close(state); return { ok: false, message: "Он уже не встанет." }; }

    var R = rules();
    var heat = 0;
    var rep = 0;
    var message = "";
    var createdCorpses = [];

    if (choice === "spare") {
      heat = Bow.steal.addHeat(state, npc.org, R.spareHeat);
      rep = Bow.work.addReputation(state, npc.org, R.spareRep);
      npc.attitude = clamp(npc.attitude - 20, -100, 100);
      npc.memory.push({
        kind: "beaten",
        text: player.name + " сбил меня с ног, но отпустил.",
        weight: 7,
        totalHours: state.time.totalHours
      });
      Bow.util.trim(npc.memory, 40);
      log(f, "narr", "Вы отходите на шаг. " + npc.name + " поднимается, держась за бок.");
      message = "Вы отпустили " + (npc.pron === "f" ? "её" : "его") + ". " + npc.name + " этого не забудет.";
    } else if (choice === "rob") {
      var take = Math.min(npc.money, Math.max(1, Math.round(npc.money * (0.6 + rollOf(rng) * 0.35))));
      npc.money -= take;
      player.money += take;
      var stripped = [];
      if (npc.weapon) {
        Bow.economy.addItem(player, npc.weapon, 1);
        var nwDef = Bow.economy.findItemDef(npc.weapon);
        stripped.push(nwDef ? nwDef.name : npc.weapon);
        npc.weapon = null;
      }
      if (npc.armor) {
        Bow.economy.addItem(player, npc.armor, 1);
        var naDef = Bow.economy.findItemDef(npc.armor);
        stripped.push(naDef ? naDef.name : npc.armor);
        npc.armor = null;
      }
      (npc.pouch || []).forEach(function (pid) {
        Bow.economy.addItem(player, pid, 1);
        var pDef = Bow.economy.findItemDef(pid);
        stripped.push(pDef ? pDef.name : pid);
      });
      npc.pouch = [];

      heat = Bow.steal.addHeat(state, npc.org, R.robHeat);
      rep = Bow.work.addReputation(state, npc.org, R.robRep);
      Bow.steal.addHeat(state, "org:guard", Math.round(R.robHeat * 0.5));
      if (Bow.work && npc.org !== "org:guard") {
        Bow.work.addReputation(state, "org:guard", -10);
      }
      npc.attitude = clamp(npc.attitude - 35, -100, 100);
      npc.memory.push({
        kind: "robbed",
        text: player.name + " избил меня и забрал " + take + " м." + (stripped.length ? (" и " + stripped.join(", ")) : "") + ".",
        weight: 9,
        totalHours: state.time.totalHours
      });
      Bow.util.trim(npc.memory, 40);
      var lootSummary = take + " м." + (stripped.length ? (", " + stripped.join(", ")) : "");
      log(f, "narr", "Вы забираете у " + npc.name + ": " + lootSummary + ".");
      message = "Обирание: " + npc.name + ", взято " + lootSummary + ".";
    } else if (choice === "kill") {
      npc.alive = false;
      npc.needs.health = 0;
      /* Фишка на поле и в отчёте становится мёртвым телом на снегу. */
      (f.units || []).forEach(function (u) {
        if (u.side === "enemy" && u.refId === npc.id) { u.dead = true; u.down = false; u.hp = 0; }
      });
      /* Всё, что было у убитого (кошель, оружие, броня и припасы в котомке), остаётся на теле для обыска. */
      var corpseLoot = [npc.weapon, npc.armor].concat(npc.pouch || []);
      var npcCorpse = spawnCorpse(state, {
        personId: npc.id,
        roleKey: npc.key,
        name: npc.name,
        role: npc.role,
        money: npc.money,
        items: corpseLoot
      });
      npc.money = 0;
      npc.weapon = null;
      npc.armor = null;
      npc.pouch = [];
      createdCorpses.push(npcCorpse.id);

      heat = Bow.steal.addHeat(state, npc.org, R.killHeat);
      rep = Bow.work.addReputation(state, npc.org, R.killRep);
      if (state.orgs[npc.org]) {
        state.orgs[npc.org].unrest = clamp((state.orgs[npc.org].unrest || 0) + 6, 0, 100);
      }
      /* Убийство — прямой вызов страже. */
      Bow.steal.addHeat(state, "org:guard", Math.round(R.killHeat * 0.8));
      if (Bow.work && npc.org !== "org:guard") {
        Bow.work.addReputation(state, "org:guard", -22);
      }
      if (Bow.guard && Bow.guard.schedule) { Bow.guard.schedule(state); }
      log(f, "narr", "Вы делаете то, после чего в Броде не отмываются. " + npc.name + " остаётся лежать на земле.");
      message = "Убийство: " + npc.name + ". Тело осталось лежать на земле.";
    } else {
      return { ok: false, message: "Так нельзя." };
    }

    f.heatTotal += heat;
    f.repTotal += rep;

    Bow.journal.add(state, message, "crime");
    finish(state, choice === "kill" ? "killed" : "win", {
      heat: heat,
      rep: rep,
      message: message,
      corpseIds: createdCorpses
    });
    return {
      ok: true,
      message: message,
      heat: heat,
      reputation: rep,
      corpseId: createdCorpses[0] || null
    };
  }

  /* ---------- Итог боя ---------- */
  function sparGain(player, npc) {
    var mine = (player.skills && player.skills.combat) || 0;
    var theirs = (npc && npc.skills && npc.skills.combat) || 0;
    return clamp((theirs - mine + 12) / 12, 0.2, 1.5);
  }

  function finish(state, outcome, extra) {
    var f = state.fight;
    if (!f) { return null; }

    var npc = state.people[f.personId];
    var player = state.player;
    var extraData = extra || {};
    var spar = f.mode === "spar";
    var note = extraData.note || "";
    var before = player.skills.combat || 0;
    var gained = 0;

    if (["win", "loss", "fled", "caught"].indexOf(outcome) !== -1) {
      if (spar) {
        if (outcome !== "fled") { gained = sparGain(player, npc); }
        state.stats.sparsMade = (state.stats.sparsMade || 0) + 1;
        if (npc && outcome !== "fled") {
          npc.skills.combat = Math.min(100, round1((npc.skills.combat || 0) + 0.3));
          npc.attitude = clamp(npc.attitude + 2, -100, 100);
        }
      } else if (f.mode === "crime" || f.mode === "robbery") {
        gained = outcome === "win" ? 0.6 : 0.3;
        if (outcome === "win") { state.stats.fightsWon = (state.stats.fightsWon || 0) + 1; }
        else if (outcome === "loss") { state.stats.fightsLost = (state.stats.fightsLost || 0) + 1; }
      }

      if (gained > 0) {
        player.skills.combat = Math.min(100, round1(before + gained));
        note = "Бой +" + (player.skills.combat - before).toFixed(1);
      }

      if (spar || outcome === "loss" || outcome === "fled") {
        Bow.journal.add(state,
          (spar ? "Кулачный бой: " : "Драка: ") + (npc ? npc.name : (f.enemies[0] ? f.enemies[0].name : "противник")) + " — " +
          ({ win: "вы взяли верх", loss: "он взял верх", fled: "вы ушли", caught: "вас скрутили" }[outcome] || outcome) +
          (note ? " (" + note + ")." : "."),
          "fight");
      }
    }

    var summary = {
      name: f.mode === "guard" ? "Стража Брода" : (npc ? npc.name : (f.enemies[0] ? f.enemies[0].name : "—")),
      mode: f.mode,
      outcome: outcome,
      rounds: f.round,
      heat: f.heatTotal || 0,
      rep: f.repTotal || 0,
      note: note,
      lost: extraData.lost || 0,
      corpseIds: (extraData.corpseIds || []).slice(),
      aim: [],
      target: null,
      units: (f.units || []).map(function (u) {
        return {
          key: u.key,
          refId: u.refId || null,
          roleKey: u.roleKey || null,
          name: u.name,
          side: u.side,
          col: u.col,
          row: u.row,
          hp: Math.round(u.hp),
          count: typeof u.count === "number" ? u.count : 1,
          maxCount: typeof u.maxCount === "number" ? u.maxCount : 1,
          isStack: !!u.isStack,
          down: !!u.down,
          dead: !!u.dead,
          disarmed: !!u.disarmed,
          weapon: u.weapon || null,
          armor: u.armor || null,
          stance: u.stance || null
        };
      }),
      log: f.log.slice(-14)
    };

    state.flags.lastFight = summary;
    state.fight = null;
    return summary;
  }

  function isActive(state) {
    return !!(state && state.fight);
  }

  /* ---------- Мир после боя ----------
     Избитые не лежат калекой вечно: за сутки они отходят.
     Это не лечение — лечение будет отдельным слоем. */
  Bow.bus.on("tick:day", function (state) {
    Object.keys(state.people || {}).forEach(function (id) {
      var p = state.people[id];
      if (!p.alive) { return; }
      if (typeof p.needs.health === "number" && p.needs.health < 100) {
        p.needs.health = clamp(Math.round(p.needs.health + 8), 0, 100);
      }
    });
  });

  /* Запуск полевого боя против любого списка одиночных врагов или стеков отрядов (0.0.8.0). */
  function startSquadBattle(state, enemyUnits, opts) {
    opts = opts || {};
    var allies = (opts.allies || []).slice();
    state.fight = {
      personId: opts.personId || null,
      mode: opts.mode || "battle",
      phase: "exchange",
      introId: ++fightIntroSeq,
      round: 0,
      heatTotal: 0,
      repTotal: 0,
      witnesses: [],
      allies: allies,
      allyUnits: (opts.allyUnits || []).slice(),
      enemies: (enemyUnits || []).slice(),
      units: [],
      aim: [],
      lastStrikes: [],
      target: null,
      log: []
    };
    ensureOrders(state.fight);
    state.fight.units = spawnUnits(state);
    if (opts.note) {
      log(state.fight, "narr", opts.note);
    }
    return state.fight;
  }

  Bow.fight = {
    open: open,
    close: close,
    start: start,
    startSquadBattle: startSquadBattle,
    createStack: createStack,
    stackPowerMult: stackPowerMult,
    titleOf: titleOf,
    move: move,
    step: step,
    stepBack: stepBack,
    moveTo: moveTo,
    reachableHexes: reachableHexes,
    hexName: hexName,
    inMelee: inMelee,
    stepToward: stepToward,
    setOrder: setOrder,
    ensureOrders: ensureOrders,
    flee: flee,
    decide: decide,
    finish: finish,
    odds: odds,
    isActive: isActive,
    toggleAlly: toggleAlly,
    alliesAvailable: alliesAvailable,
    allyState: allyState,
    squadAftermath: squadAftermath,
    aimDef: aimDef,
    chooseAim: chooseAim,
    weaponOf: weaponOf,
    armorOf: armorOf,
    attackPower: attackPower,
    defenseOf: defenseOf,
    hitChance: hitChance,
    damageRoll: damageRoll,
    damage: damageRoll,
    fleeChance: fleeChance,
    chooseNpcStance: chooseStance,
    witnessNames: witnessNames,
    strike: strike,
    unitByKey: unitByKey,
    aliveUnits: aliveUnits,
    log: log,
    /* Травмы появляются только в бою и при страже, поэтому живут здесь. */
    maim: maim,
    setTarget: setTarget,
    hasInjury: hasInjury,
    injuryPenalty: injuryPenalty,
    injuryWord: injuryWord
  };

  Bow.equip = {
    SLOTS: EQUIP_SLOT_DEFS,
    slotOfItem: slotOfItem,
    ensureSlots: ensureSlots,
    equippedIn: equippedIn,
    setSlot: setEquipSlot,
    equipItem: function (personOrState, itemId, slot) {
      var p = (personOrState && personOrState.player) ? personOrState.player : personOrState;
      return setEquipSlot(p, slot || null, itemId);
    },
    unequipSlot: function (personOrState, slot) {
      var p = (personOrState && personOrState.player) ? personOrState.player : personOrState;
      return setEquipSlot(p, slot, null);
    },
    swapWeaponSet: function (personOrState) {
      var p = (personOrState && personOrState.player) ? personOrState.player : personOrState;
      return swapWeaponSet(p);
    },
    totalStats: totalGearStats,
    weaponOf: weaponOf,
    armorOf: armorOf
  };

})(typeof window !== "undefined" ? window : this);
