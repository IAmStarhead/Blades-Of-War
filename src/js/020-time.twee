:: bow-time [script]
/* ============================================================
   BOW TIME — единственный владелец игрового времени.
   Время двигается ТОЛЬКО через advance(). Системы подписываются
   на тики и не меняют часы сами. Это лечит ошибку прототипа,
   где час превращался в два.
   ============================================================ */
(function (global) {
  "use strict";

  var Bow = global.Bow = global.Bow || {};

  function daysInMonth(data) {
    return data.calendar.daysPerMonth;
  }

  function seasonOf(state) {
    var months = Bow.data.calendar.seasons;
    /* 12 месяцев / 4 сезона = по 3 месяца */
    return months[Math.floor((state.time.month - 1) / 3) % 4];
  }

  function isNight(state) {
    var h = state.time.hour;
    return h < 6 || h >= 22;
  }

  /* Мягкое форматирование: «День 4, Стужень, 8:00» */
  function format(state) {
    var cal = Bow.data.calendar;
    var t = state.time;
    var monthName = cal.months[(t.month - 1) % 12] || ("месяц " + t.month);
    var hh = (t.hour < 10 ? "0" : "") + t.hour;
    var mm = (t.minute < 10 ? "0" : "") + t.minute;
    return "День " + t.day + ", " + monthName + " " + t.year + " г. · " + hh + ":" + mm;
  }

  /* Продвинуть время. Возвращает отчёт о том, какие тики прошли. */
  function advance(state, hours) {
    if (!(hours > 0)) { return { hours: 0, hoursPassed: 0, daysPassed: 0, monthsPassed: 0, yearsPassed: 0 }; }

    var mood = [];

    for (var i = 0; i < hours; i++) {
      state.time.minute = 0;
      state.time.hour += 1;
      state.time.totalHours += 1;
      state.stats.hoursPlayed += 1;

      if (state.time.hour >= 24) {
        state.time.hour -= 24;
        state.time.day += 1;
        mood.push("day");
        Bow.bus.emit("tick:day", state);

        if (state.time.day > daysInMonth(Bow.data)) {
          state.time.day = 1;
          state.time.month += 1;
          mood.push("month");
          Bow.bus.emit("tick:month", state);

          if (state.time.month > 12) {
            state.time.month = 1;
            state.time.year += 1;
            mood.push("year");
            Bow.bus.emit("tick:year", state);
          }
        }
      }

      Bow.bus.emit("tick:hour", state);
    }

    return {
      hoursPassed: hours,
      dayChanged: mood.indexOf("day") !== -1,
      monthChanged: mood.indexOf("month") !== -1,
      yearChanged: mood.indexOf("year") !== -1
    };
  }

  /* ---------- Живое время ----------
     Отдельный шаг «один игровой час» для хода времени без действия.
     Отличие от advance(1) только в ответе: здесь сообщаем смену
     суток — на это подписан интерфейс.
     Второго владельца часов нет: и действие, и живое время идут
     через advance(), поэтому час не удваивается. */
  function tick(state) {
    var before = {
      day: state.time.day,
      month: state.time.month,
      year: state.time.year,
      hour: state.time.hour
    };
    advance(state, 1);
    return {
      dayChanged: state.time.day !== before.day || state.time.month !== before.month || state.time.year !== before.year,
      monthChanged: state.time.month !== before.month || state.time.year !== before.year,
      hour: state.time.hour
    };
  }

  /* Скорость хода: paused | 1x | 4x. Хранится в состоянии,
     потому что это часть игры, а не оформления. */
  var SCALES = ["paused", "1x", "4x"];

  function setScale(state, scale) {
    if (SCALES.indexOf(scale) === -1) { return state.time.scale; }
    state.time.scale = scale;
    return scale;
  }

  /* Сколько игровых часов проходит за одну реальную секунду. */
  function hoursPerSecond(scale) {
    if (scale === "1x") { return 1 / 3; }   /* час игры за 3 секунды */
    if (scale === "4x") { return 1; }        /* час игры за секунду */
    return 0;
  }

  Bow.time = {
    advance: advance,
    tick: tick,
    setScale: setScale,
    hoursPerSecond: hoursPerSecond,
    SCALES: SCALES,
    format: format,
    seasonOf: seasonOf,
    isNight: isNight
  };

})(typeof window !== "undefined" ? window : this);
