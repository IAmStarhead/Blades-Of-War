:: bow-time [script]
/* ============================================================
   BOW TIME — единственный владелец игрового времени.
   Время двигается ТОЛЬКО через advance(). Системы подписываются
   на тики и не меняют часы сами. Это лечит ошибку прототипа,
   где час превращался в два.
   ============================================================ */
(function (global) {
  "use strict";

  var Bow = global.Bow = global.Bow || {};

  function daysInMonth(data) {
    return data.calendar.daysPerMonth;
  }

  function seasonOf(state) {
    var months = Bow.data.calendar.seasons;
    /* 12 месяцев / 4 сезона = по 3 месяца */
    return months[Math.floor((state.time.month - 1) / 3) % 4];
  }

  function isNight(state) {
    var h = state.time.hour;
    return h < 6 || h >= 22;
  }

  /* Мягкое форматирование: «День 4, Стужень, 8:00» */
  function format(state) {
    var cal = Bow.data.calendar;
    var t = state.time;
    var monthName = cal.months[(t.month - 1) % 12] || ("месяц " + t.month);
    var hh = (t.hour < 10 ? "0" : "") + t.hour;
    var mm = (t.minute < 10 ? "0" : "") + t.minute;
    return "День " + t.day + ", " + monthName + " " + t.year + " г. · " + hh + ":" + mm;
  }

  /* Один часовой рубеж: вызывается каждый раз, когда накоплено 60 минут. */
  function stepOneHour(state, mood) {
    state.time.hour += 1;
    state.time.totalHours += 1;
    state.stats.hoursPlayed += 1;

    if (state.time.hour >= 24) {
      state.time.hour -= 24;
      state.time.day += 1;
      mood.push("day");
      Bow.bus.emit("tick:day", state);

      if (state.time.day > daysInMonth(Bow.data)) {
        state.time.day = 1;
        state.time.month += 1;
        mood.push("month");
        Bow.bus.emit("tick:month", state);

        if (state.time.month > 12) {
          state.time.month = 1;
          state.time.year += 1;
          mood.push("year");
          Bow.bus.emit("tick:year", state);
        }
      }
    }

    Bow.bus.emit("tick:hour", state);
  }

  /* Продвинуть время на указанное число минут (единый владелец часов и минут). */
  function advanceMinutes(state, minutes) {
    var mins = Math.round(Number(minutes) || 0);
    if (!(mins > 0)) {
      return { minutesPassed: 0, hoursPassed: 0, dayChanged: false, monthChanged: false, yearChanged: false };
    }
    if (typeof state.time.minute !== "number" || isNaN(state.time.minute)) {
      state.time.minute = 0;
    }

    var mood = [];
    var hoursPassed = 0;
    state.time.minute += mins;

    while (state.time.minute >= 60) {
      state.time.minute -= 60;
      hoursPassed += 1;
      stepOneHour(state, mood);
    }

    Bow.bus.emit("tick:minute", state);

    return {
      minutesPassed: mins,
      hoursPassed: hoursPassed,
      dayChanged: mood.indexOf("day") !== -1,
      monthChanged: mood.indexOf("month") !== -1,
      yearChanged: mood.indexOf("year") !== -1
    };
  }

  /* Продвинуть время в часах (через тот же минутный счётчик, не обнуляя текущие минуты). */
  function advance(state, hours) {
    if (!(hours > 0)) { return { hours: 0, hoursPassed: 0, daysPassed: 0, monthsPassed: 0, yearsPassed: 0 }; }
    return advanceMinutes(state, Math.round(hours * 60));
  }

  /* ---------- Живое время ----------
     tick(state) — шаг в 1 игровой час (60 мин.).
     tickMinute(state) — плавный живой шаг в 1 игровую минуту (0.0.7.3:
     на скорости 1x 1 минута проходит за 2 реальные секунды). */
  function tick(state) {
    var before = {
      day: state.time.day,
      month: state.time.month,
      year: state.time.year,
      hour: state.time.hour
    };
    advance(state, 1);
    return {
      dayChanged: state.time.day !== before.day || state.time.month !== before.month || state.time.year !== before.year,
      monthChanged: state.time.month !== before.month || state.time.year !== before.year,
      hour: state.time.hour,
      minute: state.time.minute
    };
  }

  function tickMinute(state) {
    var before = {
      day: state.time.day,
      month: state.time.month,
      year: state.time.year,
      hour: state.time.hour
    };
    var res = advanceMinutes(state, 1);
    if (Bow.needs && Bow.needs.autoEatCheck) {
      Bow.needs.autoEatCheck(state);
    }
    if (Bow.work && Bow.work.tickTask) {
      Bow.work.tickTask(state, 1);
    }
    return {
      hourChanged: res.hoursPassed > 0 || state.time.hour !== before.hour,
      dayChanged: state.time.day !== before.day || state.time.month !== before.month || state.time.year !== before.year,
      monthChanged: state.time.month !== before.month || state.time.year !== before.year,
      hour: state.time.hour,
      minute: state.time.minute
    };
  }

  /* Скорость хода: paused | 1x | 4x. Хранится в состоянии,
     потому что это часть игры, а не оформления. */
  var SCALES = ["paused", "1x", "4x"];

  function setScale(state, scale) {
    if (SCALES.indexOf(scale) === -1) { return state.time.scale; }
    state.time.scale = scale;
    return scale;
  }

  /* Сколько игровых минут проходит за одну реальную секунду (0.0.7.3):
     1x = 0.5 мин./с (ровно 1 игровая минута за 2 реальные секунды),
     4x = 2.0 мин./с (вчетверо быстрее: 1 минута за 0.5 секунды). */
  function minutesPerSecond(scale) {
    if (scale === "1x") { return 0.5; }
    if (scale === "4x") { return 2.0; }
    return 0;
  }

  /* Сколько игровых часов проходит за одну реальную секунду. */
  function hoursPerSecond(scale) {
    return minutesPerSecond(scale) / 60;
  }

  Bow.time = {
    advance: advance,
    advanceMinutes: advanceMinutes,
    tick: tick,
    tickMinute: tickMinute,
    setScale: setScale,
    minutesPerSecond: minutesPerSecond,
    hoursPerSecond: hoursPerSecond,
    SCALES: SCALES,
    format: format,
    seasonOf: seasonOf,
    isNight: isNight
  };

})(typeof window !== "undefined" ? window : this);
